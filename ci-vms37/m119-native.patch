+#ifndef VMS_CON_PORT_H
+#define VMS_CON_PORT_H
+#include <stddef.h>
+#include <stdint.h>
+/* Source: SYS/SRC/CONINTDSP.MAR 484-550 and SHRLIB/TTYDEF.MAR 245-449.
+ * These act on original VMS 3.7 UCB bytes, not on a VAX emulator. The
+ * class routine TERMINALIO and real OP/TT DPTs have not been linked.
+ * DEFERRED means the caller must not claim an output was transmitted. */
+enum {
+    PORT_V37_CON_OK=1u, PORT_V37_CON_BAD=2u, PORT_V37_CON_DEFERRED=4u,
+    PORT_V37_CON_UCB_BYTES=256u,
+    PORT_V37_CON_STS=88u, PORT_V37_CON_DUETIM=92u,
+    PORT_V37_CON_STATE=132u, PORT_V37_CON_HOLD=174u,
+    PORT_V37_CON_OUTLEN=220u,
+    PORT_V37_CON_TIM=1u, PORT_V37_CON_INT=2u,
+    PORT_V37_CON_CTRLS=1u,
+    PORT_V37_CON_XOFF=0x100u, PORT_V37_CON_XON=0x200u,
+    PORT_V37_CON_STOP=0x400u, PORT_V37_CON_STOP2=0x800u,
+    PORT_V37_CON_BURST=0x2000u
+};
+struct port_v37_con_backend {
+    /* Real terminal class/port dispatch; no simulated success on NULL. */
+    uint32_t (*kick)(void *);
+    void *context;
+};
+uint16_t port_v37_con_get16(const uint8_t *,unsigned);
+uint32_t port_v37_con_get32(const uint8_t *,unsigned);
+void port_v37_con_set16(uint8_t *,unsigned,uint16_t);
+void port_v37_con_set32(uint8_t *,unsigned,uint32_t);
+uint32_t port_v37_con_valid(const uint8_t *,size_t);
+uint32_t port_v37_con_kick(uint8_t *,const struct port_v37_con_backend *);
+uint32_t port_v37_con_xoff(uint8_t *,size_t,const struct port_v37_con_backend *);
+uint32_t port_v37_con_xon(uint8_t *,size_t,const struct port_v37_con_backend *);
+uint32_t port_v37_con_stop(uint8_t *,size_t);
+uint32_t port_v37_con_stop2(uint8_t *,size_t,uint32_t);
+uint32_t port_v37_con_abort(uint8_t *,size_t,uint32_t);
+uint32_t port_v37_con_resume(uint8_t *,size_t,uint32_t,const struct port_v37_con_backend *);
+#endif
--- /dev/null
+++ b/src/vms_con_port.c
@@ -0,0 +1,37 @@
+#include "vms_con_port.h"
+#include "vms_v37_dyn_tags.h"
+/* Source little-endian UCB layout and TTY UCB extension offsets.
+ * Caller must supply actual IA-32 resident data or a host-test copy.
+ * No reinterpreted host-endian structs, no VAX interpreter. */
+uint16_t port_v37_con_get16(const uint8_t *u,unsigned n){
+    return (uint16_t)((unsigned)u[n]|((unsigned)u[n+1u]<<8));
+}
+uint32_t port_v37_con_get32(const uint8_t *u,unsigned n){
+    return (uint32_t)u[n]|((uint32_t)u[n+1u]<<8)|
+        ((uint32_t)u[n+2u]<<16)|((uint32_t)u[n+3u]<<24);
+}
+void port_v37_con_set16(uint8_t *u,unsigned n,uint16_t x){
+    u[n]=(uint8_t)x;u[n+1u]=(uint8_t)(x>>8);
+}
+void port_v37_con_set32(uint8_t *u,unsigned n,uint32_t x){
+    u[n]=(uint8_t)x;u[n+1u]=(uint8_t)(x>>8);
+    u[n+2u]=(uint8_t)(x>>16);u[n+3u]=(uint8_t)(x>>24);
+}
+uint32_t port_v37_con_valid(const uint8_t *u,size_t capacity){
+    if(!u || capacity<PORT_V37_CON_UCB_BYTES ||
+       ((uintptr_t)u&3u))return PORT_V37_CON_BAD;
+    const uint32_t declared=port_v37_con_get16(u+0u,8u);
+    return u[10u]==PORT_V37_DYN_UCB &&
+           declared>=PORT_V37_CON_UCB_BYTES && declared<=capacity ?
+           PORT_V37_CON_OK:PORT_V37_CON_BAD;
+}
+uint32_t port_v37_con_kick(uint8_t *u,const struct port_v37_con_backend *b){
+    uint16_t status=port_v37_con_get16(u,PORT_V37_CON_STS);
+    if(status&PORT_V37_CON_INT)return PORT_V37_CON_OK;
+    /* The original CON$XON / CON$RESUME calls TERMINALIO here.
+     * Without its real class/port backend leave output queued, not sent. */
+    if(!b || !b->kick || b->kick(b->context)!=PORT_V37_CON_OK)
+        return PORT_V37_CON_DEFERRED;
+    port_v37_con_set16(u,PORT_V37_CON_STS,(uint16_t)(status|PORT_V37_CON_INT));
+    return PORT_V37_CON_OK;
+}
--- /dev/null
+++ b/src/vms_con_xoff.c
@@ -0,0 +1,8 @@
+#include "vms_con_port.h"
+/* CONINTDSP.MAR 484-487: schedule XOFF before lower-priority data. */
+uint32_t port_v37_con_xoff(uint8_t *u,size_t n,const struct port_v37_con_backend *b){
+    if(port_v37_con_valid(u,n)!=PORT_V37_CON_OK)return PORT_V37_CON_BAD;
+    port_v37_con_set16(u,PORT_V37_CON_HOLD,
+        (uint16_t)(port_v37_con_get16(u,PORT_V37_CON_HOLD)|PORT_V37_CON_XOFF));
+    return port_v37_con_kick(u,b);
+}
