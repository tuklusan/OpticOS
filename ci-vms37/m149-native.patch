diff --git a/src/vms_f11_boot_header.c b/src/vms_f11_boot_header.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_boot_header.c
@@ -0,0 +1,19 @@
+#include "vms_f11_bootpath.h"
+/* FIL$RDCHKFILHDR: source INDEXF.SYS FID-number-to-index-VBN map and
+ * checksummed FH2 identity, no caller state committed until verification. */
+uint32_t port_f11_boot_header(const struct port_f11_boot_volume *v,
+    const struct port_dq_dir_fid *fid,uint32_t *lbn,uint8_t out[512]){
+    if(!v||!v->home||!v->index||!v->read_sector||!fid||!lbn||!out)
+        return PORT_F11_PATH_BAD;
+    uint32_t at=0u;
+    if(port_dq_image_header_lbn(v->home,v->index,fid,&at)!=PORT_DQ_IMAGE_OK)
+        return PORT_F11_PATH_MAP;
+    uint8_t bytes[512];
+    if(v->read_sector(v->context,at,bytes)!=PORT_DQ_DIR_OK)
+        return PORT_F11_PATH_IO;
+    if(port_dq_image_verify_fh2(bytes,fid)!=PORT_DQ_IMAGE_OK)
+        return PORT_F11_PATH_HEADER;
+    for(unsigned i=0;i<512u;i++)out[i]=bytes[i];
+    *lbn=at;
+    return PORT_F11_PATH_OK;
+}
diff --git a/src/vms_f11_boot_lookup.c b/src/vms_f11_boot_lookup.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_boot_lookup.c
@@ -0,0 +1,18 @@
+#include "vms_f11_bootpath.h"
+/* FIL$FINDFILID scans every requested directory VBN through the source FH2
+ * map and the actual physical-sector callback. */
+uint32_t port_f11_boot_lookup(const struct port_f11_boot_volume *v,
+    const uint8_t dir[512],const char *name,size_t n,uint16_t version,
+    struct port_dq_dir_fid *fid,uint32_t *found_vbn){
+    if(!v||!dir||!v->read_sector||!v->max_directory_vbn||
+       !version||!fid||!found_vbn||
+       port_f11_boot_validate_name(name,n)!=PORT_F11_PATH_OK)
+        return PORT_F11_PATH_BAD;
+    struct port_dq_dir_fid tmp={0};uint32_t vbn=0;
+    const uint32_t result=port_dq_dir_find_blocks(dir,name,n,version,
+       v->max_directory_vbn,v->read_sector,v->context,&tmp,&vbn);
+    if(result==PORT_DQ_DIR_NOT_FOUND)return PORT_F11_PATH_MISSING;
+    if(result!=PORT_DQ_DIR_OK)return PORT_F11_PATH_MAP;
+    *fid=tmp;*found_vbn=vbn;
+    return PORT_F11_PATH_OK;
+}
diff --git a/src/vms_f11_boot_name.c b/src/vms_f11_boot_name.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_boot_name.c
@@ -0,0 +1,14 @@
+#include "vms_f11_bootpath.h"
+/* The source directory FID search takes the name and version separately.
+ * Reject path control characters instead of silently traversing another
+ * directory or weakening a Files-11 access boundary. */
+uint32_t port_f11_boot_validate_name(const char *s,size_t n){
+    if(!s||!n||n>39u)return PORT_F11_PATH_BAD;
+    for(size_t i=0;i<n;i++){
+        const unsigned c=(unsigned char)s[i];
+        if(!((c>='A'&&c<='Z')||(c>='a'&&c<='z')||
+             (c>='0'&&c<='9')||c=='_'||c=='-'||c=='.'||c=='$'))
+            return PORT_F11_PATH_BAD;
+    }
+    return PORT_F11_PATH_OK;
+}
diff --git a/src/vms_f11_boot_open.c b/src/vms_f11_boot_open.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_boot_open.c
@@ -0,0 +1,34 @@
+#include "vms_f11_bootpath.h"
+/* Read-only chain: validated MFD FID 4,4,0 -> directory FID and FH2 ->
+ * file FID and FH2. Each physical sector comes from the caller's live
+ * native ATA device; unlike cached bootstrap probes no disk bytes are
+ * borrowed from a prior caller. */
+uint32_t port_f11_boot_open(const struct port_f11_boot_volume *v,
+    const char *directory,size_t dir_len,const char *file,size_t file_len,
+    uint16_t version,struct port_f11_boot_file *out){
+    if(!v||!v->home||!v->index||!v->mfd||!v->read_sector||!out||
+       !v->max_directory_vbn||v->max_directory_vbn>65535u||!version||
+       port_f11_boot_validate_name(directory,dir_len)!=PORT_F11_PATH_OK||
+       port_f11_boot_validate_name(file,file_len)!=PORT_F11_PATH_OK)
+        return PORT_F11_PATH_BAD;
+    const struct port_dq_dir_fid root={4u,4u,0u};
+    if(port_dq_dir_validate_header(v->mfd,&root)!=PORT_DQ_DIR_OK)
+        return PORT_F11_PATH_HEADER;
+    struct port_f11_boot_file temp={0};
+    uint8_t dir_header[512];
+    uint32_t s=port_f11_boot_lookup(v,v->mfd,directory,dir_len,1u,
+                                   &temp.directory,&temp.directory_vbn);
+    if(s!=PORT_F11_PATH_OK)return s;
+    s=port_f11_boot_header(v,&temp.directory,&temp.directory_header_lbn,
+                           dir_header);
+    if(s!=PORT_F11_PATH_OK)return s;
+    if(port_dq_dir_validate_header(dir_header,&temp.directory)!=PORT_DQ_DIR_OK)
+        return PORT_F11_PATH_HEADER;
+    s=port_f11_boot_lookup(v,dir_header,file,file_len,version,
+                           &temp.file,&temp.file_vbn);
+    if(s!=PORT_F11_PATH_OK)return s;
+    s=port_f11_boot_header(v,&temp.file,&temp.file_header_lbn,temp.header);
+    if(s!=PORT_F11_PATH_OK)return s;
+    *out=temp;
+    return PORT_F11_PATH_OK;
+}
diff --git a/src/vms_f11_boot_read.c b/src/vms_f11_boot_read.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_boot_read.c
@@ -0,0 +1,19 @@
+#include "vms_f11_bootpath.h"
+/* FIL$READVBN: preserve exact short-I/O count; only verified open FH2 can
+ * supply the retrieval map. No process or channel record is allocated. */
+uint32_t port_f11_boot_read(const struct port_f11_boot_volume *v,
+    const struct port_f11_boot_file *f,uint32_t off,uint32_t count,
+    uint8_t *out,size_t capacity,uint32_t *completed){
+    if(!v||!f||!v->read_sector||!f->file.number||!f->file.sequence||
+       !out||!completed||count>capacity||
+       port_dq_image_verify_fh2(f->header,&f->file)!=PORT_DQ_IMAGE_OK)
+        return PORT_F11_PATH_BAD;
+    uint32_t n=0u;
+    const uint32_t rc=port_f11_read_range(f->header,off,count,out,capacity,
+          v->read_sector,v->context,&n);
+    if(rc==PORT_F11_RANGE_BAD)return PORT_F11_PATH_BAD;
+    if(rc==PORT_F11_RANGE_MAP)return PORT_F11_PATH_MAP;
+    *completed=n;
+    if(rc==PORT_F11_RANGE_IO)return PORT_F11_PATH_IO;
+    return PORT_F11_PATH_OK;
+}
diff --git a/src/vms_f11_bootdir_block.c b/src/vms_f11_bootdir_block.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_bootdir_block.c
@@ -0,0 +1,33 @@
+#include "vms_f11_bootdir.h"
+/* FIL$FINDFILID level-2 directory entry: record length then 4-byte
+ * metadata, 1-byte name length, even padding and 8-byte FID/version rows.
+ * Word 0xFFFF terminates the VBN. Invalid records fail closed. */
+uint32_t port_f11_bootdir_block(const uint8_t block[512],
+    port_f11_bootdir_visit_fn visit,void *ctx,uint32_t *seen){
+    if(!block||!visit||!seen)return PORT_F11_BOOTDIR_BAD;
+    unsigned pos=0u;
+    while(pos<512u){
+        if(pos+2u>512u)return PORT_F11_BOOTDIR_CORRUPT;
+        const unsigned n=port_dq_index_word(block,pos);
+        if(n==UINT16_MAX)return PORT_F11_BOOTDIR_OK;
+        if(n<12u||n>510u-pos||pos+n+2u>512u)
+            return PORT_F11_BOOTDIR_CORRUPT;
+        const unsigned end=pos+n+2u;
+        const unsigned count=block[pos+5u];
+        const unsigned first=pos+6u+((count+1u)&~1u);
+        if(!count||count>80u||first+8u>end||(end-first)%8u)
+            return PORT_F11_BOOTDIR_CORRUPT;
+        for(unsigned at=first;at+8u<=end;at+=8u){
+            const uint16_t version=port_dq_index_word(block,at);
+            const struct port_dq_dir_fid f={port_dq_index_word(block,at+2u),
+                port_dq_index_word(block,at+4u),port_dq_index_word(block,at+6u)};
+            if(!version||!f.number||!f.sequence||*seen==UINT32_MAX)
+                return PORT_F11_BOOTDIR_CORRUPT;
+            ++*seen;
+            if(!visit(ctx,block+pos+6u,count,version,&f))
+                return PORT_F11_BOOTDIR_STOP;
+        }
+        pos=end;
+    }
+    return PORT_F11_BOOTDIR_OK;
+}
diff --git a/src/vms_f11_bootdir_walk.c b/src/vms_f11_bootdir_walk.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_bootdir_walk.c
@@ -0,0 +1,25 @@
+#include "vms_f11_bootdir.h"
+/* FIL$READVBN maps each one-origin directory VBN separately; the
+ * callback must be an actual registered privileged disk-sector reader. */
+uint32_t port_f11_bootdir_walk(const struct port_f11_boot_volume *v,
+    const uint8_t fh2[512],port_f11_bootdir_visit_fn visit,void *context,
+    uint32_t *seen){
+    if(!v||!v->read_sector||!fh2||!visit||!seen||
+       !v->max_directory_vbn||v->max_directory_vbn>65535u)
+        return PORT_F11_BOOTDIR_BAD;
+    uint32_t count=0u;
+    for(uint32_t vbn=1u;vbn<=v->max_directory_vbn;vbn++){
+        uint32_t lbn=0u;
+        if(port_dq_dir_map_vbn(fh2,vbn,&lbn)!=PORT_DQ_DIR_OK){
+            *seen=count;return PORT_F11_BOOTDIR_MAP;
+        }
+        uint8_t block[512];
+        if(v->read_sector(v->context,lbn,block)!=PORT_DQ_DIR_OK){
+            *seen=count;return PORT_F11_BOOTDIR_MAP;
+        }
+        const uint32_t rc=port_f11_bootdir_block(block,visit,context,&count);
+        if(rc!=PORT_F11_BOOTDIR_OK){*seen=count;return rc;}
+    }
+    *seen=count;
+    return PORT_F11_BOOTDIR_OK;
+}
diff --git a/src/vms_f11_bootpath.h b/src/vms_f11_bootpath.h
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_bootpath.h
@@ -0,0 +1,35 @@
+#ifndef VMS37_F11_BOOTPATH_H
+#define VMS37_F11_BOOTPATH_H
+#include "vms_f11_range.h"
+#include "vms_dq_imageprobe.h"
+/* Bounded read-only FIL$FINDFILID, FIL$RDCHKFILHDR, FIL$READVBN chain.
+ * This acts only on a verified privileged boot volume, never as a process
+ * ACP, $OPEN, or $QIO interface. */
+enum { PORT_F11_PATH_OK=1u, PORT_F11_PATH_BAD=2u,
+       PORT_F11_PATH_MAP=4u, PORT_F11_PATH_IO=6u,
+       PORT_F11_PATH_MISSING=8u, PORT_F11_PATH_HEADER=10u };
+struct port_f11_boot_file {
+    struct port_dq_dir_fid directory, file;
+    uint32_t directory_header_lbn,file_header_lbn;
+    uint32_t directory_vbn,file_vbn;
+    uint8_t header[512];
+};
+struct port_f11_boot_volume {
+    const uint8_t *home,*index,*mfd;
+    port_dq_dir_sector_read_fn read_sector;
+    void *context;
+    uint32_t max_directory_vbn;
+};
+uint32_t port_f11_boot_validate_name(const char *,size_t);
+uint32_t port_f11_boot_header(const struct port_f11_boot_volume *,
+    const struct port_dq_dir_fid *,uint32_t *,uint8_t [512]);
+uint32_t port_f11_boot_lookup(const struct port_f11_boot_volume *,
+    const uint8_t [512],const char *,size_t,uint16_t,
+    struct port_dq_dir_fid *,uint32_t *);
+uint32_t port_f11_boot_open(const struct port_f11_boot_volume *,
+    const char *,size_t,const char *,size_t,uint16_t,
+    struct port_f11_boot_file *);
+uint32_t port_f11_boot_read(const struct port_f11_boot_volume *,
+    const struct port_f11_boot_file *,uint32_t,uint32_t,uint8_t *,size_t,
+    uint32_t *);
+#endif
diff --git a/src/vms_f11_bootdir.h b/src/vms_f11_bootdir.h
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_bootdir.h
@@ -0,0 +1,18 @@
+#ifndef VMS37_F11_BOOTDIR_H
+#define VMS37_F11_BOOTDIR_H
+#include "vms_f11_bootpath.h"
+/* Read-only source Files-11 directory scan; callback borrows the entry
+ * name only for its duration and may stop early by returning zero.
+ * No RMS name parser, ACP lock, directory cache or process channel. */
+typedef uint32_t (*port_f11_bootdir_visit_fn)(void *ctx,
+    const uint8_t *name,size_t length,uint16_t version,
+    const struct port_dq_dir_fid *fid);
+enum { PORT_F11_BOOTDIR_OK=1u, PORT_F11_BOOTDIR_BAD=2u,
+       PORT_F11_BOOTDIR_CORRUPT=4u, PORT_F11_BOOTDIR_MAP=6u,
+       PORT_F11_BOOTDIR_STOP=8u };
+uint32_t port_f11_bootdir_block(const uint8_t block[512],
+    port_f11_bootdir_visit_fn visit,void *ctx,uint32_t *seen);
+uint32_t port_f11_bootdir_walk(const struct port_f11_boot_volume *,
+    const uint8_t directory_fh2[512],port_f11_bootdir_visit_fn visit,
+    void *ctx,uint32_t *seen);
+#endif
diff --git a/tests/test_f11_bootpath.c b/tests/test_f11_bootpath.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_bootpath.c
@@ -0,0 +1,126 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "vms_f11_bootpath.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FIL$FINDFILID/FIL$READVBN line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct disk {FILE *f;uint32_t reads,fail_at, fail_lbn;};
+static uint32_t disk_read(void *p,uint32_t lbn,uint8_t sector[512]){
+    struct disk *d=p;
+    if(!d||!sector||!lbn||d->reads++==d->fail_at||lbn==d->fail_lbn||
+       lbn>100000u||fseek(d->f,(long)lbn*512L,SEEK_SET)||
+       fread(sector,1,512u,d->f)!=512u)return PORT_DQ_DIR_MAP;
+    return PORT_DQ_DIR_OK;
+}
+static int read_lbn(FILE *f,uint32_t lbn,uint8_t bytes[512]){
+    return fseek(f,(long)lbn*512L,SEEK_SET)==0&&fread(bytes,1,512u,f)==512u;
+}
+static void poison(struct port_f11_boot_file *f){memset(f,0xa5,sizeof *f);}
+static int poisoned(const struct port_f11_boot_file *f){
+    const uint8_t *p=(const uint8_t *)f;
+    for(size_t i=0;i<sizeof *f;i++)if(p[i]!=0xa5)return 0;
+    return 1;
+}
+static int test_disk(FILE *f){
+    uint8_t home[512],index[512],mfd[512];
+    CHECK(read_lbn(f,1u,home));
+    uint32_t index_lbn=0u,mfd_lbn=0u,mfd_vbn=0u;
+    CHECK(port_dq_index_location(home,&index_lbn)==PORT_DQ_INDEX_OK);
+    CHECK(read_lbn(f,index_lbn,index));
+    CHECK(port_dq_mfd_location(home,index,&mfd_vbn,&mfd_lbn)==PORT_DQ_MFD_OK);
+    CHECK(read_lbn(f,mfd_lbn,mfd));
+    struct disk d={f,0u,UINT32_MAX,UINT32_MAX};
+    struct port_f11_boot_volume v={home,index,mfd,disk_read,&d,1u};
+    const struct {const char *name;uint16_t file_number;} names[]={
+       {"SYS.EXE",11u},{"INILOA.EXE",12u},{"SYSLOA386.EXE",13u}};
+    for(size_t j=0;j<sizeof names/sizeof names[0];j++){
+        struct port_f11_boot_file out;poison(&out);
+        const uint32_t st=port_f11_boot_open(&v,"SYSEXE.DIR",10u,
+           names[j].name,strlen(names[j].name),1u,&out);
+        CHECK(st==PORT_F11_PATH_OK);
+        CHECK(out.directory.number==10u&&out.directory.sequence==10u);
+        CHECK(out.file.number==names[j].file_number);
+        CHECK(out.file.sequence==names[j].file_number&&out.file.volume==0u);
+        CHECK(out.directory_vbn==1u&&out.file_vbn==1u);
+        CHECK(port_dq_image_verify_fh2(out.header,&out.file)==PORT_DQ_IMAGE_OK);
+        uint8_t content[1792];memset(content,0xcd,sizeof content);
+        uint32_t done=UINT32_MAX;
+        CHECK(port_f11_boot_read(&v,&out,399u,1792u,content,
+                sizeof content,&done)==PORT_F11_PATH_OK);
+        CHECK(done==1792u);
+        for(unsigned i=0;i<1792u;i++){
+            uint32_t lbn=0u;
+            CHECK(port_dq_dir_map_vbn(out.header,(399u+i)/512u+1u,&lbn)==PORT_DQ_DIR_OK);
+            uint8_t sec[512];CHECK(read_lbn(f,lbn,sec));
+            CHECK(content[i]==sec[(399u+i)%512u]);
+        }
+        CHECK(d.reads>=8u);
+        const uint32_t old=d.reads;
+        CHECK(port_f11_boot_read(&v,&out,512u,0u,content,
+                sizeof content,&done)==PORT_F11_PATH_OK);
+        CHECK(done==0u&&d.reads==old);
+    }
+    struct port_f11_boot_file out;poison(&out);
+    CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,"SYS.EXE",7u,
+           2u,&out)==PORT_F11_PATH_MISSING);
+    CHECK(poisoned(&out));
+    CHECK(port_f11_boot_open(&v,"DOESNOT.DIR",11u,"SYS.EXE",7u,
+           1u,&out)==PORT_F11_PATH_MISSING);
+    CHECK(poisoned(&out));
+    CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,"NONEXIST.EXE",12u,
+           1u,&out)==PORT_F11_PATH_MISSING);
+    CHECK(poisoned(&out));
+    const char *invalid[]={"","../SYS.EXE","SYS.EXE;1","SYS/EXE",
+                           "SYS\\EXE","SYS EXE","SYS\nEXE"};
+    for(unsigned i=0;i<sizeof invalid/sizeof invalid[0];i++){
+        const char *s=invalid[i];
+        CHECK(port_f11_boot_validate_name(s,strlen(s))==PORT_F11_PATH_BAD);
+        CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,s,strlen(s),
+                 1u,&out)==PORT_F11_PATH_BAD);
+        CHECK(poisoned(&out));
+    }
+    CHECK(port_f11_boot_validate_name("SYS.EXE",7u)==PORT_F11_PATH_OK);
+    CHECK(port_f11_boot_validate_name(NULL,7u)==PORT_F11_PATH_BAD);
+    CHECK(port_f11_boot_validate_name("SYS.EXE",80u)==PORT_F11_PATH_BAD);
+    CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,"SYS.EXE",7u,
+           0u,&out)==PORT_F11_PATH_BAD);
+    CHECK(poisoned(&out));
+    CHECK(port_f11_boot_open(NULL,"SYSEXE.DIR",10u,"SYS.EXE",7u,
+           1u,&out)==PORT_F11_PATH_BAD);
+    CHECK(poisoned(&out));
+    for(uint32_t fail=0u;fail<4u;fail++){
+        d.reads=0u;d.fail_at=fail;
+        CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,"SYS.EXE",7u,
+               1u,&out)!=PORT_F11_PATH_OK);
+        CHECK(poisoned(&out));
+    }
+    d.fail_at=UINT32_MAX;d.reads=0u;
+    CHECK(port_f11_boot_open(&v,"sysexe.dir",10u,"sys.exe",7u,
+           1u,&out)==PORT_F11_PATH_OK);
+    CHECK(out.file.number==11u);
+    uint8_t dest[1200];memset(dest,0xa5,sizeof dest);uint32_t done=0xcafebabeu;
+    CHECK(port_f11_boot_read(&v,&out,10u,1201u,dest,
+                sizeof dest,&done)==PORT_F11_PATH_BAD);
+    CHECK(done==0xcafebabeu&&dest[0]==0xa5);
+    d.fail_at=d.reads+1u;
+    CHECK(port_f11_boot_read(&v,&out,400u,900u,dest,
+                sizeof dest,&done)==PORT_F11_PATH_IO);
+    CHECK(done==112u);
+    d.fail_at=UINT32_MAX;
+    CHECK(port_f11_boot_read(&v,&out,UINT32_MAX-100u,512u,dest,
+                sizeof dest,&done)==PORT_F11_PATH_BAD);
+    uint8_t bad[512];memcpy(bad,mfd,512u);bad[510u]^=1u;
+    v.mfd=bad;poison(&out);
+    CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,"SYS.EXE",7u,
+            1u,&out)==PORT_F11_PATH_HEADER);
+    CHECK(poisoned(&out));
+    CHECK(d.reads>0u);
+    return 0;
+}
+int main(void){
+    FILE *f=fopen("portdisk.img","rb");CHECK(f);
+    CHECK(test_disk(f)==0);
+    CHECK(!fclose(f));
+    puts("FIL$FINDFILID/FIL$RDCHKFILHDR/FIL$READVBN native open + real 3-file access PASS");
+    return 0;
+}
diff --git a/tests/test_f11_bootdir.c b/tests/test_f11_bootdir.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_bootdir.c
@@ -0,0 +1,83 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "vms_f11_bootdir.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FIL$FINDFILID enumerator %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct disk {FILE *f;unsigned reads,fail_at;};
+static uint32_t readsec(void *o,uint32_t lbn,uint8_t out[512]){
+    struct disk *d=o;
+    if(d->reads++==d->fail_at||lbn>8000u||
+       fseek(d->f,(long)lbn*512L,SEEK_SET)||
+       fread(out,1,512u,d->f)!=512u)return PORT_DQ_DIR_MAP;
+    return PORT_DQ_DIR_OK;
+}
+struct found {unsigned exe,ini,loa,visits;};
+static uint32_t visit(void *o,const uint8_t *name,size_t n,
+    uint16_t version,const struct port_dq_dir_fid *f){
+    struct found *t=o;t->visits++;
+    if(n==7u&&!memcmp(name,"SYS.EXE",7u)&&version==1u){
+        if(f->number==11u&&f->sequence==11u)t->exe++;
+    }
+    if(n==10u&&!memcmp(name,"INILOA.EXE",10u)&&version==1u){
+        if(f->number==12u&&f->sequence==12u)t->ini++;
+    }
+    if(n==13u&&!memcmp(name,"SYSLOA386.EXE",13u)&&version==1u){
+        if(f->number==13u&&f->sequence==13u)t->loa++;
+    }
+    return 1u;
+}
+static uint32_t stop(void *o,const uint8_t *name,size_t n,
+    uint16_t ver,const struct port_dq_dir_fid *f){
+    (void)o;(void)name;(void)n;(void)ver;(void)f;return 0u;
+}
+static int diskblock(FILE *f,uint32_t n,uint8_t *b){
+    return fseek(f,(long)n*512L,SEEK_SET)==0&&fread(b,1,512u,f)==512u;
+}
+int main(void){
+    FILE *f=fopen("portdisk.img","rb");CHECK(f);
+    uint8_t home[512],index[512],mfd[512],sysexe[512],block[512];
+    CHECK(diskblock(f,1u,home));uint32_t lbn=0u;
+    CHECK(port_dq_index_location(home,&lbn)==PORT_DQ_INDEX_OK);
+    CHECK(diskblock(f,lbn,index));uint32_t vbn=0u;
+    CHECK(port_dq_mfd_location(home,index,&vbn,&lbn)==PORT_DQ_MFD_OK);
+    CHECK(diskblock(f,lbn,mfd));
+    const struct port_dq_dir_fid d={10u,10u,0u};
+    CHECK(port_dq_image_header_lbn(home,index,&d,&lbn)==PORT_DQ_IMAGE_OK);
+    CHECK(diskblock(f,lbn,sysexe));
+    CHECK(port_dq_dir_validate_header(sysexe,&d)==PORT_DQ_DIR_OK);
+    CHECK(port_dq_dir_map_vbn(sysexe,1u,&lbn)==PORT_DQ_DIR_OK);
+    CHECK(diskblock(f,lbn,block));
+    struct found target={0};uint32_t seen=0u;
+    CHECK(port_f11_bootdir_block(block,visit,&target,&seen)==PORT_F11_BOOTDIR_OK);
+    CHECK(target.exe==1u&&target.ini==1u&&target.loa==1u&&seen>=3u);
+    struct disk io={f,0u,UINT32_MAX};
+    const struct port_f11_boot_volume volume={home,index,mfd,readsec,&io,1u};
+    memset(&target,0,sizeof target);seen=UINT32_MAX;
+    CHECK(port_f11_bootdir_walk(&volume,sysexe,visit,&target,&seen)==PORT_F11_BOOTDIR_OK);
+    CHECK(seen>=3u&&target.visits==seen&&target.exe==1u&&target.ini==1u&&target.loa==1u);
+    CHECK(io.reads==1u);
+    CHECK(port_f11_bootdir_walk(&volume,sysexe,stop,NULL,&seen)==PORT_F11_BOOTDIR_STOP);
+    CHECK(seen==1u);
+    io.fail_at=io.reads;
+    CHECK(port_f11_bootdir_walk(&volume,sysexe,visit,&target,&seen)==PORT_F11_BOOTDIR_MAP);
+    CHECK(seen==0u);
+    CHECK(port_f11_bootdir_block(NULL,visit,&target,&seen)==PORT_F11_BOOTDIR_BAD);
+    CHECK(port_f11_bootdir_block(block,NULL,&target,&seen)==PORT_F11_BOOTDIR_BAD);
+    for(unsigned i=0;i<7u;i++){
+        uint8_t damaged[512];memcpy(damaged,block,512u);
+        switch(i){
+        case 0:damaged[0]=0;damaged[1]=0;break;
+        case 1:damaged[0]=1;damaged[1]=0;break;
+        case 2:damaged[0]=0xfe;damaged[1]=0xff;break;
+        case 3:damaged[5]=0;break;
+        case 4:damaged[5]=255;break;
+        case 5:damaged[0]=0xff;damaged[1]=1;break;
+        default:damaged[0]=0xfd;damaged[1]=0xff;break;
+        }
+        uint32_t inspected=0u;
+        CHECK(port_f11_bootdir_block(damaged,visit,&target,&inspected)==PORT_F11_BOOTDIR_CORRUPT);
+    }
+    CHECK(fclose(f)==0);
+    puts("FIL$FINDFILID physical Files-11 directory enumeration, 3 real image FIDs PASS");
+    return 0;
+}
diff --git a/tests/test_f11_bootdir_fragmented.c b/tests/test_f11_bootdir_fragmented.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_bootdir_fragmented.c
@@ -0,0 +1,76 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_f11_bootdir.h"
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"F11 fragmented directory %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct fake {uint8_t first[512],last[512];unsigned calls,fail_at;};
+static uint32_t read_fake(void *p,uint32_t lbn,uint8_t out[512]){
+    struct fake *f=p;f->calls++;
+    if(f->calls==f->fail_at)return PORT_DQ_DIR_MAP;
+    if(lbn==700u){memcpy(out,f->first,512u);return PORT_DQ_DIR_OK;}
+    if(lbn==1234u){memcpy(out,f->last,512u);return PORT_DQ_DIR_OK;}
+    return PORT_DQ_DIR_MAP;
+}
+static int diskread(FILE *disk,uint32_t lbn,uint8_t out[512]){
+    return fseek(disk,(long)lbn*512L,SEEK_SET)==0&&fread(out,1,512u,disk)==512u;
+}
+static void put16(uint8_t *p,unsigned o,uint16_t v){p[o]=(uint8_t)v;p[o+1u]=(uint8_t)(v>>8u);}
+static void checksum(uint8_t *b){uint16_t sum=0u;for(unsigned i=0;i<510u;i+=2u)sum=(uint16_t)(sum+port_dq_index_word(b,i));put16(b,510u,sum);}
+struct seen {unsigned total,exe,ini,loa;};
+static uint32_t record(void *p,const uint8_t *n,size_t len,uint16_t version,
+                       const struct port_dq_dir_fid *id){
+    struct seen *s=p;s->total++;
+    if(version!=1u)return 0u;
+    if(len==7u&&!memcmp(n,"SYS.EXE",7u)&&id->number==11u)s->exe++;
+    if(len==10u&&!memcmp(n,"INILOA.EXE",10u)&&id->number==12u)s->ini++;
+    if(len==13u&&!memcmp(n,"SYSLOA386.EXE",13u)&&id->number==13u)s->loa++;
+    return 1u;
+}
+int main(void){
+    FILE *disk=fopen("portdisk.img","rb");CHECK(disk);
+    uint8_t home[512],index[512],mfd[512],fh2[512],real[512];
+    uint32_t lbn=0u,vbn=0u;
+    CHECK(diskread(disk,1u,home));
+    CHECK(port_dq_index_location(home,&lbn)==PORT_DQ_INDEX_OK);
+    CHECK(diskread(disk,lbn,index));
+    CHECK(port_dq_mfd_location(home,index,&vbn,&lbn)==PORT_DQ_MFD_OK);
+    CHECK(diskread(disk,lbn,mfd));
+    const struct port_dq_dir_fid dir={10u,10u,0u};
+    CHECK(port_dq_image_header_lbn(home,index,&dir,&lbn)==PORT_DQ_IMAGE_OK);
+    CHECK(diskread(disk,lbn,fh2));
+    CHECK(port_dq_dir_map_vbn(fh2,1u,&lbn)==PORT_DQ_DIR_OK);
+    CHECK(diskread(disk,lbn,real));
+    struct fake f={0};
+    memcpy(f.last,real,512u);
+    put16(f.first,0u,UINT16_MAX);
+    const unsigned p=(unsigned)fh2[1u]*2u;
+    CHECK(p+8u<510u);
+    fh2[58u]=4u;
+    put16(fh2,p,UINT16_C(0x4000));put16(fh2,p+2u,700u);
+    put16(fh2,p+4u,UINT16_C(0x4000));put16(fh2,p+6u,1234u);
+    checksum(fh2);
+    struct port_f11_boot_volume volume={home,index,mfd,read_fake,&f,2u};
+    uint32_t matched=0u,entries=0u;struct port_dq_dir_fid fid={0};
+    CHECK(port_f11_boot_lookup(&volume,fh2,"SYS.EXE",7u,1u,&fid,
+           &matched)==PORT_F11_PATH_OK);
+    CHECK(matched==2u&&fid.number==11u&&f.calls==2u);
+    struct seen observed={0};f.calls=0u;
+    CHECK(port_f11_bootdir_walk(&volume,fh2,record,&observed,
+           &entries)==PORT_F11_BOOTDIR_OK);
+    CHECK(f.calls==2u&&entries==3u&&observed.total==3u);
+    CHECK(observed.exe==1u&&observed.ini==1u&&observed.loa==1u);
+    for(unsigned fail=1u;fail<=2u;fail++){
+        f.fail_at=fail;f.calls=0u;entries=UINT32_MAX;
+        memset(&observed,0,sizeof observed);
+        CHECK(port_f11_bootdir_walk(&volume,fh2,record,&observed,
+              &entries)==PORT_F11_BOOTDIR_MAP);
+        CHECK(entries==(fail==1u?0u:0u));
+        f.calls=0u;matched=0xcafebabeu;fid.number=77u;
+        CHECK(port_f11_boot_lookup(&volume,fh2,"SYS.EXE",7u,1u,&fid,
+             &matched)==PORT_F11_PATH_MAP);
+        CHECK(matched==0xcafebabeu&&fid.number==77u);
+    }
+    CHECK(fclose(disk)==0);
+    puts("FIL$FINDFILID/FIL$READVBN fragmented two-VBN physical directory and rollback PASS");
+    return 0;
+}
diff --git a/tools/qemu_sysboot_m149.py b/tools/qemu_sysboot_m149.py
new file mode 100644
--- /dev/null
+++ b/tools/qemu_sysboot_m149.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""One real native IA-32 QEMU boot; verify DPL0 software IPL4 dispatch.
+
+Only source-derived loaded SYS.EXE PFLVEC/INTSTKLM records and an incomplete-INIT stop
+are successful here. A fabricated login or an old monitor prompt is failure.
+"""
+import os
+from pathlib import Path
+import select
+import shutil
+import subprocess
+import sys
+import time
+from datetime import datetime, timezone
+from checkpoint_serial_logs import capture
+ROOT=Path(__file__).resolve().parents[1]
+
+def main():
+    machine=shutil.which('qemu-system-i386') or shutil.which('qemu-system-x86_64')
+    if not machine:
+        print('QEMU M149: system QEMU not installed',file=sys.stderr)
+        return 77
+    cmd=[machine,'-display','none','-monitor','none','-serial','stdio',
+         '-m','128','-boot','a','-no-reboot','-accel','tcg',
+         '-drive','if=floppy,format=raw,file='+str(ROOT/'vms37lab.ima')+',snapshot=on',
+         '-drive','if=ide,index=0,media=disk,format=raw,file='+str(ROOT/'portdisk.img')+',snapshot=on']
+    p=subprocess.Popen(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,
+                       stderr=subprocess.PIPE,bufsize=0)
+    observed=bytearray()
+    expected=[
+        b'SYSBOOT: Files-11 SYS.EXE normalized 32-bit retrieval map stored.',
+        b'SYSBOOT: Files-11 SYS.EXE native image loaded.',
+        b'INIT: loaded SYS.EXE initialized real IRP/LRP/SRP lookaside headers.',
+        b'SYSBOOT: Files-11 SYSLOA386.EXE native image loaded.',
+        b'INIT: SYS.EXE linked live SYSLOA386 processor vectors.',
+        b'SYSBOOT: Files-11 INILOA.EXE native image loaded.',
+        b'INIT: INILOA IOMAP executed on real IA-32 boot adapter.',
+        b'INIT: loaded SYS.EXE built lock ID, resource hash and deadlock bitmap tables.',
+        b'INIT: loaded SYS.EXE initialized SYSTEM and NULL PCB/sequence vectors.',
+        b'INIT: loaded SYS.EXE initialized process header vector and swapper PTE records.',
+        b'INIT: loaded SYS.EXE initialized modified-page writer PTE/index map.',
+        b'INIT: loaded SYS.EXE allocated unbound pagefile pointer vector.',
+        b'INIT: loaded SYS.EXE recorded real IA-32 TSS privilege stack and lock depth.',
+        b'INIT: loaded SYS.EXE compacted real Files-11 SYS.EXE BOO$ WCB map.',
+        b'INIT: SYS.EXE staged MB/NL/OP DPT headers (driver images not linked).',
+        b'INIT: loaded SYS.EXE executed original NLDRIVER read/write FDT (IOC pending).',
+        b'INIT: SYS.EXE staged original DYN$C_LOG=11 records (logical service pending).',
+        b'INIT: SYS.EXE selected registered ATA boot adapter (DDB/UCB pending).',
+        b'INIT: SYS.EXE staged DQDRIVER 12 source FDT masks (disk DDT and ACP unbound).',
+        b'INIT: SYS.EXE linked NL$DDT DDTAB/FUNCTAB to NLA0 (other drivers absent).',
+        b'INIT: SYS.EXE DQ READPBLK fetched actual ATA Files-11 LBN1 (disk DDT/ACP not linked).',
+        b'INIT: SYS.EXE DQ READPBLK fetched real ATA LBN0 in second privileged IRP (no public QIO).',
+        b'INIT: SYS.EXE DQ READPBLK verified real ATA INDEXF.SYS FH2 in third privileged IRP (ACP unbound).',
+        b'INIT: SYS.EXE DQ READPBLK verified real ATA MFD FID 4,4,0 via INDEXF.SYS extent map (ACP unbound).',
+        b'INIT: SYS.EXE native FIL$FINDFILID traversed real MFD and SYSEXE.DIR to SYS.EXE FID 11 (ACP unbound).',
+        b'INIT: SYS.EXE FIL$READVBN verified real ATA SYS.EXE FH2 and native ELF32 via IRPs 8 and 9 (activation pending).',
+        b'INIT: SYS.EXE FIL$READVBN verified complete native executable PT_LOAD text against resident SYS.EXE (activation pending).',
+        b'INIT: SYS.EXE verified native SYSLOA386.EXE and INILOA.EXE text from real Files-11 ATA sectors (ACP unbound).',
+        b'INIT: SYS.EXE FIL$READVBN verified unaligned 1024-byte range through three real ATA IRPs (ACP unbound).',
+        b'INIT: SYS.EXE native FIL$FINDFILID reopened SYS.EXE through real MFD/SYSEXE/FH2 and verified 768 text bytes (ACP unbound).',
+        b'INIT: SYS.EXE native FIL$FINDFILID enumerated real SYSEXE.DIR image FIDs via ATA (ACP unbound).',
+        b'INIT: SYS.EXE FIN_DATABASE staged DQA0 names and resident SYS$DISK/SYS$SYSDEVICE (logical lookup pending).',
+        b'INIT: SYS.EXE LOG$TRANSLATE resolved original SYS$DISK and SYS$SYSDEVICE names (system bootstrap only).',
+        b'INIT: SYS.EXE executed console XON/XOFF/STOP/RESUME transitions (TT driver absent).',
+        b'INIT: SYS.EXE IOC device search resolved NLA0 with native null DDT (others unbound).',
+        b'INIT: SYS.EXE IOC$SEARCHDEV resolved SYS$DISK/SYS$SYSDEVICE to unbound DQA0 and NLA0 to linked DDT (no $ASSIGN).',
+        b'INIT: SYS.EXE staged source DQ DPTAB/DDTAB and 136-byte FUNCTAB (all disk actions unbound).',
+        b'INIT: SYS.EXE RELOCDRV IOC$INITDRV applied source DQ DPT_STORE to private DQA0 records (DDT/CRB unbound).',
+        b'INIT: resident IOC$RELOC_DDT source DDT/FDT relocation verified (private only; DQA0 unbound).',
+        b'INIT: SYS.EXE NLDRIVER completed two IRPs via linked DDT/FDT and EXE$FINISHIOC (IPL4 requested).',
+        b'INIT: SYS.EXE IOCIOPOST serviced two NLA IRPs through IA-32 CPL0 software INT 0x90 (no process AST).',
+        b'INIT: loaded SYS.EXE resident entry executed and verified.',
+        b'INIT: linked SYSLOA386 read real IDT, CR0, CR3, TSS, PIT and Files-11 boot home.',
+        b'INIT: actual IRQ0 advanced resident SYS.EXE VMS clock.',
+        b'INIT stopped: remaining original initialization dependencies incomplete.']
+    failures=[
+        b'SYSBOOT: SYS.EXE retrieval map invalid.',
+        b'-F-Unable to locate SYS.EXE',
+        b'-F-Unable to locate usable SYSLOA386.EXE',
+        b'-F-Unable to locate INILOA.EXE',
+        b'SYSBOOT: SYSLOA386.EXE image validation or loading failed.',
+        b'INIT: SYSLOA386 self-describing vector image invalid.',
+        b'INIT: resident SYS.EXE SYSLOA386 vector linking failed.',
+        b'INIT: SYS.EXE packet queue initialization failed.',
+        b'INIT: resident SYS.EXE lock database setup failed.',
+        b'INIT: resident SYS.EXE PCB sequence vectors failed.',
+        b'INIT: resident SYS.EXE PHV and swap PTE record validation failed.',
+        b'INIT: resident SYS.EXE modified-page writer record validation failed.',
+        b'INIT: resident SYS.EXE interrupt stack depth setup failed.',
+        b'INIT: resident SYS.EXE SYSWCB map overlay validation failed.',
+        b'INIT: resident SYS.EXE pointer vector setup failed.',
+        b'INIT: resident SYS.EXE logical record staging failed.',
+        b'INIT: resident SYS.EXE DPT prologue staging failed.',
+        b'INIT: resident SYS.EXE null driver FDT validation failed.',
+        b'INIT: resident SYS.EXE boot adapter scan failed.',
+        b'INIT: resident source DQ FDT staging validation failed.',
+        b'INIT: resident DQ physical boot READPBLK failed.',
+        b'INIT: resident DQ physical LBN0 READPBLK failed.',
+        b'INIT: resident SYS.EXE INDEXF.SYS physical FH2 read failed.',
+        b'INIT: resident SYS.EXE MFD FH2 indexed physical read failed.',
+        b'INIT: resident SYS.EXE Files-11 MFD/SYSEXE directory traversal failed.',
+        b'INIT: resident SYS.EXE physical ELF32 source probe failed.',
+        b'INIT: resident native auxiliary disk text verification failed.',
+        b'INIT: resident FIN_DATABASE source boot DDB/logical record staging failed.',
+        b'INIT: resident source LOGNAMSUB bootstrap translation failed.',
+        b'INIT: SYS.EXE DEVICEDAT DDB/UCB prelink validation failed.',
+        b'INIT: resident CONINTDSP source port action checks failed.',
+        b'INIT: resident SYS.EXE physical IOC name search validation failed.',
+        b'INIT: resident IOC logical to physical boot name lookup failed.',
+        b'INIT: resident DQ DDT source table staging failed.',
+        b'INIT: resident RELOCDRV original DQ INITDRV table failed.',
+        b'INIT: resident SYS.EXE NLDRIVER to IOC post queue failed.',
+        b'INIT: resident private IOC$RELOC_DDT failed.',
+        b'INIT: resident IOCIOPOST source kernel end-action processing failed.',
+        b'INIT: resident IOCIOPOST native software interrupt failed.',
+        b'INIT: SYS.EXE resident initialization failed.',
+        b'INIT: SYS.EXE PIT clock handoff failed.',
+        b'INIT: live SYS.EXE PIT clock did not advance.',
+        b'INIT: IA-32 privilege transition stack is unprotected.',
+        b'PORTLAB> ',b'Login successful',b'Login: ',b'\n$ ']
+    passed=False
+    try:
+        until=time.monotonic()+80
+        while time.monotonic()<until:
+            if any(x in observed for x in failures):break
+            if all(x in observed for x in expected):
+                positions=[observed.index(x) for x in expected]
+                passed=positions==sorted(positions)
+                break
+            if p.poll() is not None:break
+            ready,_,_=select.select([p.stdout],[],[],0.25)
+            if ready:
+                chunk=os.read(p.stdout.fileno(),4096)
+                if not chunk:break
+                observed.extend(chunk)
+    finally:
+        p.terminate()
+        try:p.wait(timeout=3)
+        except subprocess.TimeoutExpired:p.kill();p.wait()
+        # Preserve COM1 bytes exactly; QEMU stderr is a separate diagnostic.
+        qemu_stderr=p.stderr.read(8192)
+        serial_path=ROOT/'qemu-m149-serial.log'
+        serial_path.write_bytes(observed)
+        # Always retain the real transcript, including failed QEMU attempts.
+        # GitHub run attempts get distinct keys; local runs get UTC keys.
+        ci_run=os.environ.get('GITHUB_RUN_ID')
+        ci_attempt=os.environ.get('GITHUB_RUN_ATTEMPT','1')
+        identifier=(ci_run + ('-attempt'+ci_attempt if ci_attempt!='1' else '')
+                    if ci_run else 'local-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'))
+        run_url=('https://github.com/tuklusan/OpticOS/actions/runs/'+ci_run
+                 if ci_run else '')
+        capture(ROOT,serial_path,149,identifier,run_url,
+                'harness-pass' if passed else 'harness-fail')
+    if passed:
+        print('QEMU M149: resident source DDT/FDT relocation in private SYS.EXE memory PASS')
+        return 0
+    print('QEMU M149: real guest execution or source-order check failed',file=sys.stderr)
+    print(observed[-8192:].decode('ascii','replace'),file=sys.stderr)
+    print(qemu_stderr.decode('ascii','replace'),file=sys.stderr)
+    return 1
+if __name__=='__main__':raise SystemExit(main())
