diff --git a/src/vms_f11_channel.h b/src/vms_f11_channel.h
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_channel.h
@@ -0,0 +1,39 @@
+#ifndef VMS37_F11_CHANNEL_H
+#define VMS37_F11_CHANNEL_H
+#include "vms_f11_ioc.h"
+/* M185-M192. Read-only privileged source FIL$READVBN / IOC assignment
+ * interface. This is NOT VMS process $ASSIGN, ACP or DQA0 public $QIO.
+ * Every call executes at supervisor boot privilege only. */
+#define PORT_F11_CHAN_SLOTS 4u
+#define PORT_F11_CHAN_MAX_GENERATION 0x00ffffffu
+enum { PORT_F11_CHAN_OK=1u, PORT_F11_CHAN_BAD=2u,
+       PORT_F11_CHAN_BUSY=4u, PORT_F11_CHAN_NOCHANNEL=6u,
+       PORT_F11_CHAN_EOF=8u, PORT_F11_CHAN_IO=10u,
+       PORT_F11_CHAN_DIFFERENT=12u };
+struct port_f11_chan_slot {
+ struct port_f11_ioc_file file;
+ uint32_t owner,generation;
+ uint8_t assigned;
+};
+struct port_f11_chan_table {
+ const struct port_f11_chain *chain;
+ struct port_dq_ioc_queue *queue;
+ uint32_t length,next_generation,open_count,assignments,releases;
+ struct port_f11_chan_slot slots[PORT_F11_CHAN_SLOTS];
+};
+struct port_f11_chan_status {
+ uint32_t owner,handle,position,length,physical_reads;
+};
+uint32_t port_f11_chan_init(struct port_f11_chan_table *,
+ const struct port_f11_chain *,struct port_dq_ioc_queue *,uint32_t);
+uint32_t port_f11_chan_validate(const struct port_f11_chan_table *);
+uint32_t port_f11_chan_assign(struct port_f11_chan_table *,uint32_t,uint32_t *);
+uint32_t port_f11_chan_release(struct port_f11_chan_table *,uint32_t,uint32_t);
+uint32_t port_f11_chan_seek(struct port_f11_chan_table *,uint32_t,uint32_t,uint32_t);
+uint32_t port_f11_chan_read(struct port_f11_chan_table *,uint32_t,uint32_t,
+ uint8_t *,uint32_t,size_t,uint32_t *);
+uint32_t port_f11_chan_compare(struct port_f11_chan_table *,uint32_t,uint32_t,
+ const uint8_t *,uint32_t,uint32_t *);
+uint32_t port_f11_chan_status(struct port_f11_chan_table *,uint32_t,uint32_t,
+ struct port_f11_chan_status *);
+#endif
diff --git a/src/vms_f11_channel_priv.h b/src/vms_f11_channel_priv.h
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_channel_priv.h
@@ -0,0 +1,17 @@
+#include "vms_f11_channel.h"
+/* Source-private channel handle: 24-bit monotonic generation and 1-based slot.
+ * Old handles never alias new ones during the finite boot lifetime. */
+static inline struct port_f11_chan_slot *port_f11_chan_get(
+ struct port_f11_chan_table *t,uint32_t owner,uint32_t handle){
+ if(!t||!owner||!(handle&255u)||((handle&255u)>PORT_F11_CHAN_SLOTS))return 0;
+ struct port_f11_chan_slot *s=&t->slots[(handle&255u)-1u];
+ if(!s->assigned||s->owner!=owner||s->generation!=(handle>>8))return 0;
+ return s;
+}
+static inline uint32_t port_f11_chan_map_status(uint32_t status){
+ if(status==PORT_F11_IOC_OK)return PORT_F11_CHAN_OK;
+ if(status==PORT_F11_IOC_EOF)return PORT_F11_CHAN_EOF;
+ if(status==PORT_F11_IOC_IO)return PORT_F11_CHAN_IO;
+ if(status==PORT_F11_IOC_DIFFERENT)return PORT_F11_CHAN_DIFFERENT;
+ return status==PORT_F11_IOC_BUSY?PORT_F11_CHAN_BUSY:PORT_F11_CHAN_BAD;
+}
diff --git a/tests/test_f11_channel_cases.h b/tests/test_f11_channel_cases.h
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_channel_cases.h
@@ -0,0 +1,34 @@
+#ifndef M192_CHANNEL_CASES_H
+#define M192_CHANNEL_CASES_H
+#include "vms_f11_channel.h"
+#include <assert.h>
+#include <string.h>
+struct m192_env {
+ struct port_f11_chain chain;
+ struct port_dq_ioc_queue queue;
+ struct port_f11_chan_table table;
+ uint32_t reads,fail_at;
+};
+static inline uint8_t m192_byte(uint32_t lbn,uint32_t i){
+ return (uint8_t)(lbn*13u+i*7u+11u);
+}
+static inline uint32_t m192_sector(void *ctx,uint32_t lbn,uint8_t out[512]){
+ struct m192_env *e=ctx;e->reads++;
+ if(e->fail_at&&e->reads==e->fail_at)return 0;
+ for(unsigned i=0;i<512;i++)out[i]=m192_byte(lbn,i);
+ return 1u;
+}
+static inline void m192_setup(struct m192_env *e){
+ memset(e,0,sizeof(*e));e->chain.count=2;e->chain.blocks=6;
+ e->chain.extents[0].lbn=40;e->chain.extents[0].blocks=3;
+ e->chain.extents[1].lbn=80;e->chain.extents[1].blocks=3;
+ assert(port_dq_ioc_init(&e->queue,m192_sector,e)==PORT_DQ_IOC_OK);
+ assert(port_f11_chan_init(&e->table,&e->chain,&e->queue,3072)==PORT_F11_CHAN_OK);
+}
+static inline uint32_t m192_lbn(uint32_t offset){
+ uint32_t b=offset/512u;return b<3u?40u+b:80u+b-3u;
+}
+static inline void m192_expected(uint8_t *out,uint32_t from,uint32_t count){
+ for(uint32_t i=0;i<count;i++)out[i]=m192_byte(m192_lbn(from+i),(from+i)%512u);
+}
+#endif
