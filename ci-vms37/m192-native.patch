diff --git a/src/vms_f11_channel_assign.c b/src/vms_f11_channel_assign.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_channel_assign.c
@@ -0,0 +1,20 @@
+#include "vms_f11_channel_priv.h"
+/* M187: generation-protected source-style private channel assignment. */
+uint32_t port_f11_chan_assign(struct port_f11_chan_table *t,
+ uint32_t owner,uint32_t *handle){
+ if(!t||!owner||!handle||
+    port_f11_chan_validate(t)!=PORT_F11_CHAN_OK)return PORT_F11_CHAN_BAD;
+ if(t->next_generation>PORT_F11_CHAN_MAX_GENERATION)return PORT_F11_CHAN_BUSY;
+ for(unsigned i=0;i<PORT_F11_CHAN_SLOTS;i++){
+  struct port_f11_chan_slot *s=&t->slots[i];
+  if(s->assigned)continue;
+  struct port_f11_ioc_file file={0};
+  if(port_f11_ioc_init(&file,t->chain,t->queue,t->length)!=PORT_F11_IOC_OK)
+   return PORT_F11_CHAN_BAD;
+  s->file=file;s->owner=owner;s->generation=t->next_generation++;
+  s->assigned=1u;t->open_count++;t->assignments++;
+  *handle=(s->generation<<8)|(i+1u);
+  return PORT_F11_CHAN_OK;
+ }
+ return PORT_F11_CHAN_BUSY;
+}
diff --git a/src/vms_f11_channel_compare.c b/src/vms_f11_channel_compare.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_channel_compare.c
@@ -0,0 +1,11 @@
+#include "vms_f11_channel_priv.h"
+/* M191: compare media bytes to resident image, not a synthetic prompt. */
+uint32_t port_f11_chan_compare(struct port_f11_chan_table *t,
+ uint32_t owner,uint32_t handle,const uint8_t *expected,
+ uint32_t count,uint32_t *equal){
+ struct port_f11_chan_slot *s=port_f11_chan_get(t,owner,handle);
+ if(!s)return PORT_F11_CHAN_NOCHANNEL;
+ if(!expected||!equal)return PORT_F11_CHAN_BAD;
+ return port_f11_chan_map_status(port_f11_ioc_compare(
+          &s->file,expected,count,equal));
+}
diff --git a/src/vms_f11_channel_init.c b/src/vms_f11_channel_init.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_channel_init.c
@@ -0,0 +1,12 @@
+#include "vms_f11_channel_priv.h"
+/* M185: initialize bounded supervisor-only channel table. */
+uint32_t port_f11_chan_init(struct port_f11_chan_table *t,
+ const struct port_f11_chain *c,struct port_dq_ioc_queue *q,uint32_t length){
+ if(!t||!c||!q)return PORT_F11_CHAN_BAD;
+ struct port_f11_ioc_file probe={0};
+ if(port_f11_ioc_init(&probe,c,q,length)!=PORT_F11_IOC_OK)
+  return PORT_F11_CHAN_BAD;
+ struct port_f11_chan_table v={0};
+ v.chain=c;v.queue=q;v.length=length;v.next_generation=1u;
+ *t=v;return PORT_F11_CHAN_OK;
+}
