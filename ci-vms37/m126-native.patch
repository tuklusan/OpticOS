diff --git a/src/vms_dq_bootread.h b/src/vms_dq_bootread.h
new file mode 100644
index 0000000..51ae7a9
--- /dev/null
+++ b/src/vms_dq_bootread.h
@@ -0,0 +1,47 @@
+#ifndef VMS_DQ_BOOTREAD_H
+#define VMS_DQ_BOOTREAD_H
+#include <stddef.h>
+#include <stdint.h>
+#include "vms_dq_fdt.h"
+#include "vms_ini_devicedb.h"
+#include "vms_qio_post.h"
+/* DRIVER/SRC/DQDRIVER.MAR PREPROCESS (640-671), FDISPATCH (678-709),
+ * NORMAL/FUNCXT (790-940) on native ATA. Stage is one privileged raw
+ * Files-11 home block READPBLK, not a complete DQ driver or user $QIO.
+ * Source code uses IRP$L_MEDIA at offset 56 to hold the LBN before
+ * completion, sharing storage with IOST1 after completion. */
+enum {PORT_DQ_BOOTREAD_OK=1u, PORT_DQ_BOOTREAD_BAD=2u,
+      PORT_DQ_BOOTREAD_UNBOUND=4u,PORT_DQ_BOOTREAD_MEDIA=6u,
+      PORT_DQ_BOOTREAD_FAILED=8u,PORT_DQ_BOOTREAD_DONE=10u,
+      PORT_DQ_PHYSIO=0x0100u,PORT_DQ_UCB_MEDIA=156u,
+      PORT_DQ_UCB_FEX=134u,PORT_DQ_UCB_BCR=166u,
+      PORT_DQ_UCB_FUNC=142u,PORT_DQ_UCB_VALID=0x0800u,
+      PORT_DQ_BOOTREAD_LBN=1u,PORT_DQ_BOOTREAD_BYTES=512u};
+typedef int (*port_dq_native_read_fn)(void *,uint32_t,uint16_t[256]);
+struct port_dq_bootread_request {
+    const struct port_dq_fdt *fdt;
+    const uint8_t *device_db;
+    const struct port_v37_device_result *device_info;
+    uint8_t *irp;
+    size_t irp_bytes;
+    uint16_t *sector;
+    size_t sector_bytes;
+    uint16_t boot_unit;
+    port_dq_native_read_fn read_sector;
+    void *read_context;
+};
+struct port_dq_bootread_result {
+    uint32_t lbn,bytes,irp_status,irp_second;
+    uint32_t ucb_media,ucb_io_count;
+    uint16_t io_function,unit;
+    uint16_t sector_checksum,software_online;
+};
+uint32_t port_dq_bootread_preflight(const struct port_dq_bootread_request *);
+uint32_t port_dq_bootread_decode(const struct port_dq_bootread_request *,
+                                uint32_t *lbn,uint16_t *function);
+uint32_t port_dq_bootread_commit(const struct port_dq_bootread_request *,
+    const uint16_t [256],struct port_dq_bootread_result *);
+uint16_t port_dq_bootread_checksum(const uint16_t [256]);
+uint32_t port_dq_bootread_execute(const struct port_dq_bootread_request *,
+                                 struct port_dq_bootread_result *);
+#endif
diff --git a/src/vms_dq_bootread_checksum.c b/src/vms_dq_bootread_checksum.c
new file mode 100644
index 0000000..7e5d1d2
--- /dev/null
+++ b/src/vms_dq_bootread_checksum.c
@@ -0,0 +1,9 @@
+#include "vms_dq_bootread.h"
+/* MOUNT/SRC/CHKSM2.B32: original Files-11 ODS2 home-checksum semantics.
+ * No fake signature: checksum the bytes returned by the real ATA read. */
+uint16_t port_dq_bootread_checksum(const uint16_t words[256]){
+    if(!words)return 0u;
+    uint16_t s=0u;
+    for(unsigned i=0;i<255u;i++)s=(uint16_t)(s+words[i]);
+    return s;
+}
diff --git a/src/vms_dq_bootread_commit.c b/src/vms_dq_bootread_commit.c
new file mode 100644
index 0000000..fbe6937
--- /dev/null
+++ b/src/vms_dq_bootread_commit.c
@@ -0,0 +1,34 @@
+#include "vms_dq_bootread.h"
+/* Source DQDRIVER PREPROCESS/FUNCXT: commit *after* successful hardware
+ * operation, leaving failed/preflight requests and UCB intact. Physical
+ * boot READPBLK bypasses volume VALID exactly as source FDISPATCH does. */
+uint32_t port_dq_bootread_commit(const struct port_dq_bootread_request *q,
+    const uint16_t sector[256],struct port_dq_bootread_result *out){
+    if(!q||!sector||!out||!q->irp||!q->sector||!q->device_db||
+       q->sector_bytes!=PORT_DQ_BOOTREAD_BYTES)
+        return PORT_DQ_BOOTREAD_BAD;
+    uint8_t *u=(uint8_t *)(uintptr_t)(q->device_db+PORT_V37_UCB_BOOT_OFF);
+    const uint32_t ops=port_v37_read32(u+PORT_V37_UCB_OPCNT);
+    if(ops==UINT32_MAX)return PORT_DQ_BOOTREAD_BAD;
+    for(unsigned i=0;i<256u;i++)q->sector[i]=sector[i];
+    const uint32_t block=port_v37_read32(q->irp+PORT_V37_IRP_MEDIA);
+    port_v37_write32(u+PORT_DQ_UCB_MEDIA,block);
+    port_v37_write16(u+PORT_DQ_UCB_FUNC,PORT_DQ_READPBLK);
+    u[PORT_DQ_UCB_FEX]=(uint8_t)PORT_DQ_READPBLK;
+    u[112u]=u[113u]; /* source retry count initialization */
+    port_v37_write16(u+PORT_DQ_UCB_BCR,0u);
+    port_v37_write32(u+PORT_V37_UCB_OPCNT,ops+1u);
+    /* SYSQIOREQ EXE$FINISHIOC source IRP fields: IOST1 status and IOST2
+     * transferred bytes; no event flag or user-visible IOSB is posted. */
+    port_v37_write32(q->irp+PORT_V37_IRP_MEDIA,PORT_SYS85_NORMAL);
+    port_v37_write32(q->irp+PORT_V37_IRP_IOST2,PORT_DQ_BOOTREAD_BYTES);
+    *out=(struct port_dq_bootread_result){
+        .lbn=block,.bytes=PORT_DQ_BOOTREAD_BYTES,
+        .irp_status=port_v37_read32(q->irp+PORT_V37_IRP_MEDIA),
+        .irp_second=port_v37_read32(q->irp+PORT_V37_IRP_IOST2),
+        .ucb_media=port_v37_read32(u+PORT_DQ_UCB_MEDIA),
+        .ucb_io_count=ops+1u,.io_function=PORT_DQ_READPBLK,
+        .unit=q->boot_unit,.sector_checksum=port_dq_bootread_checksum(sector),
+        .software_online=(uint16_t)((port_v37_read16(u+88u)&PORT_V37_UCB_ONLINE)!=0u)};
+    return PORT_DQ_BOOTREAD_OK;
+}
diff --git a/src/vms_dq_bootread_decode.c b/src/vms_dq_bootread_decode.c
new file mode 100644
index 0000000..6fdba43
--- /dev/null
+++ b/src/vms_dq_bootread_decode.c
@@ -0,0 +1,21 @@
+#include "vms_dq_bootread.h"
+/* DQ FDISPATCH first tests physical mode and legal FDT, then uses
+ * IRP$W_FUNC and IRP$L_MEDIA. This hardware-independent decode remains
+ * strictly bounded to one LBN 1 home block during bootstrap. */
+uint32_t port_dq_bootread_decode(const struct port_dq_bootread_request *q,
+                                uint32_t *lbn,uint16_t *function){
+    if(!q||!q->fdt||!q->irp||!lbn||!function)
+        return PORT_DQ_BOOTREAD_BAD;
+    const uint16_t func=port_v37_read16(q->irp+PORT_V37_IRP_FUNC);
+    const uint32_t media=port_v37_read32(q->irp+PORT_V37_IRP_MEDIA);
+    if(media!=PORT_DQ_BOOTREAD_LBN)return PORT_DQ_BOOTREAD_MEDIA;
+    if(func!=PORT_DQ_READPBLK)return PORT_DQ_BOOTREAD_UNBOUND;
+    struct port_dq_fdt_decision d={0};
+    if(port_dq_fdt_classify(q->fdt,sizeof(*q->fdt),func,&d)!=PORT_DQ_FDT_OK ||
+       d.action_class!=PORT_DQ_FDT_READ || d.buffered || d.driver_bound ||
+       d.full_function!=PORT_DQ_READPBLK)
+        return PORT_DQ_BOOTREAD_UNBOUND;
+    *lbn=media;
+    *function=func;
+    return PORT_DQ_BOOTREAD_OK;
+}
diff --git a/src/vms_dq_bootread_execute.c b/src/vms_dq_bootread_execute.c
new file mode 100644
index 0000000..3f800d2
--- /dev/null
+++ b/src/vms_dq_bootread_execute.c
@@ -0,0 +1,18 @@
+#include "vms_dq_bootread.h"
+/* Complete one READPBLK of the original boot disk, using real IA32 ATA
+ * only. No hidden fake disk, user-mode $QIO, RB730 emulation or write. */
+uint32_t port_dq_bootread_execute(const struct port_dq_bootread_request *q,
+                                  struct port_dq_bootread_result *out){
+    if(!out)return PORT_DQ_BOOTREAD_BAD;
+    uint32_t st=port_dq_bootread_preflight(q);
+    if(st!=PORT_DQ_BOOTREAD_OK)return st;
+    uint32_t lbn=0u;uint16_t function=0u;
+    st=port_dq_bootread_decode(q,&lbn,&function);
+    if(st!=PORT_DQ_BOOTREAD_OK)return st;
+    if(function!=PORT_DQ_READPBLK||lbn!=PORT_DQ_BOOTREAD_LBN)
+        return PORT_DQ_BOOTREAD_UNBOUND;
+    uint16_t scratch[256];
+    if(q->read_sector(q->read_context,lbn,scratch)!=0)
+        return PORT_DQ_BOOTREAD_FAILED;
+    return port_dq_bootread_commit(q,scratch,out);
+}
diff --git a/src/vms_dq_bootread_preflight.c b/src/vms_dq_bootread_preflight.c
new file mode 100644
index 0000000..3a6c7ef
--- /dev/null
+++ b/src/vms_dq_bootread_preflight.c
@@ -0,0 +1,46 @@
+#include "vms_dq_bootread.h"
+/* Privileged-only early-INIT DQ read path. Strictly no user buffers,
+ * media writes, ACP invocation or emulated RB730 channel ownership. */
+static int disjoint(const void *a,size_t as,const void *b,size_t bs){
+    uintptr_t x=(uintptr_t)a,y=(uintptr_t)b;
+    if(as>UINTPTR_MAX-x||bs>UINTPTR_MAX-y)return 0;
+    return x+as<=y||y+bs<=x;
+}
+uint32_t port_dq_bootread_preflight(const struct port_dq_bootread_request *q){
+    if(!q||!q->irp||!q->sector||!q->device_info||!q->device_db||
+       !q->read_sector||!q->fdt||q->irp_bytes!=PORT_V37_IRP_SIZE||
+       q->sector_bytes!=PORT_DQ_BOOTREAD_BYTES||q->boot_unit!=0u||
+       ((uintptr_t)q->irp&3u)||((uintptr_t)q->sector&1u)||
+       !disjoint(q->sector,q->sector_bytes,q->irp,q->irp_bytes)||
+       !disjoint(q->sector,q->sector_bytes,q->device_db,PORT_V37_DEVICE_BYTES)||
+       !disjoint(q->irp,q->irp_bytes,q->device_db,PORT_V37_DEVICE_BYTES)||
+       !disjoint(q->sector,q->sector_bytes,q->fdt,sizeof(*q->fdt))||
+       !disjoint(q->irp,q->irp_bytes,q->fdt,sizeof(*q->fdt)))
+        return PORT_DQ_BOOTREAD_BAD;
+    if(port_v37_devices_check(q->device_db,PORT_V37_DEVICE_BYTES,
+         (uint32_t)(uintptr_t)q->device_db,q->device_info)!=PORT_V37_DEV_OK ||
+       q->device_info->incomplete_driver_mask!=7u ||
+       !q->device_info->bound_nl_ddt ||
+       port_dq_fdt_validate(q->fdt,sizeof(*q->fdt))!=PORT_DQ_FDT_OK)
+        return PORT_DQ_BOOTREAD_BAD;
+    const uint8_t *u=q->device_db+PORT_V37_UCB_BOOT_OFF;
+    if(q->device_info->ucb[0]!=(uint32_t)(uintptr_t)u ||
+       port_v37_read16(u+8u)!=PORT_V37_BOOT_UCB_SIZE ||
+       port_v37_read32(u+36u)!=q->device_info->ddb[0] ||
+       port_v37_read16(u+58u)!=512u ||
+       port_v37_read16(u+72u)!=q->boot_unit ||
+       port_v37_read32(u+120u)!=0u || /* NO disk DDT linked */
+       port_v37_read32(q->irp+PORT_V37_IRP_UCB)!=q->device_info->ucb[0] ||
+       port_v37_read16(q->irp+8u)!=PORT_V37_IRP_SIZE ||
+       q->irp[10u]!=PORT_V37_DYN_IRP ||
+       q->irp[11u]!=0u ||  /* kernel mode */
+       port_v37_read16(q->irp+42u)!=PORT_DQ_PHYSIO ||
+       port_v37_read32(q->irp+36u)!=0u || /* No process IOSB */
+       port_v37_read16(q->irp+40u)!=0u || /* No user channel */
+       port_v37_read32(q->irp+44u)!=0u || /* No user PTEs */
+       port_v37_read16(q->irp+50u)!=PORT_DQ_BOOTREAD_BYTES ||
+       port_v37_read16(q->irp+48u)!=0u ||
+       port_v37_read32(q->irp+PORT_V37_IRP_IOST2)!=0u)
+        return PORT_DQ_BOOTREAD_BAD;
+    return PORT_DQ_BOOTREAD_OK;
+}
