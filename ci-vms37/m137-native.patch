@@ -0,0 +1,21 @@
+#include "vms_dq_index_header.h"
+/* SHRLIB/F11DEF.B32 HM2 layout, as used by FIL$MOUNT. The readonly
+ * home image must be complete and checksummed before any ATA I/O. */
+uint32_t port_dq_index_location(const uint8_t home[512],uint32_t *lbn){
+    if(!home||!lbn)return PORT_DQ_INDEX_BAD;
+    if(home[13u]!=2u || port_dq_index_long(home,0u)!=1u ||
+       !port_dq_index_long(home,8u)||!port_dq_index_word(home,14u)||
+       !port_dq_index_word(home,16u)||!port_dq_index_word(home,18u)||
+       !port_dq_index_word(home,20u)||!port_dq_index_word(home,22u)||
+       !port_dq_index_long(home,28u)||!port_dq_index_word(home,34u)||
+       port_dq_index_long(home,28u)<port_dq_index_word(home,34u)||
+       !port_dq_index_checksum(home,58u)||
+       !port_dq_index_checksum(home,510u))return PORT_DQ_INDEX_HOME;
+    const uint32_t bitmap=port_dq_index_long(home,24u);
+    const uint32_t blocks=port_dq_index_word(home,32u);
+    if(!bitmap||!blocks||bitmap>=UINT32_C(0x10000000)||
+       (uint64_t)bitmap+blocks>UINT32_C(0x0fffffff))
+        return PORT_DQ_INDEX_HOME;
+    *lbn=bitmap+blocks;
+    return PORT_DQ_INDEX_OK;
+}
diff --git a/src/vms_dq_index_read.c b/src/vms_dq_index_read.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_index_read.c
@@ -0,0 +1,27 @@
+#include "vms_dq_index_header.h"
+/* Separate resident bootstrap IRP, genuine disk READPBLK, and structurally
+ * validated INDEXF.SYS first file header; no DDT publication or ACP. */
+uint32_t port_dq_index_read(const struct port_dq_bootread_request *q,
+                           const uint16_t home[256],
+                           struct port_dq_bootread_result *io,
+                           struct port_dq_index_result *result){
+    if(!q||!home||!io||!result||!q->irp)return PORT_DQ_INDEX_BAD;
+    uint32_t lbn=0u;
+    uint32_t rc=port_dq_index_location((const uint8_t *)home,&lbn);
+    if(rc!=PORT_DQ_INDEX_OK)return rc;
+    /* The IRP was independently prepared by privileged INIT. Its media
+     * field must match exactly; do not silently repair caller input. */
+    if(port_v37_read32(q->irp+PORT_V37_IRP_MEDIA)!=lbn)
+        return PORT_DQ_INDEX_BAD;
+    rc=port_dq_bootread_execute_physical(q,io,lbn);
+    if(rc!=PORT_DQ_BOOTREAD_OK)return PORT_DQ_INDEX_IO;
+    struct port_dq_index_result tmp={0};
+    rc=port_dq_index_validate_header(q->sector,&tmp);
+    if(rc!=PORT_DQ_INDEX_OK)return rc;
+    tmp.lbn=lbn;
+    tmp.bitmap_lbn=port_dq_index_long((const uint8_t *)home,24u);
+    tmp.bitmap_blocks=port_dq_index_word((const uint8_t *)home,32u);
+    tmp.io_count=io->ucb_io_count;
+    *result=tmp;
+    return PORT_DQ_INDEX_OK;
+}
diff --git a/src/vms_dq_index_validate.c b/src/vms_dq_index_validate.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_index_validate.c
@@ -0,0 +1,17 @@
+#include "vms_dq_index_header.h"
+/* FILE HEADER INDEXF.SYS;1 must have FH2$W_FID_NUM=1, SEQ=1,
+ * RVN=0 and a correct FH2 checksum. Never infer success from I/O alone. */
+uint32_t port_dq_index_validate_header(const uint16_t words[256],
+                                      struct port_dq_index_result *out){
+    if(!words||!out)return PORT_DQ_INDEX_BAD;
+    const uint8_t *h=(const uint8_t *)words;
+    if(h[7u]!=2u||port_dq_index_word(h,8u)!=1u||
+       port_dq_index_word(h,10u)!=1u||port_dq_index_word(h,12u)!=0u||
+       h[0u]==0u||h[1u]<=h[0u]||h[1u]>=255u||
+       !port_dq_index_checksum(h,510u))return PORT_DQ_INDEX_HEADER;
+    out->header_checksum=port_dq_index_word(h,510u);
+    out->file_number=port_dq_index_word(h,8u);
+    out->file_sequence=port_dq_index_word(h,10u);
+    out->record_bytes=512u;
+    return PORT_DQ_INDEX_OK;
+}
