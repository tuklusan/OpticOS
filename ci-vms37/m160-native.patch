diff --git a/src/vms_f11_cursor_compare.c b/src/vms_f11_cursor_compare.c
--- /dev/null
+++ b/src/vms_f11_cursor_compare.c
@@ -0,0 +1,23 @@
+#include "vms_f11_cursor.h"
+/* M160: compare actual disk bytes to already resident supervisor image.
+ * A disagreement is a fatal pre-activation image validation error. */
+uint32_t port_f11_cursor_compare(struct port_f11_cursor *c,
+    const uint8_t *reference,uint32_t length,uint32_t *matched){
+    if(!c||!reference||!matched)return PORT_F11_CURSOR_BAD;
+    *matched=0u;
+    while(*matched<length){
+        uint8_t b[512];
+        uint32_t n=length-*matched;
+        if(n>sizeof b)n=sizeof b;
+        uint32_t done=0;
+        const uint32_t rc=port_f11_cursor_read(c,b,n,sizeof b,&done);
+        if(rc!=PORT_F11_CURSOR_OK)return rc;
+        for(uint32_t i=0;i<n;i++){
+            if(b[i]!=reference[*matched+i]){
+                *matched+=i;return PORT_F11_CURSOR_DIFFERENT;
+            }
+        }
+        *matched+=n;
+    }
+    return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_init.c b/src/vms_f11_cursor_init.c
--- /dev/null
+++ b/src/vms_f11_cursor_init.c
@@ -0,0 +1,19 @@
+#include "vms_f11_cursor.h"
+/* M153: preflight file allocation and supplied read callback once. */
+uint32_t port_f11_cursor_init(struct port_f11_cursor *c,
+    const struct port_f11_boot_volume *v,const struct port_f11_chain *chain,
+    uint32_t initial){
+    if(!c||!v||!v->read_sector||!chain||!chain->count||
+       chain->count>PORT_F11_CHAIN_MAX_EXTENTS)return PORT_F11_CURSOR_BAD;
+    uint64_t total=0;
+    for(uint32_t i=0;i<chain->count;i++){
+        const struct port_f11_extent *e=&chain->extents[i];
+        if(!e->blocks||!e->lbn||(uint64_t)e->lbn+e->blocks>0x10000000u)
+            return PORT_F11_CURSOR_MAP;
+        total+=(uint64_t)e->blocks*512u;
+        if(total>UINT32_MAX)return PORT_F11_CURSOR_MAP;
+    }
+    if(initial>total)return PORT_F11_CURSOR_EOF;
+    const struct port_f11_cursor tmp={v,chain,initial,(uint32_t)total,0u};
+    *c=tmp;return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_locate.c b/src/vms_f11_cursor_locate.c
--- /dev/null
+++ b/src/vms_f11_cursor_locate.c
@@ -0,0 +1,13 @@
+#include "vms_f11_cursor.h"
+/* M156: GETRTRVPTR extent walk is one-based, and may be fragmented. */
+uint32_t port_f11_cursor_locate(const struct port_f11_cursor *c,
+    uint32_t *lbn,uint32_t *within){
+    if(!c||!c->volume||!c->chain||!lbn||!within)
+        return PORT_F11_CURSOR_BAD;
+    if(c->position>=c->total_bytes)return PORT_F11_CURSOR_EOF;
+    uint32_t at=0;
+    if(port_f11_chain_lbn(c->chain,c->position/512u+1u,&at)!=PORT_F11_CHAIN_OK)
+        return PORT_F11_CURSOR_MAP;
+    *lbn=at;*within=c->position%512u;
+    return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_long.c b/src/vms_f11_cursor_long.c
--- /dev/null
+++ b/src/vms_f11_cursor_long.c
@@ -0,0 +1,11 @@
+#include "vms_f11_cursor.h"
+/* M159: little-endian Files-11 FH2 longword across VBN boundaries. */
+uint32_t port_f11_cursor_long(struct port_f11_cursor *c,uint32_t *value){
+    if(!value)return PORT_F11_CURSOR_BAD;
+    uint8_t b[4];uint32_t done=0;
+    const uint32_t rc=port_f11_cursor_read(c,b,4u,sizeof b,&done);
+    if(rc!=PORT_F11_CURSOR_OK)return rc;
+    *value=(uint32_t)b[0]|((uint32_t)b[1]<<8)|
+           ((uint32_t)b[2]<<16)|((uint32_t)b[3]<<24);
+    return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_read.c b/src/vms_f11_cursor_read.c
--- /dev/null
+++ b/src/vms_f11_cursor_read.c
@@ -0,0 +1,25 @@
+#include "vms_f11_cursor.h"
+/* M157: original FIL$RDWRTLBN read path; callbacks are real ATA IRPs in
+ * resident SYS.EXE. Expose partial byte count on physical failure. */
+uint32_t port_f11_cursor_read(struct port_f11_cursor *c,uint8_t *dst,
+    uint32_t length,size_t capacity,uint32_t *completed){
+    if(!c||!c->volume||!c->chain||!c->volume->read_sector||
+       !dst||!completed||length>capacity||c->position>c->total_bytes)
+        return PORT_F11_CURSOR_BAD;
+    if(length>c->total_bytes-c->position)return PORT_F11_CURSOR_EOF;
+    *completed=0u;
+    while(*completed<length){
+        uint32_t lbn=0u,within=0u;
+        const uint32_t rc=port_f11_cursor_locate(c,&lbn,&within);
+        if(rc!=PORT_F11_CURSOR_OK)return rc;
+        uint8_t sector[512];
+        if(c->volume->read_sector(c->volume->context,lbn,sector)!=PORT_DQ_DIR_OK)
+            return PORT_F11_CURSOR_IO;
+        c->reads++;
+        uint32_t take=length-*completed;
+        if(take>512u-within)take=512u-within;
+        for(uint32_t i=0;i<take;i++)dst[*completed+i]=sector[within+i];
+        c->position+=take;*completed+=take;
+    }
+    return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_seek.c b/src/vms_f11_cursor_seek.c
--- /dev/null
+++ b/src/vms_f11_cursor_seek.c
@@ -0,0 +1,7 @@
+#include "vms_f11_cursor.h"
+/* M154: source FIL$READVBN one-origin VBN seeks; EOF position is valid. */
+uint32_t port_f11_cursor_seek(struct port_f11_cursor *c,uint32_t off){
+    if(!c||!c->volume||!c->chain)return PORT_F11_CURSOR_BAD;
+    if(off>c->total_bytes)return PORT_F11_CURSOR_EOF;
+    c->position=off;return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_skip.c b/src/vms_f11_cursor_skip.c
--- /dev/null
+++ b/src/vms_f11_cursor_skip.c
@@ -0,0 +1,8 @@
+#include "vms_f11_cursor.h"
+/* M155: reject offset wrap without modifying the current VBN cursor. */
+uint32_t port_f11_cursor_skip(struct port_f11_cursor *c,uint32_t bytes){
+    if(!c||!c->volume||!c->chain)return PORT_F11_CURSOR_BAD;
+    if(c->position>c->total_bytes||bytes>c->total_bytes-c->position)
+        return PORT_F11_CURSOR_EOF;
+    c->position+=bytes;return PORT_F11_CURSOR_OK;
+}
diff --git a/src/vms_f11_cursor_word.c b/src/vms_f11_cursor_word.c
--- /dev/null
+++ b/src/vms_f11_cursor_word.c
@@ -0,0 +1,10 @@
+#include "vms_f11_cursor.h"
+/* M158: FIL$READVBN byte-order-safe two-byte field; no half value returned. */
+uint32_t port_f11_cursor_word(struct port_f11_cursor *c,uint16_t *value){
+    if(!value)return PORT_F11_CURSOR_BAD;
+    uint8_t b[2];uint32_t done=0;
+    const uint32_t rc=port_f11_cursor_read(c,b,2u,sizeof b,&done);
+    if(rc!=PORT_F11_CURSOR_OK)return rc;
+    *value=(uint16_t)((uint16_t)b[0]|((uint16_t)b[1]<<8));
+    return PORT_F11_CURSOR_OK;
+}
