+uint32_t port_v37_iopost_service(struct port_v37_iopost_queue *,
+    uint32_t,uint32_t,uint32_t,struct port_v37_iopost_endlog *);
+uint32_t port_v37_iopost_drain(struct port_v37_iopost_queue *,
