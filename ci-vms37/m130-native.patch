+ * adapter does not implement VAX DQ_STARTIO register ABI; all DDT actions
+ * (other than exact masks) remain unbound. Never expose as IOC live driver. */
+enum {PORT_DQDDT_OK=1u,PORT_DQDDT_BAD=2u,PORT_DQDDT_UNBOUND=4u,
+      PORT_DQDDT_HEADER_BYTES=40u,PORT_DQDDT_DDT_BYTES=38u,
+      PORT_DQDDT_FDT_BYTES=136u,PORT_DQDDT_IMAGE_BYTES=176u,
+      PORT_DQDDT_SOURCE_DIAG_BYTES=84u,
+      PORT_DQDDT_ACTIONS=10u};
+struct port_dqddt_prologue {
+    uint16_t max_units,default_units,buffer_bytes;
+    uint8_t fork_ipl,device_ipl,retry_max,svp_required;
+};
+struct port_dqddt_stage {
+    struct port_dqddt_prologue dpt;
+    uint8_t image[PORT_DQDDT_IMAGE_BYTES] __attribute__((aligned(4)));
+    uint32_t table_base,native_start_pc,ioc_return_pc;
+    uint8_t ready,driver_bound,reserved[2];
+};
+uint32_t port_dqddt_preflight(const struct port_dqddt_stage *,
+    const struct port_dq_fdt *,uint32_t,uint32_t,uint32_t);
+uint32_t port_dqddt_fill_header(uint8_t *,size_t,uint32_t,uint32_t,uint32_t);
+uint32_t port_dqddt_fill_fdt(uint8_t *,size_t,const struct port_dq_fdt *);
+uint32_t port_dqddt_stage_init(struct port_dqddt_stage *,
+    const struct port_dq_fdt *,uint32_t,uint32_t,uint32_t);
+uint32_t port_dqddt_validate(const struct port_dqddt_stage *,
+    const struct port_dq_fdt *);
+uint32_t port_dqddt_function(const struct port_dqddt_stage *,
+    const struct port_dq_fdt *,uint16_t);
+uint32_t port_dqddt_entry_offset(unsigned);
+uint32_t port_dqddt_fdt_check(const struct port_dqddt_stage *,
+    const struct port_dq_fdt *);
+#endif
diff --git a/src/vms_dqddt_entry_offset.c b/src/vms_dqddt_entry_offset.c
new file mode 100644
index 0000000..75341ee
--- /dev/null
+++ b/src/vms_dqddt_entry_offset.c
@@ -0,0 +1,8 @@
+#include "vms_dqddt.h"
+/* FUNCTAB emits two 32-bit mask words per row; the ten nonempty ACTION
+ * entries additionally reserve one GENRADDR longword. */
+uint32_t port_dqddt_entry_offset(unsigned row){
+    if(row>=PORT_DQ_FDT_ROWS)return UINT32_MAX;
+    if(row<2u)return PORT_DQDDT_HEADER_BYTES+8u*row;
+    return PORT_DQDDT_HEADER_BYTES+16u+12u*(row-2u);
+}
diff --git a/src/vms_dqddt_fdt_check.c b/src/vms_dqddt_fdt_check.c
new file mode 100644
index 0000000..477eae3
--- /dev/null
+++ b/src/vms_dqddt_fdt_check.c
@@ -0,0 +1,23 @@
+#include "vms_dqddt.h"
+#include "vms_ini_devicedb.h"
+/* All original masks and all ten absent GENRADDR handler slots must be
+ * checked, not merely legal/read/write mask samples. */
+uint32_t port_dqddt_fdt_check(const struct port_dqddt_stage *s,
+    const struct port_dq_fdt *fdt){
+    if(!s||port_dq_fdt_validate(fdt,sizeof(*fdt))!=PORT_DQ_FDT_OK)
+        return PORT_DQDDT_BAD;
+    for(unsigned i=0;i<PORT_DQ_FDT_ROWS;i++){
+        const uint32_t off=port_dqddt_entry_offset(i);
+        if(off<PORT_DQDDT_HEADER_BYTES||off>PORT_DQDDT_IMAGE_BYTES-8u||
+           port_v37_read32(s->image+off)!=(uint32_t)fdt->mask[i]||
+           port_v37_read32(s->image+off+4u)!=(uint32_t)(fdt->mask[i]>>32u))
+            return PORT_DQDDT_BAD;
+        if(i>=2u&&port_v37_read32(s->image+off+8u)!=0u)
+            return PORT_DQDDT_BAD;
+    }
+    if(port_dqddt_entry_offset(PORT_DQ_FDT_ROWS-1u)+12u!=
+       PORT_DQDDT_IMAGE_BYTES||
+       port_dqddt_entry_offset(PORT_DQ_FDT_ROWS)!=UINT32_MAX)
+        return PORT_DQDDT_BAD;
+    return PORT_DQDDT_OK;
+}
diff --git a/src/vms_dqddt_fill_fdt.c b/src/vms_dqddt_fill_fdt.c
new file mode 100644
index 0000000..02cb71b
--- /dev/null
+++ b/src/vms_dqddt_fill_fdt.c
@@ -0,0 +1,25 @@
+#include "vms_dqddt.h"
+#include "vms_ini_devicedb.h"
+/* Original FUNCTAB macro from SHRLIB/SYSMAR.MAR: two little-endian mask
+ * words, optional GENRADDR ACTION slot. Native action slots are zero,
+ * never the address of a fake ACP, so table is not executable yet. */
+uint32_t port_dqddt_fill_fdt(uint8_t *out,size_t n,
+    const struct port_dq_fdt *fdt){
+    if(!out||n<PORT_DQDDT_IMAGE_BYTES||
+       port_dq_fdt_validate(fdt,sizeof(*fdt))!=PORT_DQ_FDT_OK)
+        return PORT_DQDDT_BAD;
+    for(unsigned i=PORT_DQDDT_HEADER_BYTES;i<PORT_DQDDT_IMAGE_BYTES;i++)out[i]=0u;
+    for(unsigned row=0;row<PORT_DQ_FDT_ROWS;row++){
+        const uint64_t mask=fdt->mask[row];
+        const uint32_t at=port_dqddt_entry_offset(row);
+        if(at==UINT32_MAX||at>PORT_DQDDT_IMAGE_BYTES-8u)
+            return PORT_DQDDT_BAD;
+        port_v37_write32(out+at,(uint32_t)mask);
+        port_v37_write32(out+at+4u,(uint32_t)(mask>>32u));
+        if(row>=2u){
+            if(at>PORT_DQDDT_IMAGE_BYTES-12u)return PORT_DQDDT_BAD;
+            port_v37_write32(out+at+8u,0u);
+        }
+    }
+    return PORT_DQDDT_OK;
+}
diff --git a/src/vms_dqddt_fill_header.c b/src/vms_dqddt_fill_header.c
new file mode 100644
index 0000000..f0dc1ee
--- /dev/null
+++ b/src/vms_dqddt_fill_header.c
@@ -0,0 +1,25 @@
+#include "vms_dqddt.h"
+#include "vms_ini_devicedb.h"
+/* DDTAB GENRADDR: START address is relative to DDT, zero function
+ * defaults expand to absolute IOC$RETURN. DQ_REGDUMP, IOC$MNTVER and
+ * error logger offsets remain zero because no valid native handler. */
+uint32_t port_dqddt_fill_header(uint8_t *out,size_t n,uint32_t base,
+    uint32_t native_start,uint32_t ioc_return){
+    if(!out||n<PORT_DQDDT_HEADER_BYTES||!base||(base&3u)||
+       base>UINT32_MAX-PORT_DQDDT_IMAGE_BYTES||
+       !native_start||!ioc_return)return PORT_DQDDT_BAD;
+    for(unsigned i=0;i<PORT_DQDDT_HEADER_BYTES;i++)out[i]=0u;
+    port_v37_write32(out+0u,native_start-base);
+    port_v37_write32(out+4u,ioc_return);
+    port_v37_write32(out+8u,PORT_DQDDT_HEADER_BYTES);
+    port_v37_write32(out+12u,ioc_return);
+    /* Original DQ_REGDUMP unavailable: leave zero and fail closed. */
+    port_v37_write16(out+20u,PORT_DQDDT_SOURCE_DIAG_BYTES);
+    /* Original device error logger buffer needs EMB source layout. */
+    port_v37_write16(out+22u,0u);
+    port_v37_write32(out+24u,ioc_return);
+    port_v37_write32(out+28u,ioc_return);
+    port_v37_write32(out+32u,0u); /* IOC$MNTVER unresolved */
+    port_v37_write16(out+36u,PORT_DQDDT_FDT_BYTES);
+    return PORT_DQDDT_OK;
+}
diff --git a/src/vms_dqddt_function.c b/src/vms_dqddt_function.c
new file mode 100644
index 0000000..8c7fd7b
--- /dev/null
+++ b/src/vms_dqddt_function.c
@@ -0,0 +1,10 @@
+#include "vms_dqddt.h"
+/* A source legal function mask is not an executable DDT/ACP action.
+ * Reject all $QIO uses until corresponding native register ABI exists. */
+uint32_t port_dqddt_function(const struct port_dqddt_stage *s,
+    const struct port_dq_fdt *fdt,uint16_t f){
+    if(port_dqddt_validate(s,fdt)!=PORT_DQDDT_OK)return PORT_DQDDT_BAD;
+    const uint32_t k=port_dq_fdt_dispatch(fdt,sizeof(*fdt),f);
+    if(k==PORT_DQ_FDT_ILLEGAL)return PORT_DQDDT_BAD;
+    return PORT_DQDDT_UNBOUND;
+}
diff --git a/src/vms_dqddt_preflight.c b/src/vms_dqddt_preflight.c
new file mode 100644
index 0000000..85f9102
--- /dev/null
+++ b/src/vms_dqddt_preflight.c
@@ -0,0 +1,15 @@
+#include "vms_dqddt.h"
+/* No DDT publication or interrupt-owned CRB before source DQ STARTIO and
+ * ACP handlers exist. Stage must live at a distinct aligned PC address. */
+uint32_t port_dqddt_preflight(const struct port_dqddt_stage *s,
+    const struct port_dq_fdt *fdt,uint32_t base,uint32_t start,uint32_t ret){
+    if(!s||!base||(base&3u)||!start||!ret||
+       base>UINT32_MAX-PORT_DQDDT_IMAGE_BYTES||
+       !((uint64_t)start<(uint64_t)base ||
+         (uint64_t)start>=(uint64_t)base+PORT_DQDDT_IMAGE_BYTES)||
+       !((uint64_t)ret<(uint64_t)base ||
+         (uint64_t)ret>=(uint64_t)base+PORT_DQDDT_IMAGE_BYTES)||
+       port_dq_fdt_validate(fdt,sizeof(*fdt))!=PORT_DQ_FDT_OK)
+        return PORT_DQDDT_BAD;
+    return PORT_DQDDT_OK;
+}
diff --git a/src/vms_dqddt_stage_init.c b/src/vms_dqddt_stage_init.c
new file mode 100644
index 0000000..262ccf3
--- /dev/null
+++ b/src/vms_dqddt_stage_init.c
@@ -0,0 +1,20 @@
+#include "vms_dqddt.h"
+/* DPTAB defaults come straight from DQDRIVER.MAR 392-436; the
+ * additional original UCB/SVP/error paths are still unresolved. */
+uint32_t port_dqddt_stage_init(struct port_dqddt_stage *s,
+    const struct port_dq_fdt *fdt,uint32_t base,uint32_t start,uint32_t ret){
+    if(port_dqddt_preflight(s,fdt,base,start,ret)!=PORT_DQDDT_OK)
+        return PORT_DQDDT_BAD;
+    struct port_dqddt_stage tmp={0};
+    tmp.dpt.max_units=4u;tmp.dpt.default_units=4u;
+    tmp.dpt.buffer_bytes=512u;tmp.dpt.fork_ipl=8u;
+    tmp.dpt.device_ipl=21u;tmp.dpt.retry_max=8u;
+    tmp.dpt.svp_required=1u;
+    if(port_dqddt_fill_header(tmp.image,sizeof tmp.image,base,start,ret)!=PORT_DQDDT_OK||
+       port_dqddt_fill_fdt(tmp.image,sizeof tmp.image,fdt)!=PORT_DQDDT_OK)
+        return PORT_DQDDT_BAD;
+    tmp.table_base=base;tmp.native_start_pc=start;tmp.ioc_return_pc=ret;
+    tmp.ready=1u;tmp.driver_bound=0u;
+    *s=tmp;
+    return PORT_DQDDT_OK;
+}
diff --git a/src/vms_dqddt_validate.c b/src/vms_dqddt_validate.c
new file mode 100644
index 0000000..c940a25
--- /dev/null
+++ b/src/vms_dqddt_validate.c
@@ -0,0 +1,29 @@
+#include "vms_dqddt.h"
+#include "vms_ini_devicedb.h"
+/* Only a complete source-sized DDT staging proof, NOT a usable DQ driver. */
+uint32_t port_dqddt_validate(const struct port_dqddt_stage *s,
+    const struct port_dq_fdt *fdt){
+    if(!s||!s->ready||s->driver_bound||s->reserved[0]||s->reserved[1]||
+       port_dqddt_preflight(s,fdt,s->table_base,
+          s->native_start_pc,s->ioc_return_pc)!=PORT_DQDDT_OK||
+       s->dpt.max_units!=4u||s->dpt.default_units!=4u||
+       s->dpt.buffer_bytes!=512u||s->dpt.fork_ipl!=8u||
+       s->dpt.device_ipl!=21u||s->dpt.retry_max!=8u||
+       s->dpt.svp_required!=1u)return PORT_DQDDT_BAD;
+    const uint8_t *b=s->image;
+    if(port_v37_read32(b)!=(s->native_start_pc-s->table_base)||
+       port_v37_read32(b+4u)!=s->ioc_return_pc||
+       port_v37_read32(b+8u)!=PORT_DQDDT_HEADER_BYTES||
+       port_v37_read32(b+12u)!=s->ioc_return_pc||
+       port_v37_read32(b+16u)!=0u||
+       port_v37_read16(b+20u)!=PORT_DQDDT_SOURCE_DIAG_BYTES||
+       port_v37_read16(b+22u)!=0u||
+       port_v37_read32(b+24u)!=s->ioc_return_pc||
+       port_v37_read32(b+28u)!=s->ioc_return_pc||
+       port_v37_read32(b+32u)!=0u||
+       port_v37_read16(b+36u)!=PORT_DQDDT_FDT_BYTES||
+       b[38u]!=0u||b[39u]!=0u||
+       port_dqddt_fdt_check(s,fdt)!=PORT_DQDDT_OK)
+        return PORT_DQDDT_BAD;
+    return PORT_DQDDT_OK;
+}
diff --git a/tests/test_dqddt_host.c b/tests/test_dqddt_host.c
new file mode 100644
index 0000000..5206495
--- /dev/null
+++ b/tests/test_dqddt_host.c
@@ -0,0 +1,59 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_dqddt.h"
+#include "vms_ini_devicedb.h"
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"DQ DDT failed line %u: %s\n",(unsigned)__LINE__,#x);return 1;}}while(0)
+int main(void){
+    enum {BASE=0x00370000u,START=0x00324120u,RET=0x00324104u};
+    struct port_dq_fdt fdt={0};
+    CHECK(port_dq_fdt_build(&fdt,sizeof fdt)==PORT_DQ_FDT_OK);
+    struct port_dqddt_stage d={0};
+    CHECK(port_dqddt_stage_init(&d,&fdt,BASE,START,RET)==PORT_DQDDT_OK);
+    CHECK(d.table_base==BASE&&d.native_start_pc==START&&d.ioc_return_pc==RET);
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_OK);
+    CHECK(port_v37_read32(d.image)==(uint32_t)(START-BASE));
+    CHECK(port_v37_read32(d.image+4u)==RET);
+    CHECK(port_v37_read32(d.image+8u)==PORT_DQDDT_HEADER_BYTES);
+    CHECK(port_v37_read16(d.image+20u)==84u);
+    CHECK(port_v37_read16(d.image+36u)==136u);
+    CHECK(port_dqddt_entry_offset(0u)==40u&&port_dqddt_entry_offset(1u)==48u);
+    CHECK(port_dqddt_entry_offset(2u)==56u&&port_dqddt_entry_offset(11u)==164u);
+    CHECK(port_dqddt_entry_offset(12u)==UINT32_MAX);
+    CHECK(port_v37_read32(d.image+port_dqddt_entry_offset(2u))==(uint32_t)fdt.mask[2u]);
+    CHECK(port_v37_read32(d.image+port_dqddt_entry_offset(2u)+4u)==(uint32_t)(fdt.mask[2u]>>32u));
+    CHECK(port_dqddt_function(&d,&fdt,PORT_DQ_READPBLK)==PORT_DQDDT_UNBOUND);
+    CHECK(port_dqddt_function(&d,&fdt,PORT_DQ_WRITELBLK)==PORT_DQDDT_UNBOUND);
+    CHECK(port_dqddt_function(&d,&fdt,PORT_DQ_READVBLK)==PORT_DQDDT_UNBOUND);
+    CHECK(port_dqddt_function(&d,&fdt,63u)==PORT_DQDDT_BAD);
+    CHECK(port_dqddt_function(&d,&fdt,UINT16_MAX)==PORT_DQDDT_BAD);
+    for(unsigned i=0;i<PORT_DQ_FDT_ROWS;i++){
+        uint32_t pos=port_dqddt_entry_offset(i);
+        uint8_t old=d.image[pos];d.image[pos]^=1u;
+        CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_BAD);
+        d.image[pos]=old;
+        if(i>=2u){old=d.image[pos+8u];d.image[pos+8u]=1u;
+            CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_BAD);
+            d.image[pos+8u]=old;}
+    }
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_OK);
+    d.image[20u]=0u;
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_BAD);
+    d.image[20u]=PORT_DQDDT_SOURCE_DIAG_BYTES;
+    d.image[32u]=1u;
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_BAD);
+    d.image[32u]=0u;
+    d.driver_bound=1u;
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_BAD);
+    d.driver_bound=0u;
+    CHECK(port_dqddt_validate(&d,&fdt)==PORT_DQDDT_OK);
+    struct port_dqddt_stage before=d;
+    CHECK(port_dqddt_stage_init(&d,&fdt,BASE+1u,START,RET)==PORT_DQDDT_BAD);
+    CHECK(!memcmp(&before,&d,sizeof d));
+    CHECK(port_dqddt_stage_init(&d,&fdt,BASE,BASE+4u,RET)==PORT_DQDDT_BAD);
+    CHECK(!memcmp(&before,&d,sizeof d));
+    CHECK(port_dqddt_stage_init(&d,&fdt,BASE,START,BASE+8u)==PORT_DQDDT_BAD);
+    CHECK(!memcmp(&before,&d,sizeof d));
+    puts("DQDRIVER.MAR source DPTAB/DDTAB and 136-byte FUNCTAB stage, all ten actions unbound PASS");
+    return 0;
+}
