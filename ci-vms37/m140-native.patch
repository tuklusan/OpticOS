+    FILE *f=fopen("portdisk.img","rb");CHECK(f);
+    uint8_t home[512],index[512],sysfile[512],elf[512];
+    CHECK(at(f,1u,home));
+    uint32_t index_lbn=0u;
+    CHECK(port_dq_index_location(home,&index_lbn)==PORT_DQ_INDEX_OK);
+    CHECK(at(f,index_lbn,index));
