--- /dev/null
+++ b/src/vms_ini_dptlist.h
@@ -0,0 +1,26 @@
+#ifndef VMS_INI_DPTLIST_H
+#define VMS_INI_DPTLIST_H
+#include <stddef.h>
+#include <stdint.h>
+/* Original SYS/SRC/INIT.MAR 1232-1239, and DEVICEDAT.MAR 192-196:
+ * IOC$GL_DPTLIST is a circular doubly-linked 8-byte queue sentinel.
+ * INSQUE MB$DPT, then NL$DPT, then OP$DPT at its head; the resulting
+ * forward order is OP -> NL -> MB. These are *addresses of actual linked
+ * DPT records*, not replacement driver implementations or fake dispatch.
+ *
+ * Guest addresses are 32-bit. The flat memory window provides a safe
+ * way for host tests to check original VAX INSQUE pointer bytes. Callers
+ * must supply real prologue records before integrating into SYS.EXE. */
+enum {PORT_INI_DPT_OK=1u,PORT_INI_DPT_BADPARAM=2u,
+      PORT_INI_DPT_NOTEMPTY=4u};
+struct port_ini_dpt_result {
+    uint32_t head_address;
+    uint32_t first_driver;
+    uint32_t last_driver;
+    uint32_t driver_count;
+};
+uint32_t port_ini_dpt_attach_three(uint8_t *memory,size_t capacity,
+    uint32_t guest_memory_base,uint32_t sentinel_address,
+    uint32_t mb_driver_address,uint32_t nl_driver_address,
+    uint32_t op_driver_address,struct port_ini_dpt_result *out);
+#endif
--- /dev/null
+++ b/src/vms_ini_dptlist.c
@@ -0,0 +1,64 @@
+#include "vms_ini_dptlist.h"
+/* No CPU emulation: 386 absolute 32-bit pointers and source-defined
+ * VAX queue topology implemented as direct IA-32 memory writes. */
+static uint32_t rd(const uint8_t *p){
+    return (uint32_t)p[0]|((uint32_t)p[1]<<8)|
+           ((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);
+}
+static void wr(uint8_t *p,uint32_t x){
+    p[0]=(uint8_t)x;p[1]=(uint8_t)(x>>8);
+    p[2]=(uint8_t)(x>>16);p[3]=(uint8_t)(x>>24);
+}
+static int contained(uint32_t base,size_t cap,uint32_t address){
+    return address>=base &&
+           (uint64_t)address-(uint64_t)base+8u<=cap &&
+           !(address&3u);
+}
+static uint8_t *node(uint8_t *memory,uint32_t base,uint32_t address){
+    return memory+(address-base);
+}
+uint32_t port_ini_dpt_attach_three(uint8_t *memory,size_t capacity,
+    uint32_t guest_memory_base,uint32_t sentinel_address,
+    uint32_t mb_driver_address,uint32_t nl_driver_address,
+    uint32_t op_driver_address,struct port_ini_dpt_result *out){
+    if(!memory||!out || capacity<32u || capacity>UINT32_MAX ||
+       !guest_memory_base || (guest_memory_base&3u) ||
+       (uintptr_t)memory&3u ||
+       (uint64_t)guest_memory_base+capacity>UINT64_C(0x100000000))
+        return PORT_INI_DPT_BADPARAM;
+    const uint32_t addresses[4]={sentinel_address,mb_driver_address,
+                                  nl_driver_address,op_driver_address};
+    for(unsigned i=0;i<4;i++){
+        if(!contained(guest_memory_base,capacity,addresses[i]))
+            return PORT_INI_DPT_BADPARAM;
+        for(unsigned j=0;j<i;j++){
+            uint32_t d=addresses[i]>addresses[j]?
+                       addresses[i]-addresses[j]:addresses[j]-addresses[i];
+            if(d<8u)return PORT_INI_DPT_BADPARAM;
+        }
+    }
+    uint8_t *head=node(memory,guest_memory_base,sentinel_address);
+    if(rd(head)!=sentinel_address || rd(head+4u)!=sentinel_address)
+        return PORT_INI_DPT_NOTEMPTY;
+    for(unsigned i=1;i<4;i++){
+        uint8_t *p=node(memory,guest_memory_base,addresses[i]);
+        if(rd(p)||rd(p+4u))return PORT_INI_DPT_NOTEMPTY;
+    }
+    /* INSQUE <entry>,IOC$GL_DPTLIST, three times. All pointers are
+     * checked before writes, so an invalid caller leaves bytes intact. */
+    uint32_t next=sentinel_address;
+    for(unsigned i=1;i<4;i++){
+        uint8_t *p=node(memory,guest_memory_base,addresses[i]);
+        wr(p,next);wr(p+4u,sentinel_address);
+        if(next==sentinel_address){
+            wr(head+4u,addresses[i]);
+        }else{
+            wr(node(memory,guest_memory_base,next)+4u,addresses[i]);
+        }
+        wr(head,addresses[i]);
+        next=addresses[i];
+    }
+    *out=(struct port_ini_dpt_result){sentinel_address,op_driver_address,
+             mb_driver_address,3u};
+    return PORT_INI_DPT_OK;
+}
--- /dev/null
+++ b/tests/test_ini_dptlist_host.c
@@ -0,0 +1,57 @@
+#include "vms_ini_dptlist.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FAIL %s:%d %s\n",__FILE__,__LINE__,#x);return 1;}}while(0)
+static uint32_t r32(const uint8_t *p){
+    return (uint32_t)p[0]|(uint32_t)p[1]<<8|
+           (uint32_t)p[2]<<16|(uint32_t)p[3]<<24;
+}
+static void w32(uint8_t *p,uint32_t x){
+    for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(x>>(8u*i));
+}
+int main(void){
+    uint8_t buffer[160] __attribute__((aligned(8)));
+    memset(buffer,0xa5,sizeof buffer);
+    /* Four independent original queue header blocks in 32-bit guest RAM. */
+    const uint32_t base=0x320000u,head=base+16u,
+                   mb=base+40u,nl=base+72u,op=base+104u;
+    memset(buffer+16,0,8);memset(buffer+40,0,8);
+    memset(buffer+72,0,8);memset(buffer+104,0,8);
+    w32(buffer+16,head);w32(buffer+20,head);
+    uint8_t before[160];memcpy(before,buffer,sizeof before);
+    struct port_ini_dpt_result out={0};
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,op,&out)==PORT_INI_DPT_OK);
+    CHECK(out.driver_count==3u&&out.head_address==head);
+    CHECK(out.first_driver==op&&out.last_driver==mb);
+    /* VAX INSQUE inserts after the head, so OP, NL, MB, head. */
+    CHECK(r32(buffer+16)==op&&r32(buffer+20)==mb);
+    CHECK(r32(buffer+104)==nl&&r32(buffer+108)==head);
+    CHECK(r32(buffer+72)==mb&&r32(buffer+76)==op);
+    CHECK(r32(buffer+40)==head&&r32(buffer+44)==nl);
+    CHECK(buffer[15]==0xa5&&buffer[24]==0xa5&&buffer[39]==0xa5);
+    CHECK(buffer[48]==0xa5&&buffer[80]==0xa5&&buffer[112]==0xa5);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,op,&out)==PORT_INI_DPT_NOTEMPTY);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,op,0)==PORT_INI_DPT_BADPARAM);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,mb,&out)==PORT_INI_DPT_BADPARAM);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,base+158u,&out)==PORT_INI_DPT_BADPARAM);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,head+4u,&out)==PORT_INI_DPT_BADPARAM);
+    /* Fail-closed before memory mutation, even if the first two entries
+     * are structurally valid but the final entry is not. */
+    memcpy(buffer,before,sizeof buffer);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,base+158u,&out)==PORT_INI_DPT_BADPARAM);
+    CHECK(!memcmp(buffer,before,sizeof buffer));
+    w32(buffer+40,0x1234u);
+    CHECK(port_ini_dpt_attach_three(buffer,sizeof buffer,base,head,
+          mb,nl,op,&out)==PORT_INI_DPT_NOTEMPTY);
+    CHECK(r32(buffer+16)==head&&r32(buffer+20)==head);
+    puts("INIT.MAR/DEVICEDAT.MAR source-ordered MB NL OP DPT INSQUE layout PASS");
+    return 0;
+}
