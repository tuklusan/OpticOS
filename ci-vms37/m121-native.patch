+    port_v37_write16(irp+8u,(uint16_t)bytes);
+    irp[10u]=PORT_V37_DYN_IRP;
+    port_v37_write32(irp+PORT_V37_IRP_UCB,ucb);
+    port_v37_write16(irp+PORT_V37_IRP_FUNC,func);
+    return PORT_V37_QIO_OK;
+}
