+#ifndef VMS37_QIO_POST_H
+#define VMS37_QIO_POST_H
+#include <stdint.h>
+#include <stddef.h>
+#include "vms_ini_devicedb.h"
+#include "vms_sys85.h"
+/* SHRLIB/SYSDEF.MDL IRP and UCB, SYS/SRC/SYSQIOREQ.MAR 735-749.
+ * The original 32-bit IRP has status longwords at +56 and +60. The
+ * IOC$GL_PSFL/PSBL doubly-linked queue follows VAX INSQUE semantics.
+ * This is *not* a public $QIO service or an I/O postprocess AST. */
+enum { PORT_V37_IRP_SIZE=64u, PORT_V37_IRP_FUNC=32u,
+       PORT_V37_IRP_UCB=28u, PORT_V37_IRP_MEDIA=56u,
+       PORT_V37_IRP_IOST2=60u, PORT_V37_UCB_OPCNT=96u,
+       PORT_V37_IOPOST_IPL=4u, PORT_V37_QIO_OK=1u,
+       PORT_V37_QIO_BAD=2u, PORT_V37_QIO_FULL=4u,
+       PORT_V37_QIO_DUP=6u, PORT_V37_QIO_CORRUPT=8u };
+struct port_v37_iopost_queue {
+    uint32_t first,last; /* same shape as IOC$GL_PSFL/IOC$GL_PSBL */
+    uint32_t sentinel,first_irp,packet_stride,packet_capacity,queued;
+    uint8_t *bytes;
+};
+struct port_v37_qio_request {
+    struct port_v37_iopost_queue *post;
+    uint8_t *irp,*ucb;
+    uint32_t irp_va,ucb_va,nl_ddb_va;
+    size_t irp_size,ucb_size;
+    void (*softint)(void *,uint8_t);
+    void *softint_arg;
+};
+uint32_t port_v37_post_init(struct port_v37_iopost_queue *,
+    uint8_t *,size_t,uint32_t,uint32_t,uint32_t);
+uint32_t port_v37_post_validate(const struct port_v37_iopost_queue *);
+uint32_t port_v37_post_append(struct port_v37_iopost_queue *,uint32_t);
+uint32_t port_v37_irp_prepare(uint8_t *,size_t,uint32_t,uint32_t,uint16_t);
+uint32_t port_v37_qio_finishio(struct port_v37_qio_request *,uint32_t,uint32_t);
+uint32_t port_v37_qio_finishioc(void *,uint32_t);
+uint32_t port_v37_nl_fdt_post(struct port_v37_qio_request *);
+#endif
--- /dev/null
+++ b/src/vms_qio_post_append.c
@@ -0,0 +1,24 @@
+#include "vms_qio_post.h"
+/* INSQUE IRP,@IOC$GL_PSBL appends after current tail. A corrupted
+ * queue never receives an extra link and a packet cannot be posted twice. */
+uint32_t port_v37_post_append(struct port_v37_iopost_queue *q,uint32_t address){
+    uint32_t valid=port_v37_post_validate(q);
+    if(valid!=PORT_V37_QIO_OK)return valid;
+    if(address<q->first_irp || (address-q->first_irp)%q->packet_stride ||
+       (address-q->first_irp)/q->packet_stride>=q->packet_capacity)
+        return PORT_V37_QIO_BAD;
+    if(q->queued==q->packet_capacity)return PORT_V37_QIO_FULL;
+    for(uint32_t i=0,cursor=q->first;i<q->queued;i++){
+        if(cursor==address)return PORT_V37_QIO_DUP;
+        cursor=port_v37_read32(q->bytes+(cursor-q->first_irp));
+    }
+    uint8_t *packet=q->bytes+(address-q->first_irp);
+    port_v37_write32(packet,q->sentinel);
+    port_v37_write32(packet+4u,q->last);
+    if(q->queued){
+        uint8_t *tail=q->bytes+(q->last-q->first_irp);
+        port_v37_write32(tail,address);
+    }else q->first=address;
+    q->last=address;++q->queued;
+    return PORT_V37_QIO_OK;
+}
