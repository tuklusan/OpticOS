+    uint8_t *db=(uint8_t*)dbwords;
+    struct port_v37_device_result d={0};
+    REQUIRE(port_v37_devices_prelink(db,sizeof dbwords,DB,&d)==PORT_V37_DEV_OK);
+    REQUIRE(d.incomplete_driver_mask==15u&&d.bound_nl_ddt==0);
