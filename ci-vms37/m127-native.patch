diff --git a/src/vms_ini_fin_check.c b/src/vms_ini_fin_check.c
new file mode 100644
index 0000000..ef19ae0
--- /dev/null
+++ b/src/vms_ini_fin_check.c
@@ -0,0 +1,31 @@
+#include "vms_ini_fin_database.h"
+/* Check independently after staging, including exact counted lengths,
+ * pointer graph, no accidental activation of the DQ DDT and both names. */
+uint32_t port_ini_fin_check(const struct port_ini_fin_settings *q,
+    const struct port_ini_fin_result *r){
+    if(!q||!r||!q->device_info||!q->disk_log||!q->sysdevice_log||
+       !q->device_bytes||q->device_info->boot_name_ready!=1u||
+       q->device_info->incomplete_driver_mask!=7u||
+       !r->records_staged||r->concealed!=q->concealed ||
+       r->boot_unit!=q->unit||r->boot_ddb!=q->device_info->ddb[0]||
+       r->boot_ucb!=q->device_info->ucb[0]||
+       port_v37_devices_check(q->device_bytes,q->device_size,q->device_base,
+           q->device_info)!=PORT_V37_DEV_OK ||
+       port_v37_read32(q->device_bytes+12u)!=0u ||
+       port_v37_read32(q->device_bytes+PORT_V37_UCB_BOOT_OFF+120u)!=0u)
+        return PORT_FINDB_MISMATCH;
+    char physical[12],system[13];uint8_t pn=0u,sn=0u;
+    if(port_ini_fin_physical(q->unit,physical,&pn)!=PORT_FINDB_OK||
+       port_ini_fin_system(q->unit,q->concealed,system,&sn)!=PORT_FINDB_OK||
+       r->physical_count!=pn || r->system_count!=sn ||
+       q->disk_log[PORT_FINDB_DISK_EQ_OFF]!=pn||
+       q->sysdevice_log[PORT_FINDB_SYSDEV_EQ_OFF]!=sn)
+        return PORT_FINDB_MISMATCH;
+    for(unsigned i=0;i<pn;i++)
+        if(q->disk_log[PORT_FINDB_DISK_START+i]!=(uint8_t)physical[i]||
+           r->physical[i]!=(uint8_t)physical[i])return PORT_FINDB_MISMATCH;
+    for(unsigned i=0;i<sn;i++)
+        if(q->sysdevice_log[PORT_FINDB_SYSDEV_START+i]!=(uint8_t)system[i]||
+           r->system[i]!=(uint8_t)system[i])return PORT_FINDB_MISMATCH;
+    return PORT_FINDB_OK;
+}
diff --git a/src/vms_ini_fin_commit.c b/src/vms_ini_fin_commit.c
new file mode 100644
index 0000000..af6a171
--- /dev/null
+++ b/src/vms_ini_fin_commit.c
@@ -0,0 +1,29 @@
+#include "vms_ini_fin_database.h"
+/* Transactional source FIN_DATABASE: calculate entire logical strings
+ * before mutating the fixed DDB and nonpaged LOG source records. */
+uint32_t port_ini_fin_database(struct port_ini_fin_settings *q,
+    struct port_ini_fin_result *out){
+    if(!out||port_ini_fin_validate(q)!=PORT_FINDB_OK)
+        return PORT_FINDB_BAD;
+    char p[12],s[13];uint8_t pn=0u,sn=0u;
+    if(port_ini_fin_physical(q->unit,p,&pn)!=PORT_FINDB_OK||
+       port_ini_fin_system(q->unit,q->concealed,s,&sn)!=PORT_FINDB_OK||
+       pn>PORT_INI_LOG_TEMPLATE_BYTES-PORT_FINDB_DISK_START||
+       sn>PORT_INI_LOG_TEMPLATE_BYTES-PORT_FINDB_SYSDEV_START)
+        return PORT_FINDB_NO_ROOM;
+    if(port_ini_fin_ddb_name(q->device_bytes,q->device_size,
+           q->device_base,q->device_info)!=PORT_FINDB_OK)
+        return PORT_FINDB_BAD;
+    port_ini_fin_disk_record(q->disk_log,p,pn);
+    port_ini_fin_sysdev_record(q->sysdevice_log,s,sn);
+    struct port_ini_fin_result result={0};
+    for(unsigned i=0;i<pn;i++)result.physical[i]=(uint8_t)p[i];
+    for(unsigned i=0;i<sn;i++)result.system[i]=(uint8_t)s[i];
+    result.physical_count=pn;result.system_count=sn;
+    result.boot_unit=q->unit;
+    result.boot_ddb=q->device_info->ddb[0];
+    result.boot_ucb=q->device_info->ucb[0];
+    result.concealed=q->concealed;result.records_staged=1u;
+    *out=result;
+    return PORT_FINDB_OK;
+}
