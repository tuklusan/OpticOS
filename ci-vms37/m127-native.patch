+    struct port_v37_device_result *);
+void port_ini_fin_disk_record(uint8_t *,const char *,unsigned);
+void port_ini_fin_sysdev_record(uint8_t *,const char *,unsigned);
+uint32_t port_ini_fin_database(struct port_ini_fin_settings *,
+    struct port_ini_fin_result *);
+uint32_t port_ini_fin_check(const struct port_ini_fin_settings *,
+    const struct port_ini_fin_result *);
+#endif
diff --git a/src/vms_ini_fin_ddb_name.c b/src/vms_ini_fin_ddb_name.c
new file mode 100644
index 0000000..258e834
--- /dev/null
+++ b/src/vms_ini_fin_ddb_name.c
@@ -0,0 +1,20 @@
+#include "vms_ini_fin_database.h"
+/* INIT.MAR FIX_DRV_NAME precedes FIN_DATABASE, recording DQA and
+ * DQDRIVER in the source DDB counted fields. Source DQ DDT still zero;
+ * the PC ATA port translates device geometry without simulating RB730. */
+uint32_t port_ini_fin_ddb_name(uint8_t *data,size_t cap,uint32_t base,
+    struct port_v37_device_result *r){
+    if(!data||!r||cap<PORT_V37_DEVICE_BYTES||
+       base!=(uint32_t)(uintptr_t)data || r->boot_name_ready||
+       r->incomplete_driver_mask!=7u ||
+       port_v37_devices_check(data,cap,base,r)!=PORT_V37_DEV_OK)
+        return PORT_FINDB_BAD;
+    uint8_t *d=data+PORT_V37_DDB_BOOT_OFF;
+    d[20u]=3u;
+    d[21u]='D';d[22u]='Q';d[23u]='A';
+    static const char drv[]="DQDRIVER";
+    d[36u]=8u;
+    for(unsigned i=0;i<8u;i++)d[37u+i]=(uint8_t)drv[i];
+    r->boot_name_ready=1u;
+    return PORT_FINDB_OK;
+}
diff --git a/src/vms_ini_fin_decimal.c b/src/vms_ini_fin_decimal.c
new file mode 100644
index 0000000..0748ea1
--- /dev/null
+++ b/src/vms_ini_fin_decimal.c
@@ -0,0 +1,10 @@
+#include "vms_ini_fin_database.h"
+/* INIT.MAR EDIV #10 / ADDB digit loop, converted directly to IA-32 C.
+ * A UCB unit is an unsigned 16-bit number; no decimal exponent tables. */
+uint32_t port_ini_fin_decimal(uint16_t unit,char out[5]){
+    if(!out)return 0u;
+    char reverse[5];unsigned n=0u;
+    do{reverse[n++]=(char)('0'+(unit%10u));unit=(uint16_t)(unit/10u);}while(unit);
+    for(unsigned i=0u;i<n;i++)out[i]=reverse[n-1u-i];
+    return n;
+}
diff --git a/src/vms_ini_fin_disk_record.c b/src/vms_ini_fin_disk_record.c
new file mode 100644
index 0000000..042c7a2
--- /dev/null
+++ b/src/vms_ini_fin_disk_record.c
@@ -0,0 +1,8 @@
+#include "vms_ini_fin_database.h"
+/* Fixed LOG$C_LENGTH=20 name SYS$DISK has an 8-character ASCIC string,
+ * then the destination ASCIC length at +29 and data from +30. */
+void port_ini_fin_disk_record(uint8_t *disk,const char *physical,unsigned n){
+    disk[PORT_FINDB_DISK_EQ_OFF]=(uint8_t)n;
+    for(unsigned i=PORT_FINDB_DISK_START;i<PORT_INI_LOG_TEMPLATE_BYTES;i++)
+        disk[i]=(i<PORT_FINDB_DISK_START+n)?(uint8_t)physical[i-PORT_FINDB_DISK_START]:0u;
+}
diff --git a/src/vms_ini_fin_physical.c b/src/vms_ini_fin_physical.c
new file mode 100644
index 0000000..13406d8
--- /dev/null
+++ b/src/vms_ini_fin_physical.c
@@ -0,0 +1,15 @@
+#include "vms_ini_fin_database.h"
+/* FIN_DATABASE writes generic device letters into _DXX000: then shifts
+ * one-to-five decimal digits left, updating the counted string length. */
+uint32_t port_ini_fin_physical(uint16_t unit,char out[12],uint8_t *count){
+    if(!out||!count)return PORT_FINDB_BAD;
+    char digits[5];const uint32_t n=port_ini_fin_decimal(unit,digits);
+    if(!n||n>5u)return PORT_FINDB_BAD;
+    out[0]='_';out[1]='D';out[2]='Q';out[3]='A';
+    for(unsigned i=0;i<n;i++)out[4u+i]=digits[i];
+    out[4u+n]=':';
+    const uint8_t total=(uint8_t)(5u+n);
+    for(unsigned i=total;i<12u;i++)out[i]=0;
+    *count=total;
+    return PORT_FINDB_OK;
+}
