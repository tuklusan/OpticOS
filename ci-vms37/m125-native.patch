new file mode 100644
index 0000000..0a06e42
--- /dev/null
+++ b/src/vms_dq_fdt_buffered.c
@@ -0,0 +1,24 @@
+#include "vms_dq_fdt.h"
+/* Original DRIVER/SRC/DQDRIVER.MAR 528-545 FUNCTAB source class: BUFFERED.
+ * Each bit position comes from VMSLIB/SRC/STARDEFFL.MDL (IO$_VIRTUAL=63).
+ * No action address or driver is invented at this stage. */
+uint64_t port_dq_fdt_buffered(void){
+    return PORT_DQ_BIT(0) |
+        PORT_DQ_BIT(1) |
+        PORT_DQ_BIT(2) |
+        PORT_DQ_BIT(3) |
+        PORT_DQ_BIT(4) |
+        PORT_DQ_BIT(8) |
+        PORT_DQ_BIT(17) |
+        PORT_DQ_BIT(26) |
+        PORT_DQ_BIT(27) |
+        PORT_DQ_BIT(35) |
+        PORT_DQ_BIT(39) |
+        PORT_DQ_BIT(50) |
+        PORT_DQ_BIT(51) |
+        PORT_DQ_BIT(52) |
+        PORT_DQ_BIT(53) |
+        PORT_DQ_BIT(54) |
+        PORT_DQ_BIT(56) |
+        PORT_DQ_BIT(57);
+}
diff --git a/src/vms_dq_fdt_build.c b/src/vms_dq_fdt_build.c
new file mode 100644
index 0000000..a8b61c8
--- /dev/null
+++ b/src/vms_dq_fdt_build.c
@@ -0,0 +1,22 @@
+#include "vms_dq_fdt.h"
+/* Source DQ_FUNCTABLE has exactly twelve mask rows: the first two
+ * are legal/buffered and the last ten dispatch to native ACP/EXE actions
+ * not yet ported for this disk. Only masks are staged, never an active FDT. */
+uint32_t port_dq_fdt_build(struct port_dq_fdt *out,size_t bytes){
+    if(!out||bytes<sizeof(*out)||((uintptr_t)out&7u))return PORT_DQ_FDT_BAD;
+    const uint64_t masks[PORT_DQ_FDT_ROWS]={
+      port_dq_fdt_legal(),port_dq_fdt_buffered(),
+      port_dq_fdt_read(),port_dq_fdt_write(),port_dq_fdt_access(),
+      port_dq_fdt_deaccess(),port_dq_fdt_modify(),port_dq_fdt_mount(),
+      port_dq_fdt_zero(),port_dq_fdt_one(),port_dq_fdt_sense(),port_dq_fdt_set()};
+    /* No validation failure can leave a partially initialized resident FDT. */
+    uint64_t categories=0u;
+    for(unsigned i=PORT_DQ_FDT_READ;i<PORT_DQ_FDT_ROWS;i++){
+        if(categories&masks[i])return PORT_DQ_FDT_BAD;
+        categories|=masks[i];
+    }
+    if(categories!=masks[PORT_DQ_FDT_LEGAL] ||
+       (masks[PORT_DQ_FDT_BUFFERED]&~categories))return PORT_DQ_FDT_BAD;
+    for(unsigned i=0;i<PORT_DQ_FDT_ROWS;i++)out->mask[i]=masks[i];
+    return PORT_DQ_FDT_OK;
+}
diff --git a/src/vms_dq_fdt_classify.c b/src/vms_dq_fdt_classify.c
new file mode 100644
index 0000000..d122884
--- /dev/null
+++ b/src/vms_dq_fdt_classify.c
@@ -0,0 +1,33 @@
+#include "vms_dq_fdt.h"
+/* Source SYSMAR FUNCTAB masks only the low six I/O function bits.
+ * Preserve modifier bits in full_function; never claim a PC driver or ACP
+ * is bound simply because original DQDRIVER permits this function. */
+uint32_t port_dq_fdt_classify(const struct port_dq_fdt *p,size_t bytes,
+    uint16_t function,struct port_dq_fdt_decision *out){
+    if(!out||port_dq_fdt_validate(p,bytes)!=PORT_DQ_FDT_OK)
+        return PORT_DQ_FDT_BAD;
+    const uint8_t code=(uint8_t)(function&63u);
+    const uint64_t bit=PORT_DQ_BIT(code);
+    if(!(p->mask[PORT_DQ_FDT_LEGAL]&bit))return PORT_DQ_FDT_ILLEGAL;
+    uint8_t action=PORT_DQ_FDT_NO_ACTION;
+    for(unsigned i=PORT_DQ_FDT_READ;i<PORT_DQ_FDT_ROWS;i++){
+        if(p->mask[i]&bit){
+            if(action!=PORT_DQ_FDT_NO_ACTION)return PORT_DQ_FDT_BAD;
+            action=(uint8_t)i;
+        }
+    }
+    if(action==PORT_DQ_FDT_NO_ACTION)return PORT_DQ_FDT_BAD;
+    *out=(struct port_dq_fdt_decision){
+        .full_function=function,.number=code,
+        .buffered=(uint8_t)((p->mask[PORT_DQ_FDT_BUFFERED]&bit)!=0),
+        .action_class=action,.driver_bound=0u};
+    return PORT_DQ_FDT_OK;
+}
+uint32_t port_dq_fdt_dispatch(const struct port_dq_fdt *p,size_t bytes,
+                             uint16_t function){
+    struct port_dq_fdt_decision decision={0};
+    uint32_t st=port_dq_fdt_classify(p,bytes,function,&decision);
+    if(st!=PORT_DQ_FDT_OK)return st;
+    /* Until real native DQ_STARTIO/ACP/CRB, no function may run. */
+    return PORT_DQ_FDT_UNBOUND;
+}
