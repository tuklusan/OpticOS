diff --git a/src/vms_devlog_attempt.c b/src/vms_devlog_attempt.c
new file mode 100644
index 0000000..4b8e352
--- /dev/null
+++ b/src/vms_devlog_attempt.c
@@ -0,0 +1,27 @@
+#include "vms_devlog_search.h"
+/* IOSUBPAGD 70$-110$: call source LOG$TRANSLATE through the small SYSTEM
+ * table, preserving the original 10-attempt bound. The only public
+ * bootstrap names are SYS$DISK and SYS$SYSDEVICE. */
+uint32_t port_devlog_attempt(const struct port_log_system_table *t,
+    struct port_devlog_state *s){
+    if(!t||!s||s->stopped||s->attempts>=PORT_DEVLOG_MAX_STEPS)
+        return PORT_V37_IOC_BAD;
+    size_t prefix=0;
+    if(port_devlog_colon(s->name,s->length,&prefix)!=PORT_V37_IOC_OK)
+        return PORT_V37_IOC_BAD;
+    uint8_t next[PORT_DEVLOG_NAME_CAP]={0};
+    struct port_log_result result={0};
+    const uint32_t r=port_log_translate(t,s->name,prefix,0u,next,
+        sizeof next,&result);
+    if((r!=PORT_LOG_OK&&r!=PORT_LOG_NOTRAN)||
+       result.bytes==0u||result.bytes>PORT_V37_IOC_NAME_MAX)
+        return PORT_V37_IOC_BAD;
+    struct port_devlog_state tmp=*s;
+    for(unsigned i=0;i<result.bytes;i++)tmp.name[i]=(char)next[i];
+    tmp.name[result.bytes]=0;tmp.length=result.bytes;
+    tmp.attempts++;
+    tmp.last_notran=(uint8_t)(r==PORT_LOG_NOTRAN);
+    tmp.stopped=(uint8_t)(r==PORT_LOG_NOTRAN);
+    *s=tmp;
+    return PORT_V37_IOC_OK;
+}
diff --git a/src/vms_devlog_colon.c b/src/vms_devlog_colon.c
new file mode 100644
index 0000000..2657e5e
--- /dev/null
+++ b/src/vms_devlog_colon.c
@@ -0,0 +1,12 @@
+#include "vms_devlog_search.h"
+/* Source 150$-180$: a single colon terminates the name to translate. An
+ * RMS file specification after ':' is not a device lookup at this stage. */
+uint32_t port_devlog_colon(const char *s,size_t n,size_t *part){
+    if(!s||!part||!n||n>PORT_V37_IOC_NAME_MAX)return PORT_V37_IOC_BAD;
+    size_t i=0;
+    while(i<n&&s[i]!=':')i++;
+    if(i==0u)return PORT_V37_IOC_BAD;
+    if(i<n&&i+1u<n)return PORT_V37_IOC_BAD;
+    *part=i;
+    return PORT_V37_IOC_OK;
+}
diff --git a/src/vms_devlog_final.c b/src/vms_devlog_final.c
new file mode 100644
index 0000000..a012959
--- /dev/null
+++ b/src/vms_devlog_final.c
@@ -0,0 +1,18 @@
+#include "vms_devlog_search.h"
+/* Source SEARCHDEV input R4,R5: freeze final spelling, length, and source
+ * SS$_CONCEALED outcome separately from the physical success status. */
+uint32_t port_devlog_final(const struct port_devlog_state *s,
+    struct port_devlog_trace *out){
+    if(!s||!out||!s->stopped||!s->length||
+       s->length>PORT_V37_IOC_NAME_MAX||
+       s->attempts>PORT_DEVLOG_MAX_STEPS)return PORT_V37_IOC_BAD;
+    struct port_devlog_trace v={0};
+    for(size_t i=0;i<s->length;i++)v.physical[i]=s->name[i];
+    v.physical[s->length]=0;
+    v.length=(uint16_t)s->length;
+    v.translations=s->attempts;
+    v.concealed=s->concealed;
+    v.last_notran=s->last_notran;
+    *out=v;
+    return PORT_V37_IOC_OK;
+}
diff --git a/src/vms_devlog_input.c b/src/vms_devlog_input.c
new file mode 100644
index 0000000..3cb84e3
--- /dev/null
+++ b/src/vms_devlog_input.c
@@ -0,0 +1,16 @@
+#include "vms_devlog_search.h"
+/* IOSUBPAGD.MAR 310-329,70$-90$: descriptor size, probe equivalent and
+ * lowercase conversion into an owned result buffer. No untrusted pointers. */
+uint32_t port_devlog_input(struct port_devlog_state *s,const char *src,size_t n){
+    if(!s||!src||!n||n>PORT_V37_IOC_NAME_MAX)return PORT_V37_IOC_BAD;
+    for(size_t i=0;i<n;i++){
+        const unsigned char c=(unsigned char)src[i];
+        if(c==0u||c>=128u)return PORT_V37_IOC_BAD;
+    }
+    struct port_devlog_state tmp={0};
+    if(port_v37_ioc_upcase(src,n,tmp.name,sizeof tmp.name)!=PORT_V37_IOC_OK)
+        return PORT_V37_IOC_BAD;
+    tmp.name[n]=0;tmp.length=n;
+    *s=tmp;
+    return PORT_V37_IOC_OK;
+}
diff --git a/src/vms_devlog_lookup.c b/src/vms_devlog_lookup.c
new file mode 100644
index 0000000..c801ca0
--- /dev/null
+++ b/src/vms_devlog_lookup.c
@@ -0,0 +1,18 @@
+#include "vms_devlog_search.h"
+/* IOSUBPAGD 200$-330$: use the unchanged source DDB/UCB physical walk.
+ * A resolved logical name is not a usable channel until its DDT is live. */
+uint32_t port_devlog_lookup(const uint8_t *m,size_t n,uint32_t base,
+    const struct port_v37_device_result *dev,unsigned mode,
+    struct port_devlog_trace *trace){
+    if(!trace||!trace->length)return PORT_V37_IOC_BAD;
+    struct port_v37_ioc_result ucb={0};
+    const uint32_t status=port_v37_ioc_search(m,n,base,dev,
+        trace->physical,trace->length,mode,&ucb);
+    trace->ioc_status=status;
+    if(status==PORT_V37_IOC_OK||status==PORT_V37_IOC_UNBOUND){
+        trace->device=ucb;
+        trace->driver_bound=ucb.driver_bound;
+        trace->concealed=ucb.concealed;
+    }
+    return status;
+}
diff --git a/src/vms_devlog_normalize.c b/src/vms_devlog_normalize.c
new file mode 100644
index 0000000..92c1c50
--- /dev/null
+++ b/src/vms_devlog_normalize.c
@@ -0,0 +1,23 @@
+#include "vms_devlog_search.h"
+/* IOSUBPAGD 70$-200$: repeat LOG$TRANSLATE only until NOTRAN, a physical
+ * underscore, or at most ten translations. No fabricated remote UCB. */
+uint32_t port_devlog_normalize(const struct port_log_system_table *t,
+    struct port_devlog_state *s){
+    if(!t||!s||!s->length||s->length>PORT_V37_IOC_NAME_MAX)
+        return PORT_V37_IOC_BAD;
+    for(unsigned i=0;i<PORT_DEVLOG_MAX_STEPS;i++){
+        uint32_t v=port_devlog_remote(s->name,s->length);
+        if(v!=PORT_V37_IOC_OK)return v;
+        uint8_t concealed=0;
+        v=port_devlog_underscore(s->name,s->length,&concealed);
+        if(v==PORT_V37_IOC_LOGICAL_PENDING){
+            s->concealed=concealed;s->stopped=1u;
+            return PORT_V37_IOC_OK;
+        }
+        if(v!=PORT_V37_IOC_OK)return v;
+        if(s->stopped)return PORT_V37_IOC_OK;
+        v=port_devlog_attempt(t,s);
+        if(v!=PORT_V37_IOC_OK)return v;
+    }
+    return PORT_V37_IOC_BAD; /* a cyclic or overlong logical chain */
+}
diff --git a/src/vms_devlog_remote.c b/src/vms_devlog_remote.c
new file mode 100644
index 0000000..53a72aa
--- /dev/null
+++ b/src/vms_devlog_remote.c
@@ -0,0 +1,8 @@
+#include "vms_devlog_search.h"
+/* IOSUBPAGD.MAR 150$-170$,250$: double colon is a remote device. */
+uint32_t port_devlog_remote(const char *name,size_t n){
+    if(!name||!n||n>PORT_V37_IOC_NAME_MAX)return PORT_V37_IOC_BAD;
+    for(size_t i=1;i<n;i++)if(name[i-1u]==':'&&name[i]==':')
+        return PORT_V37_IOC_NONLOCAL;
+    return PORT_V37_IOC_OK;
+}
diff --git a/src/vms_devlog_search.c b/src/vms_devlog_search.c
new file mode 100644
index 0000000..1f0a144
--- /dev/null
+++ b/src/vms_devlog_search.c
@@ -0,0 +1,31 @@
+#include "vms_devlog_search.h"
+/* Bounded original IOC$SEARCHDEV logical->physical device translation.
+ * A failure changes neither the caller's result nor any UCB/CCB. The
+ * diagnostic trace on NOSUCHDEV is intentionally returned so missing
+ * DQ bind is observable without reporting a successful $ASSIGN. */
+uint32_t port_devlog_search(const struct port_log_system_table *t,
+    const uint8_t *m,size_t n,uint32_t base,
+    const struct port_v37_device_result *dev,const char *text,size_t len,
+    unsigned mode,struct port_devlog_trace *out){
+    if(!t||!m||!dev||!out||!text||
+       (mode!=PORT_V37_IOC_MODE_PHYSICAL&&
+        mode!=PORT_V37_IOC_MODE_GENERIC&&
+        mode!=PORT_V37_IOC_MODE_ALLOCATION)||
+       port_log_system_check(t)!=PORT_LOG_OK||
+       port_v37_ioc_validate(m,n,base,dev)!=PORT_V37_IOC_OK)
+        return PORT_V37_IOC_BAD;
+    struct port_devlog_state s={0};
+    uint32_t status=port_devlog_input(&s,text,len);
+    if(status!=PORT_V37_IOC_OK)return status;
+    status=port_devlog_normalize(t,&s);
+    if(status!=PORT_V37_IOC_OK)return status;
+    struct port_devlog_trace trace={0};
+    status=port_devlog_final(&s,&trace);
+    if(status!=PORT_V37_IOC_OK)return status;
+    status=port_devlog_lookup(m,n,base,dev,mode,&trace);
+    if(status!=PORT_V37_IOC_OK&&status!=PORT_V37_IOC_UNBOUND&&
+       status!=PORT_V37_IOC_NO_SUCH&&status!=PORT_V37_IOC_UNAVAILABLE)
+        return status;
+    *out=trace;
+    return status;
+}
diff --git a/src/vms_devlog_search.h b/src/vms_devlog_search.h
new file mode 100644
index 0000000..33130f2
--- /dev/null
+++ b/src/vms_devlog_search.h
@@ -0,0 +1,37 @@
+#ifndef VMS37_DEVLOG_SEARCH_H
+#define VMS37_DEVLOG_SEARCH_H
+#include "vms_log_system.h"
+#include "vms_ioc_phys.h"
+/* IOSUBPAGD.MAR 302-531: source LOG$TRANSLATE loop followed by the
+ * physical DDB/UCB search. SYSTEM bootstrap names only; no process/group
+ * logicals, mutex, $ASSIGN, mounted volume, ACP or active DQ driver. */
+enum { PORT_DEVLOG_MAX_STEPS=10u, PORT_DEVLOG_NAME_CAP=64u };
+struct port_devlog_state {
+    char name[PORT_DEVLOG_NAME_CAP];
+    size_t length;
+    uint8_t attempts,concealed,last_notran,stopped;
+};
+struct port_devlog_trace {
+    char physical[PORT_DEVLOG_NAME_CAP];
+    uint16_t length;
+    uint8_t translations,concealed,last_notran,driver_bound;
+    uint32_t ioc_status;
+    struct port_v37_ioc_result device;
+};
+uint32_t port_devlog_input(struct port_devlog_state *,const char *,size_t);
+uint32_t port_devlog_remote(const char *,size_t);
+uint32_t port_devlog_colon(const char *,size_t,size_t *);
+uint32_t port_devlog_underscore(const char *,size_t,uint8_t *);
+uint32_t port_devlog_attempt(const struct port_log_system_table *,
+    struct port_devlog_state *);
+uint32_t port_devlog_normalize(const struct port_log_system_table *,
+    struct port_devlog_state *);
+uint32_t port_devlog_final(const struct port_devlog_state *,
+    struct port_devlog_trace *);
+uint32_t port_devlog_lookup(const uint8_t *,size_t,uint32_t,
+    const struct port_v37_device_result *,unsigned,
+    struct port_devlog_trace *);
+uint32_t port_devlog_search(const struct port_log_system_table *,
+    const uint8_t *,size_t,uint32_t,const struct port_v37_device_result *,
+    const char *,size_t,unsigned,struct port_devlog_trace *);
+#endif
diff --git a/src/vms_devlog_underscore.c b/src/vms_devlog_underscore.c
new file mode 100644
index 0000000..2b79d2f
--- /dev/null
+++ b/src/vms_devlog_underscore.c
@@ -0,0 +1,11 @@
+#include "vms_devlog_search.h"
+/* Source 120$-150$: one underscore escapes logical translation; the
+ * second sets CONCEALED. Keep both for the physical lookup. */
+uint32_t port_devlog_underscore(const char *s,size_t n,uint8_t *concealed){
+    if(!s||!concealed||!n)return PORT_V37_IOC_BAD;
+    unsigned k=0;
+    while(k<n&&s[k]=='_'&&k<3u)k++;
+    if(k>2u||k==n)return PORT_V37_IOC_BAD;
+    *concealed=(uint8_t)(k==2u);
+    return k?PORT_V37_IOC_LOGICAL_PENDING:PORT_V37_IOC_OK;
+}
diff --git a/tests/test_devlog_search_host.c b/tests/test_devlog_search_host.c
new file mode 100644
index 0000000..51fc0e7
--- /dev/null
+++ b/tests/test_devlog_search_host.c
@@ -0,0 +1,95 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "vms_devlog_search.h"
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"IOC LOG failed line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct fixture {
+    uint32_t storage[PORT_V37_DEVICE_BYTES/4u];
+    struct port_v37_device_result device;
+    uint8_t disk[PORT_INI_LOG_TEMPLATE_BYTES];
+    uint8_t sysdev[PORT_INI_LOG_TEMPLATE_BYTES];
+    struct port_ini_fin_result fin;
+    struct port_log_system_table table;
+};
+static int init(struct fixture *f){
+    memset(f,0,sizeof *f);
+    const uint32_t base=(uint32_t)(uintptr_t)f->storage;
+    CHECK(port_v37_devices_prelink((uint8_t *)f->storage,sizeof f->storage,
+          base,&f->device)==PORT_V37_DEV_OK);
+    const uint32_t null_ddt=0x00111000u;
+    port_v37_write32((uint8_t *)f->storage+PORT_V37_DDB_NL_OFF+12u,null_ddt);
+    port_v37_write32((uint8_t *)f->storage+PORT_V37_UCB_NL_OFF+120u,null_ddt);
+    f->device.bound_nl_ddt=null_ddt;
+    f->device.incomplete_driver_mask=7u;
+    port_ini_log_templates(f->disk,f->sysdev);
+    struct port_ini_fin_settings settings={
+       .device_bytes=(uint8_t *)f->storage,.device_size=sizeof f->storage,
+       .device_base=base,.device_info=&f->device,.disk_log=f->disk,
+       .sysdevice_log=f->sysdev,.disk_log_size=sizeof f->disk,
+       .sysdevice_log_size=sizeof f->sysdev,.unit=0u,.concealed=1u,
+       .adapter_is_ata=1u};
+    CHECK(port_ini_fin_database(&settings,&f->fin)==PORT_FINDB_OK);
+    CHECK(port_log_system_init(&f->table,f->disk,f->sysdev,sizeof f->disk,
+                              PORT_LOG_BITS)==PORT_LOG_OK);
+    return 0;
+}
+static uint32_t find(struct fixture *f,const char *name,size_t len,
+                     struct port_devlog_trace *t){
+    return port_devlog_search(&f->table,(uint8_t *)f->storage,
+        sizeof f->storage,(uint32_t)(uintptr_t)f->storage,
+        &f->device,name,len,PORT_V37_IOC_MODE_PHYSICAL,t);
+}
+int main(void){
+    struct fixture f;
+    CHECK(!init(&f));
+    const uint32_t original[3]={f.device.ucb[0],f.device.ucb[1],f.device.ucb[4]};
+    struct port_devlog_trace t={0};
+    /* Original INIT storage is visible, but DQA has no published UCB path. */
+    CHECK(find(&f,"sys$disk",8u,&t)==PORT_V37_IOC_UNBOUND);
+    CHECK(t.translations==1u&&t.length==6u&&!t.concealed&&
+          !memcmp(t.physical,"_DQA0:",6u)&&!t.driver_bound&&t.device.ucb==f.device.ucb[0]);
+    CHECK(find(&f,"SYS$DISK:",9u,&t)==PORT_V37_IOC_UNBOUND);
+    CHECK(t.translations==1u&&t.length==6u&&!memcmp(t.physical,"_DQA0:",6u));
+    CHECK(find(&f,"SYS$SYSDEVICE",13u,&t)==PORT_V37_IOC_UNBOUND);
+    CHECK(t.translations==1u&&t.length==7u&&t.concealed&&
+          !memcmp(t.physical,"__DQA0:",7u)&&t.device.ucb==f.device.ucb[0]);
+    CHECK(find(&f,"NLA0:",5u,&t)==PORT_V37_IOC_OK);
+    CHECK(t.translations==1u&&t.last_notran&&t.length==4u&&
+          !memcmp(t.physical,"NLA0",4u)&&t.driver_bound&&
+          t.device.ucb==f.device.ucb[4]);
+    CHECK(find(&f,"__nla0:",7u,&t)==PORT_V37_IOC_OK);
+    CHECK(t.translations==0u&&t.concealed&&t.device.ucb==f.device.ucb[4]);
+    CHECK(find(&f,"_OPA0:",6u,&t)==PORT_V37_IOC_UNBOUND);
+    CHECK(t.translations==0u&&!t.concealed&&!t.driver_bound&&
+          t.device.ucb==f.device.ucb[1]);
+    CHECK(find(&f,"MBA1:",5u,&t)==PORT_V37_IOC_UNBOUND);
+    CHECK(t.device.ucb==f.device.ucb[2]&&t.translations==1u);
+    /* Source R0 failure must never return a fake UCB or alter caller output. */
+    const struct port_devlog_trace before=t;
+    CHECK(find(&f,"N::NLA0",7u,&t)==PORT_V37_IOC_NONLOCAL);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"SYS$UNKNOWN",11u,&t)==PORT_V37_IOC_LOGICAL_PENDING);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"___NLA0",7u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"OPA65536",8u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"NLA0:FILE",9u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"NLA0:\0E",7u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(find(&f,"",0u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(port_devlog_search(&f.table,(uint8_t *)f.storage,sizeof f.storage,
+        (uint32_t)(uintptr_t)f.storage,&f.device,"NLA0",4u,0u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    CHECK(f.device.ucb[0]==original[0]&&f.device.ucb[1]==original[1]&&
+          f.device.ucb[4]==original[2]);
+    CHECK(port_v37_read32((uint8_t *)f.storage+12u)==0u);
+    CHECK(!init(&f));
+    port_v37_write32(f.disk,(uint32_t)(uintptr_t)f.disk);
+    CHECK(find(&f,"SYS$DISK",8u,&t)==PORT_V37_IOC_BAD);
+    CHECK(!memcmp(&before,&t,sizeof t));
+    puts("IOSUBPAGD.MAR source logical->physical IOC lookup: SYSTEM aliases, no DQ bind, remote/invalid guards PASS");
+    return 0;
+}
diff --git a/tools/qemu_sysboot_m129.py b/tools/qemu_sysboot_m129.py
