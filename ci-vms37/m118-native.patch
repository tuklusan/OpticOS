+    port_v37_ucb_mb2(memory+PORT_V37_UCB_MB2_OFF,ucb[3],ddb[2]);
+    port_v37_ucb_nl(memory+PORT_V37_UCB_NL_OFF,ucb[4],ddb[3]);
