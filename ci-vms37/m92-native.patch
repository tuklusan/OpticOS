+#ifndef VMS_SYSLOA386_H
+#define VMS_SYSLOA386_H
+#include <stdint.h>
+/* Native IA-32 CPU-dependent SYSLOA386.EXE, corresponding to the
+ * SYSLOAxxx/LOAVEC processor-dependent image. VAX bus machinery is not
+ * represented by fake PC devices. Unimplemented vectors fail closed. */
+enum {
+    PORT_SYSLOA386_SIGNATURE=0x36384c53u,
+    PORT_SYSLOA386_VERSION=1u,
+    PORT_SYSLOA386_RETURN_TAG=0x4b4e4c53u,
+    PORT_SYSLOA386_DYN_LOADCODE=98u,
+    PORT_SYSLOA386_OK=1u,
+    PORT_SYSLOA386_BAD_ARGUMENT=2u,
+    PORT_SYSLOA386_BAD_CPU=4u,
+    PORT_SYSLOA386_BAD_DISK=6u
+};
+struct port_sysloa386_load_result {
+    uint32_t signature;
+    uint32_t descriptor_address;
+    uint32_t descriptor_bytes;
+};
+struct port_sysloa386_load_start {
+    uint32_t signature,version;
+    struct port_sysloa386_load_result *result;
+};
+/* Snapshot is recorded from SIDT, MOV CR0/CR3, STR and live IDT gates.
+ * `ticks` comes from the installed PIT IRQ handler, not a timer simulation. */
+struct port_sysloa386_gate {
+    uint16_t offset_low,selector;
+    uint8_t reserved,type;
+    uint16_t offset_high;
+} __attribute__((packed));
+struct port_sysloa386_cpu_result {
+    uint32_t cr0,cr3,idt_base,irq_ticks;
+    uint16_t idt_limit,task_selector,kernel_cs,reserved;
+    struct port_sysloa386_gate gp,pf,timer;
+};
+struct port_sysloa386_cpu_ops {
+    void *context;
+    uint32_t (*read_irq_ticks)(void *);
+};
+struct port_sysloa386_boot_result {
+    uint32_t home_block_lbn;
+    uint32_t physical_boot_sector_checksum;
+    uint16_t cluster_factor,system_structure_level;
+};
+struct port_sysloa386_boot_ops {
+    void *context;
+    int (*read_sector)(void *,uint32_t,uint16_t [256]);
+};
+uint32_t port_sysloa386_entry(const struct port_sysloa386_load_start *req);
+uint32_t port_sysloa386_cpu_probe(const struct port_sysloa386_cpu_ops *ops,
+                                   struct port_sysloa386_cpu_result *out);
+uint32_t port_sysloa386_boot_probe(const struct port_sysloa386_boot_ops *ops,
+                                    struct port_sysloa386_boot_result *out);
+uint32_t port_sysloa386_check_cpu(const struct port_sysloa386_cpu_result *regs);
+uint32_t port_sysloa386_check_home(const uint8_t sector[512],
+                                   struct port_sysloa386_boot_result *out);
+#endif
--- /dev/null
+++ b/src/vms_sysloa386_boot.c
@@ -0,0 +1,36 @@
+#include "vms_sysloa386.h"
+/* EXE$INIBOOTADP: native boot-device check via its registered ATA driver.
+ * An actual Files-11 home block at LBN 1 is necessary, not just a port ID. */
+static uint16_t rd16(const uint8_t *p){
+    return (uint16_t)(p[0]|((uint16_t)p[1]<<8));
+}
+static uint32_t rd32(const uint8_t *p){
+    return (uint32_t)rd16(p)|((uint32_t)rd16(p+2)<<16);
+}
+static uint16_t sum16(const uint8_t *p,unsigned last){
+    uint16_t s=0u;
+    for(unsigned i=0;i<last;i+=2u)s=(uint16_t)(s+rd16(p+i));
+    return s;
+}
+uint32_t port_sysloa386_check_home(const uint8_t s[512],
+                                   struct port_sysloa386_boot_result *r){
+    if(!s||!r)return PORT_SYSLOA386_BAD_ARGUMENT;
+    /* HM2$W_STRUCLEV 2, LBN and checked sums from Files-11 boot mount. */
+    if(rd32(s)!=1u||s[13]!=2u||rd16(s+14u)==0u||
+       rd32(s+24u)==0u||rd32(s+28u)<rd16(s+34u)||
+       rd16(s+58u)!=sum16(s,58u)||
+       rd16(s+510u)!=sum16(s,510u))return PORT_SYSLOA386_BAD_DISK;
+    r->home_block_lbn=rd32(s);
+    r->cluster_factor=rd16(s+14u);
+    r->system_structure_level=rd16(s+12u);
+    r->physical_boot_sector_checksum=rd16(s+510u);
+    return PORT_SYSLOA386_OK;
+}
+uint32_t port_sysloa386_boot_probe(const struct port_sysloa386_boot_ops *ops,
+                                    struct port_sysloa386_boot_result *r){
+    if(!ops||!ops->read_sector||!r)return PORT_SYSLOA386_BAD_ARGUMENT;
+    uint16_t sector[256];
+    if(ops->read_sector(ops->context,1u,sector))return PORT_SYSLOA386_BAD_DISK;
+    /* The PC disk sector is little-endian, as are Files-11 ODS-2 headers. */
+    return port_sysloa386_check_home((const uint8_t *)sector,r);
+}
--- /dev/null
+++ b/src/vms_sysloa386_cpu.c
@@ -0,0 +1,48 @@
+#include "vms_sysloa386.h"
+/* Hardware replacement for SYSLOAVEC's EXE$INIPROCREG; the VAX IPL,
+ * SCBB, MAPEN and machine-check registers are *not* x86 CPU registers.
+ * The live x86 IDTR, CR0, CR3 and TSS must be initialized by arch_init. */
+static uint32_t gate_target(const struct port_sysloa386_gate *g){
+    return (uint32_t)g->offset_low|((uint32_t)g->offset_high<<16);
+}
+static int gate_ok(const struct port_sysloa386_gate *g){
+    const uint32_t at=gate_target(g);
+    return g->selector==8u && g->reserved==0u &&
+           (g->type==0x8eu) && at>=0x10000u && at<0x00320000u;
+}
+uint32_t port_sysloa386_check_cpu(const struct port_sysloa386_cpu_result *r){
+    if(!r || (r->cr0&0x80010001u)!=0x80010001u ||
+       !(r->cr3&0xfffff000u) || (r->cr3&4095u)!=0u ||
+       r->idt_base<0x10000u || r->idt_base>=0x00320000u ||
+       r->idt_limit<32u*8u+7u || r->task_selector!=0x48u ||
+       r->kernel_cs!=8u || !r->irq_ticks ||
+       !gate_ok(&r->gp) || !gate_ok(&r->pf) || !gate_ok(&r->timer))
+        return PORT_SYSLOA386_BAD_CPU;
+    return PORT_SYSLOA386_OK;
+}
+uint32_t port_sysloa386_cpu_probe(const struct port_sysloa386_cpu_ops *ops,
+                                   struct port_sysloa386_cpu_result *r){
+    if(!ops||!ops->read_irq_ticks||!r)return PORT_SYSLOA386_BAD_ARGUMENT;
+#if defined(__i386__) && defined(PORT_SYSLOA386_GUEST)
+    struct {uint16_t limit;uint32_t base;} __attribute__((packed)) idtr;
+    __asm__ volatile("sidt %0":"=m"(idtr));
+    r->idt_base=idtr.base;r->idt_limit=idtr.limit;
+    __asm__ volatile("movl %%cr0,%0":"=r"(r->cr0));
+    __asm__ volatile("movl %%cr3,%0":"=r"(r->cr3));
+    __asm__ volatile("str %0":"=r"(r->task_selector));
+    __asm__ volatile("movw %%cs,%0":"=r"(r->kernel_cs));
+    r->reserved=0u;
+    if(r->idt_base<0x10000u || r->idt_base>=0x00320000u ||
+       r->idt_limit<32u*8u+7u)return PORT_SYSLOA386_BAD_CPU;
+    const struct port_sysloa386_gate *idt=
+        (const struct port_sysloa386_gate *)(uintptr_t)r->idt_base;
+    r->gp=idt[13];r->pf=idt[14];r->timer=idt[32];
+    r->irq_ticks=ops->read_irq_ticks(ops->context);
+    return port_sysloa386_check_cpu(r);
+#else
+    /* User-mode host code cannot lawfully read CR0 or CR3. Only the pure
+     * checker is host-tested; actual register inspection runs in QEMU. */
+    (void)r;
+    return PORT_SYSLOA386_BAD_CPU;
+#endif
+}
--- /dev/null
+++ b/src/vms_sysloa386_entry.c
@@ -0,0 +1,30 @@
+#include "vms_sysloa386.h"
+#include <stdint.h>
+/* SYSLOAxxx's native IA-32 loadable-image entry. Its self-describing
+ * SYSLOAVEC data is compiled into this very image ahead of its text. */
+extern const uint8_t port_sysloa386_descriptor[];
+extern const uint8_t port_sysloa386_image_end[];
+uint32_t port_sysloa386_mcheck_errors[2];
+__attribute__((noreturn)) void port_sysloa386_unavailable(void){
+    /* An unported VAX-specific vector must never succeed accidentally. */
+    __asm__ volatile("cli\n1: hlt\njmp 1b");
+    __builtin_unreachable();
+}
+uint32_t port_sysloa386_entry(const struct port_sysloa386_load_start *req){
+    if(!req||req->signature!=PORT_SYSLOA386_SIGNATURE||
+       req->version!=PORT_SYSLOA386_VERSION||!req->result)
+        return PORT_SYSLOA386_BAD_ARGUMENT;
+    const uintptr_t base=(uintptr_t)port_sysloa386_descriptor;
+    const uintptr_t end=(uintptr_t)port_sysloa386_image_end;
+    if(end<=base||end-base>65535u||base<0x003e0000u||end>0x003f0000u)
+        return PORT_SYSLOA386_BAD_ARGUMENT;
+    const uint32_t extent=(uint32_t)(end-base);
+    const uint8_t *b=port_sysloa386_descriptor;
+    const uint32_t n=(uint32_t)b[0]|((uint32_t)b[1]<<8)|
+                     ((uint32_t)b[2]<<16)|((uint32_t)b[3]<<24);
+    if(n!=extent||b[10]!=PORT_SYSLOA386_DYN_LOADCODE)return PORT_SYSLOA386_BAD_ARGUMENT;
+    req->result->descriptor_address=(uint32_t)base;
+    req->result->descriptor_bytes=extent;
+    req->result->signature=PORT_SYSLOA386_RETURN_TAG;
+    return PORT_SYSLOA386_OK;
+}
--- /dev/null
+++ b/src/vms_sysloa386_vectors.S
@@ -0,0 +1,37 @@
+/* SYS/SRC/SYSLOAVEC.MAR LOAVEC original 23-entry order.
+ * Type 2 entries map VAX CPU/bus exception hardware and deliberately fail
+ * on this PC. EXE$INIBOOTADP and EXE$INIPROCREG have real IA-32 services.
+ * This is a self-relative table loaded from the actual Files-11 file. */
+.section .vmsvec,"a",@progbits
+.balign 4
+.global port_sysloa386_descriptor
+port_sysloa386_descriptor:
+    .long port_sysloa386_image_end - port_sysloa386_descriptor
+    .long 0
+    .short port_sysloa386_image_end - port_sysloa386_descriptor
+    .byte 98,0
+.macro VEC kind, dest
+    .byte \kind
+1:  .long \dest - 1b
+.endm
+/* Longword-aligned original interrupt/machine-check entries. */
+.rept 7
+    VEC 2, port_sysloa386_unavailable
+.endr
+/* ECC$REENABLE (VAX hardware), then EXE$INIBOOTADP (native ATA). */
+    VEC 3, port_sysloa386_unavailable
+    VEC 3, port_sysloa386_boot_probe
+/* EXE$DUMPCPUREG, REGRESTOR, REGSAVE are still unported. */
+.rept 3
+    VEC 3, port_sysloa386_unavailable
+.endr
+/* EXE$INIPROCREG inspects real SIDT/CR0/CR3/TSS and PIT IRQ. */
+    VEC 3, port_sysloa386_cpu_probe
+/* EXE$TEST_CSR, PURGDATAP, UBA/CI/MBA and shutdown remain unported. */
+.rept 9
+    VEC 3, port_sysloa386_unavailable
+.endr
+/* Data pointer EXE$MCHK_ERRCNT (resident, zero-initialized counters). */
+    VEC 1, port_sysloa386_mcheck_errors
+    .long -1
+.section .note.GNU-stack,"",@progbits
--- /dev/null
+++ b/sysloa386_native.ld
@@ -0,0 +1,21 @@
+/* SYSLOAxxx.EXE successor: one native IA-32 CPU-dependent loadable module.
+ * All entry points remain in supervisor RAM, outside SYS/INILOA and the
+ * bootstrap. The original self-relative vector header precedes code. */
+OUTPUT_FORMAT(elf32-i386)
+OUTPUT_ARCH(i386)
+ENTRY(port_sysloa386_entry)
+PHDRS { text PT_LOAD FLAGS(5); data PT_LOAD FLAGS(6); }
+SECTIONS {
+  . = 0x003e0000;
+  .text : { KEEP(*(.vmsvec)) *(.text*) *(.rodata*) } :text
+  . = ALIGN(4096);
+  .data : { *(.data*) } :data
+  . = ALIGN(4096);
+  .bss (NOLOAD) : { *(COMMON) *(.bss*) } :data
+  . = ALIGN(16);
+  port_sysloa386_image_end = .;
+  /DISCARD/ : { *(.note*) *(.comment*) *(.eh_frame*) }
+  ASSERT(. <= 0x003f0000, "SYSLOA386 exceeds reserved supervisor aperture")
+  ASSERT(port_sysloa386_image_end - port_sysloa386_descriptor <= 65535,
+         "SYSLOA386 self-relative vector table exceeds 16-bit header")
+}
