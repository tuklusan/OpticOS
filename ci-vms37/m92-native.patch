+    return (write?fwrite(b,1,BLOCK,d->f):fread(b,1,BLOCK,d->f))==BLOCK;
+}
+static int put(struct disk *d,uint32_t lbn,const uint8_t *src){
+    uint8_t b[BLOCK];memcpy(b,src,BLOCK);return sector(d,lbn,b,1);
