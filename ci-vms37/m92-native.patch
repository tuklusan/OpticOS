+static uint32_t diskread(void *ctx,uint32_t mode,uint32_t fn,
+                         uint32_t lbn,uint32_t count,void *dest){
+    return !mode&&fn==1u&&count==BLOCK&&dest&&sector(ctx,lbn,dest,0)?
+        BOO_IO_NORMAL:BOO_IO_FAILED;
