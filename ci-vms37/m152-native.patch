+/* Follow FH2$W_EXT_FID (offsets 14-19), as FIL$RDCHKFILHDR does.
+ * Source normalized extent decoder is reused from SYSBOOT, not copied
+ * into another set of diverging Files-11 pointer rules. */
+uint32_t port_f11_chain_collect(const struct port_f11_boot_volume *volume,
+    const struct port_dq_dir_fid *first,struct port_f11_chain *out){
+    if(!volume||!volume->home||!volume->index||!volume->read_sector||
+       !first||!first->number||!first->sequence||!out)
+        return PORT_F11_CHAIN_BAD;
+    struct port_f11_chain scratch={0};
+    scratch.first=*first;
+    struct port_dq_dir_fid next=*first;
+    struct port_dq_dir_fid visited[PORT_F11_CHAIN_MAX_HEADERS];
+    unsigned nvisited=0u;
+    while(next.number){
+        if(nvisited>=PORT_F11_CHAIN_MAX_HEADERS)return PORT_F11_CHAIN_CYCLE;
+        for(unsigned i=0u;i<nvisited;i++){
+            if(visited[i].number==next.number&&
+               visited[i].sequence==next.sequence&&
+               visited[i].volume==next.volume)return PORT_F11_CHAIN_CYCLE;
+        }
+        visited[nvisited++]=next;
+        uint8_t fh2[512];uint32_t hdr_lbn=0u;
+        const uint32_t hdr=port_f11_boot_header(volume,&next,&hdr_lbn,fh2);
+        if(hdr==PORT_F11_PATH_IO)return PORT_F11_CHAIN_IO;
+        if(hdr==PORT_F11_PATH_HEADER)return PORT_F11_CHAIN_HEADER;
+        if(hdr!=PORT_F11_PATH_OK)return PORT_F11_CHAIN_MAP;
+        if(scratch.count==PORT_F11_CHAIN_MAX_EXTENTS)
+            return PORT_F11_CHAIN_MAP;
+        uint32_t found=0u;
+        if(port_f11_collect_extents(fh2,scratch.extents+scratch.count,
+             PORT_F11_CHAIN_MAX_EXTENTS-scratch.count,
+             &found)!=PORT_F11_HOME_OK||!found)
+            return PORT_F11_CHAIN_MAP;
+        for(unsigned i=0;i<found;i++){
+            const struct port_f11_extent *e=&scratch.extents[scratch.count+i];
+            if(!e->blocks||!e->lbn||
+               (uint64_t)e->lbn+e->blocks>UINT32_C(0x10000000)||
+               UINT32_MAX-scratch.blocks<e->blocks)
+                return PORT_F11_CHAIN_MAP;
+            if(!scratch.blocks)scratch.first_lbn=e->lbn;
+            scratch.blocks+=e->blocks;
+        }
+        scratch.count+=found;
+        next.number=port_dq_index_word(fh2,14u);
+        next.sequence=port_dq_index_word(fh2,16u);
+        next.volume=port_dq_index_word(fh2,18u);
+        if(!next.number&&(next.sequence||next.volume))
+            return PORT_F11_CHAIN_HEADER;
+        if(next.number&&!next.sequence)return PORT_F11_CHAIN_HEADER;
+    }
+    scratch.headers=nvisited;
+    *out=scratch;
+    return PORT_F11_CHAIN_OK;
+}
diff --git a/src/vms_f11_chain_lbn.c b/src/vms_f11_chain_lbn.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_chain_lbn.c
@@ -0,0 +1,23 @@
+#include "vms_f11_chain.h"
+/* One-origin VBN to LBN across multiple separately checksummed FH2 records. */
+uint32_t port_f11_chain_lbn(const struct port_f11_chain *chain,
+                           uint32_t vbn,uint32_t *lbn){
+    if(!chain||!vbn||!lbn||!chain->count||
+       chain->count>PORT_F11_CHAIN_MAX_EXTENTS)
+        return PORT_F11_CHAIN_BAD;
+    uint64_t start=0u;
+    for(uint32_t i=0u;i<chain->count;i++){
+        const struct port_f11_extent *e=&chain->extents[i];
+        if(!e->blocks||!e->lbn||
+           (uint64_t)e->lbn+e->blocks>UINT32_C(0x10000000))
+            return PORT_F11_CHAIN_MAP;
+        const uint64_t end=start+e->blocks;
+        if((uint64_t)vbn-1u>=start&&(uint64_t)vbn-1u<end){
+            *lbn=e->lbn+(uint32_t)((uint64_t)vbn-1u-start);
+            return PORT_F11_CHAIN_OK;
+        }
+        start=end;
+        if(start>UINT32_MAX)return PORT_F11_CHAIN_MAP;
+    }
+    return PORT_F11_CHAIN_MAP;
+}
diff --git a/src/vms_f11_chain_read.c b/src/vms_f11_chain_read.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_chain_read.c
@@ -0,0 +1,32 @@
+#include "vms_f11_chain.h"
+/* FIL$READVBN with extension headers; only successful physical transfers
+ * advance completed. A missing extent cannot become a synthesized EOF. */
+uint32_t port_f11_chain_read(const struct port_f11_boot_volume *v,
+    const struct port_f11_chain *chain,uint32_t off,uint32_t count,
+    uint8_t *out,size_t capacity,uint32_t *completed){
+    if(!v||!v->read_sector||!chain||!out||!completed||count>capacity||
+       (uint64_t)off+count>UINT32_MAX)
+        return PORT_F11_CHAIN_BAD;
+    if(!count){*completed=0u;return PORT_F11_CHAIN_OK;}
+    if(!chain->blocks||(uint64_t)off+count>(uint64_t)chain->blocks*512u)
+        return PORT_F11_CHAIN_MAP;
+    uint32_t n=0u;
+    while(n<count){
+        const uint32_t at=off+n;
+        const uint32_t vbn=at/512u+1u;
+        const uint32_t within=at%512u;
+        uint32_t lbn=0u;
+        if(port_f11_chain_lbn(chain,vbn,&lbn)!=PORT_F11_CHAIN_OK){
+            *completed=n;return PORT_F11_CHAIN_MAP;
+        }
+        uint8_t sector[512];
+        if(v->read_sector(v->context,lbn,sector)!=PORT_DQ_DIR_OK){
+            *completed=n;return PORT_F11_CHAIN_IO;
+        }
+        const uint32_t bytes=count-n<512u-within?count-n:512u-within;
+        for(uint32_t k=0u;k<bytes;k++)out[n+k]=sector[within+k];
+        n+=bytes;
+    }
+    *completed=n;
+    return PORT_F11_CHAIN_OK;
+}
diff --git a/tests/test_f11_chain_host.c b/tests/test_f11_chain_host.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_chain_host.c
@@ -0,0 +1,79 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_f11_chain.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FIL$RDCHKFILHDR source %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct disk {FILE *f;uint32_t reads,fail_at;};
+static uint32_t fetch(void *o,uint32_t lbn,uint8_t out[512]){
+    struct disk *d=o;
+    if(!d||d->reads++==d->fail_at||lbn>8064u||
+       fseek(d->f,(long)lbn*512L,SEEK_SET)||
+       fread(out,1,512u,d->f)!=512u)return PORT_DQ_DIR_MAP;
+    return PORT_DQ_DIR_OK;
+}
+static int at(FILE *f,uint32_t n,uint8_t b[512]){
+    return !fseek(f,(long)n*512L,SEEK_SET)&&fread(b,1,512u,f)==512u;
+}
+int main(void){
+    FILE *disk=fopen("portdisk.img","rb");CHECK(disk);
+    uint8_t home[512],index[512],mfd[512];uint32_t lbn=0u,vbn=0u;
+    CHECK(at(disk,1u,home));
+    CHECK(port_dq_index_location(home,&lbn)==PORT_DQ_INDEX_OK);
+    CHECK(at(disk,lbn,index));
+    CHECK(port_dq_mfd_location(home,index,&vbn,&lbn)==PORT_DQ_MFD_OK);
+    CHECK(at(disk,lbn,mfd));
+    struct disk io={disk,0u,UINT32_MAX};
+    const struct port_f11_boot_volume v={home,index,mfd,fetch,&io,1u};
+    static const char *const names[]={"SYS.EXE","SYSLOA386.EXE","INILOA.EXE"};
+    for(unsigned file=0;file<3u;file++){
+        const char *name=names[file];
+        struct port_f11_boot_file info;
+        CHECK(port_f11_boot_open(&v,"SYSEXE.DIR",10u,name,strlen(name),
+             1u,&info)==PORT_F11_PATH_OK);
+        struct port_f11_chain chain={0};
+        CHECK(port_f11_chain_collect(&v,&info.file,&chain)==PORT_F11_CHAIN_OK);
+        CHECK(chain.first.number==info.file.number&&chain.headers==1u);
+        CHECK(chain.count>=1u&&chain.blocks>=3u&&chain.first_lbn);
+        for(unsigned sector=1u;sector<=3u;sector++){
+            uint32_t derived=0u,direct=0u;
+            CHECK(port_f11_chain_lbn(&chain,sector,&derived)==PORT_F11_CHAIN_OK);
+            CHECK(port_dq_dir_map_vbn(info.header,sector,&direct)==PORT_DQ_DIR_OK);
+            CHECK(derived==direct);
+        }
+        uint8_t received[1536];uint32_t done=0xdeadbeefu;
+        CHECK(port_f11_chain_read(&v,&chain,399u,1536u,received,
+             sizeof received,&done)==PORT_F11_CHAIN_OK);
+        CHECK(done==1536u);
+        for(unsigned k=0;k<1536u;k++){
+            uint32_t actual=0u;
+            CHECK(port_f11_chain_lbn(&chain,(399u+k)/512u+1u,
+                  &actual)==PORT_F11_CHAIN_OK);
+            uint8_t bytes[512];CHECK(at(disk,actual,bytes));
+            CHECK(received[k]==bytes[(399u+k)%512u]);
+        }
+        CHECK(port_f11_chain_read(&v,&chain,0u,0u,received,
+             sizeof received,&done)==PORT_F11_CHAIN_OK&&done==0u);
+        CHECK(port_f11_chain_read(&v,&chain,0u,2000u,received,
+             sizeof received,&done)==PORT_F11_CHAIN_BAD);
+        CHECK(port_f11_chain_lbn(&chain,UINT32_MAX,&lbn)!=PORT_F11_CHAIN_OK);
+        io.fail_at=io.reads;
+        CHECK(port_f11_chain_read(&v,&chain,0u,512u,received,
+             sizeof received,&done)==PORT_F11_CHAIN_IO);
+        CHECK(done==0u);
+        io.fail_at=UINT32_MAX;
+    }
+    struct port_f11_chain sentinel;
+    memset(&sentinel,0xa5,sizeof sentinel);
+    io.fail_at=io.reads;
+    const struct port_dq_dir_fid sys={11u,11u,0u};
+    CHECK(port_f11_chain_collect(&v,&sys,&sentinel)==PORT_F11_CHAIN_IO);
+    CHECK(sentinel.first.number==0xa5a5u);
+    io.fail_at=UINT32_MAX;
+    CHECK(port_f11_chain_collect(&v,&sys,&sentinel)==PORT_F11_CHAIN_OK);
+    CHECK(port_f11_chain_lbn(NULL,1u,&lbn)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_lbn(&sentinel,0u,&lbn)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_read(NULL,&sentinel,0u,512u,NULL,0u,&lbn)==PORT_F11_CHAIN_BAD);
+    CHECK(!fclose(disk));
+    puts("FIL$RDCHKFILHDR FH2 extension-chain collector and real native disk byte reads PASS");
+    return 0;
+}
diff --git a/tests/test_f11_chain_extension.c b/tests/test_f11_chain_extension.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_chain_extension.c
@@ -0,0 +1,73 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_f11_chain.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FIL$RDCHKFILHDR extension %d: %s\n",__LINE__,#x);return 1;}}while(0)
+static void put16(uint8_t *p,unsigned at,uint16_t x){p[at]=(uint8_t)x;p[at+1u]=(uint8_t)(x>>8u);}
+static void sum(uint8_t *b){uint16_t x=0u;for(unsigned i=0;i<510u;i+=2u)x=(uint16_t)(x+port_dq_index_word(b,i));put16(b,510u,x);}
+struct fake {uint8_t first[512],ext[512];uint32_t first_lbn,ext_lbn;unsigned reads,fail_at;};
+static uint32_t readsec(void *o,uint32_t lbn,uint8_t out[512]){
+    struct fake *f=o;
+    if(++f->reads==f->fail_at)return PORT_DQ_DIR_MAP;
+    if(lbn==f->first_lbn){memcpy(out,f->first,512u);return PORT_DQ_DIR_OK;}
+    if(lbn==f->ext_lbn){memcpy(out,f->ext,512u);return PORT_DQ_DIR_OK;}
+    if(lbn==700u||lbn==1234u){for(unsigned k=0;k<512u;k++)out[k]=(uint8_t)(lbn+k);return PORT_DQ_DIR_OK;}
+    return PORT_DQ_DIR_MAP;
+}
+static int diskread(FILE *d,uint32_t n,uint8_t b[512]){
+    return !fseek(d,(long)n*512L,SEEK_SET)&&fread(b,1,512u,d)==512u;
+}
+int main(void){
+    FILE *disk=fopen("portdisk.img","rb");CHECK(disk);
+    uint8_t home[512],index[512],mfd[512];uint32_t lbn=0u,vbn=0u;
+    CHECK(diskread(disk,1u,home));
+    CHECK(port_dq_index_location(home,&lbn)==PORT_DQ_INDEX_OK);
+    CHECK(diskread(disk,lbn,index));
+    CHECK(port_dq_mfd_location(home,index,&vbn,&lbn)==PORT_DQ_MFD_OK);
+    CHECK(diskread(disk,lbn,mfd));
+    struct fake f={0};
+    const struct port_dq_dir_fid fid1={11u,11u,0u},fid2={14u,14u,0u};
+    CHECK(port_dq_image_header_lbn(home,index,&fid1,&f.first_lbn)==PORT_DQ_IMAGE_OK);
+    CHECK(port_dq_image_header_lbn(home,index,&fid2,&f.ext_lbn)==PORT_DQ_IMAGE_OK);
+    CHECK(f.first_lbn!=f.ext_lbn);
+    CHECK(diskread(disk,f.first_lbn,f.first));
+    memcpy(f.ext,f.first,512u);
+    put16(f.first,14u,14u);put16(f.first,16u,14u);put16(f.first,18u,0u);
+    put16(f.ext,8u,14u);put16(f.ext,10u,14u);put16(f.ext,12u,0u);
+    put16(f.ext,14u,0u);put16(f.ext,16u,0u);put16(f.ext,18u,0u);
+    const unsigned a=(unsigned)f.first[1u]*2u;
+    CHECK(a+8u<510u);
+    f.first[58u]=2u;f.ext[58u]=2u;
+    put16(f.first,a,UINT16_C(0x4000));put16(f.first,a+2u,700u);
+    put16(f.ext,a,UINT16_C(0x4000));put16(f.ext,a+2u,1234u);
+    sum(f.first);sum(f.ext);
+    const struct port_f11_boot_volume v={home,index,mfd,readsec,&f,1u};
+    struct port_f11_chain chain={0};
+    CHECK(port_f11_chain_collect(&v,&fid1,&chain)==PORT_F11_CHAIN_OK);
+    CHECK(f.reads==2u&&chain.headers==2u&&chain.blocks==2u&&chain.count==2u);
+    CHECK(port_f11_chain_lbn(&chain,1u,&lbn)==PORT_F11_CHAIN_OK&&lbn==700u);
+    CHECK(port_f11_chain_lbn(&chain,2u,&lbn)==PORT_F11_CHAIN_OK&&lbn==1234u);
+    CHECK(port_f11_chain_lbn(&chain,3u,&lbn)==PORT_F11_CHAIN_MAP);
+    uint8_t received[700];uint32_t done=UINT32_MAX;
+    CHECK(port_f11_chain_read(&v,&chain,400u,700u,received,
+         sizeof received,&done)==PORT_F11_CHAIN_MAP); /* exceeds two blocks */
+    CHECK(done==UINT32_MAX);
+    CHECK(port_f11_chain_read(&v,&chain,400u,624u,received,
+         sizeof received,&done)==PORT_F11_CHAIN_OK);
+    CHECK(done==624u);
+    for(unsigned i=0;i<624u;i++){
+        uint32_t address=i+400u;
+        const uint32_t at=address<512u?700u:1234u;
+        CHECK(received[i]==(uint8_t)(at+(address%512u)));
+    }
+    put16(f.ext,14u,11u);put16(f.ext,16u,11u);sum(f.ext);
+    CHECK(port_f11_chain_collect(&v,&fid1,&chain)==PORT_F11_CHAIN_CYCLE);
+    put16(f.ext,14u,0u);put16(f.ext,16u,0u);sum(f.ext);
+    f.fail_at=f.reads+2u;
+    CHECK(port_f11_chain_collect(&v,&fid1,&chain)==PORT_F11_CHAIN_IO);
+    f.fail_at=0u;
+    CHECK(port_f11_chain_collect(&v,&fid1,&chain)==PORT_F11_CHAIN_OK);
+    CHECK(!fclose(disk));
+    puts("FIL$RDCHKFILHDR synthetic extension FID, disjoint extents, loop and I/O rollback PASS");
+    return 0;
+}
diff --git a/tests/test_f11_chain_bounds.c b/tests/test_f11_chain_bounds.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_chain_bounds.c
@@ -0,0 +1,42 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_f11_chain.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FH2 chain bound %d: %s\n",__LINE__,#x);return 1;}}while(0)
+int main(void){
+    struct port_f11_chain c={0};uint32_t answer=0xdeadbeefu;
+    CHECK(port_f11_chain_lbn(NULL,1u,&answer)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_BAD);
+    CHECK(answer==0xdeadbeefu);
+    c.count=1u;c.extents[0].blocks=1u;c.extents[0].lbn=100u;
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_OK&&answer==100u);
+    answer=0xdeadbeefu;
+    CHECK(port_f11_chain_lbn(&c,2u,&answer)==PORT_F11_CHAIN_MAP);
+    CHECK(answer==0xdeadbeefu);
+    CHECK(port_f11_chain_lbn(&c,0u,&answer)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_lbn(&c,1u,NULL)==PORT_F11_CHAIN_BAD);
+    c.count=65u;
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_BAD);
+    c.count=1u;c.extents[0].lbn=UINT32_C(0x10000000);
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_MAP);
+    c.extents[0].lbn=UINT32_C(0x0fffffff);c.extents[0].blocks=2u;
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_MAP);
+    c.extents[0].blocks=0u;
+    CHECK(port_f11_chain_lbn(&c,1u,&answer)==PORT_F11_CHAIN_MAP);
+    c.extents[0].lbn=100u;c.extents[0].blocks=UINT32_MAX;
+    CHECK(port_f11_chain_lbn(&c,UINT32_MAX,&answer)==PORT_F11_CHAIN_MAP);
+    memset(&c,0,sizeof c);
+    c.count=PORT_F11_CHAIN_MAX_EXTENTS;
+    for(unsigned i=0;i<PORT_F11_CHAIN_MAX_EXTENTS;i++){
+        c.extents[i].lbn=100u+2u*i;c.extents[i].blocks=2u;
+    }
+    for(uint32_t v=1;v<=PORT_F11_CHAIN_MAX_EXTENTS*2u;v++){
+        CHECK(port_f11_chain_lbn(&c,v,&answer)==PORT_F11_CHAIN_OK);
+        CHECK(answer==100u+v-1u);
+    }
+    answer=0xcafebabeu;
+    CHECK(port_f11_chain_lbn(&c,129u,&answer)==PORT_F11_CHAIN_MAP);
+    CHECK(answer==0xcafebabeu);
+    puts("FIL$RDCHKFILHDR 64-entry normalized extent boundaries, missing/overflow VBNs PASS");
+    return 0;
+}
diff --git a/tests/test_f11_chain_shortio.c b/tests/test_f11_chain_shortio.c
new file mode 100644
--- /dev/null
+++ b/tests/test_f11_chain_shortio.c
@@ -0,0 +1,53 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "vms_f11_chain.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FH2 partial physical IO %d: %s\n",__LINE__,#x);return 1;}}while(0)
+struct device{unsigned reads,fail_at;};
+static uint32_t read_sector(void *opaque,uint32_t lbn,uint8_t b[512]){
+    struct device *d=opaque;
+    if(++d->reads==d->fail_at)return PORT_DQ_DIR_MAP;
+    if(lbn!=700u&&lbn!=1234u)return PORT_DQ_DIR_MAP;
+    for(unsigned i=0;i<512u;i++)b[i]=(uint8_t)(lbn+i);
+    return PORT_DQ_DIR_OK;
+}
+int main(void){
+    struct port_f11_chain chain={0};
+    chain.count=2u;chain.blocks=2u;
+    chain.extents[0]=(struct port_f11_extent){1u,700u};
+    chain.extents[1]=(struct port_f11_extent){1u,1234u};
+    struct device io={0u,2u};
+    struct port_f11_boot_volume vol={0};
+    vol.read_sector=read_sector;vol.context=&io;
+    uint8_t result[700];memset(result,0xa5,sizeof result);
+    uint32_t done=UINT32_MAX;
+    CHECK(port_f11_chain_read(&vol,&chain,400u,600u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_IO);
+    CHECK(done==112u&&io.reads==2u);
+    for(unsigned i=0;i<112u;i++)CHECK(result[i]==(uint8_t)(700u+400u+i));
+    for(unsigned i=112u;i<sizeof result;i++)CHECK(result[i]==0xa5u);
+    io.reads=0u;io.fail_at=1u;done=UINT32_MAX;
+    CHECK(port_f11_chain_read(&vol,&chain,400u,600u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_IO);
+    CHECK(done==0u&&io.reads==1u);
+    io.reads=0u;io.fail_at=0u;
+    CHECK(port_f11_chain_read(&vol,&chain,400u,600u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_OK);
+    CHECK(done==600u&&io.reads==2u);
+    for(unsigned i=0;i<600u;i++){
+        unsigned off=400u+i;
+        CHECK(result[i]==(uint8_t)((off<512u?700u:1234u)+(off%512u)));
+    }
+    done=UINT32_MAX;
+    CHECK(port_f11_chain_read(&vol,&chain,400u,625u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_MAP);
+    CHECK(done==UINT32_MAX);
+    CHECK(port_f11_chain_read(&vol,&chain,UINT32_MAX,1u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_read(&vol,&chain,0u,701u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_BAD);
+    CHECK(port_f11_chain_read(&vol,&chain,0u,0u,result,
+         sizeof result,&done)==PORT_F11_CHAIN_OK&&done==0u);
+    puts("FIL$READVBN extension cross-sector partial I/O and no false success PASS");
+    return 0;
+}
