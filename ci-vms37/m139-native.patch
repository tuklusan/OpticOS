+ * level-2 directory blocks, exact FID/sequence/volume identities. */
+enum {PORT_DQ_DIR_OK=1u,PORT_DQ_DIR_BAD=2u,
+      PORT_DQ_DIR_MAP=4u,PORT_DQ_DIR_CORRUPT=6u,
+      PORT_DQ_DIR_NOT_FOUND=8u};
