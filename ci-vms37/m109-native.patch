+   long double value=0.0L;
+   assert(port109_decode(f,v,&value)==PORT109_OK);
+   assert(port109_encode(f,value,w)==PORT109_OK);
+   assert(memcmp(v,w,n*sizeof(uint16_t))==0);
+  }
+ }
+}
