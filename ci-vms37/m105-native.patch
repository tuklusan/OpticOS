+    CHECK(fid.number==11u && alloc>0u);
+    struct port_f11_extent original[48]={0};
+    uint32_t count=0u,blocks=0u,contiguous=0u;
+    CHECK(port_f11_collect_file_extents(&disk,1u,&volume,fid,
