+    CHECK(count>0u && count<=48u && blocks>=alloc);
+    CHECK(port_sysboot_build_normalized_map(m,sizeof memory,
+       original,count,alloc,&out)==PORT_F11_HOME_OK);
+    CHECK(port_sysboot_check_normalized_map(m,sizeof memory,
