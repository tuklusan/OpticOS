+    struct port_f11_fid fid={0};
+    uint8_t header[512];
+    uint32_t first_lbn=0u,alloc=0u;
+    CHECK(port_f11_open_named_file(&disk,1u,&volume,"[SYSEXE]SYS.EXE",
