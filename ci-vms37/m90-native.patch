+#define CHECK(x) do {if(!(x)){fprintf(stderr,"FAIL %s:%d %s\n",__FILE__,__LINE__,#x);return 1;}}while(0)
+int main(void){
+    struct port_sys_exec_result result;
+    memset(&result,0xa5,sizeof result);
+    struct port_sys_exec_start req={
+        .signature=PORT_SYS_EXEC_SIGNATURE,
+        .version=PORT_SYS_EXEC_VERSION,
+        .system_time=UINT64_C(53312345670000000),
+        .pcb_type=PORT_SYS_EXEC_PCB_KIND,
+        .initialized_images=1u,.reserved=0u,.result=&result};
+    CHECK(port_sys_executive_entry(0)==PORT_SYS_EXEC_BAD_PARAMETERS);
+    req.initialized_images=0u;
+    CHECK(port_sys_executive_entry(&req)==PORT_SYS_EXEC_BAD_PARAMETERS);
+    CHECK(result.signature==0xa5a5a5a5u);
+    req.initialized_images=1u;req.signature=0u;
+    CHECK(port_sys_executive_entry(&req)==PORT_SYS_EXEC_BAD_PARAMETERS);
+    req.signature=PORT_SYS_EXEC_SIGNATURE;
+    req.result=0;
+    CHECK(port_sys_executive_entry(&req)==PORT_SYS_EXEC_BAD_PARAMETERS);
+    req.result=&result;
+    CHECK(port_sys_executive_entry(&req)==PORT_SYS_EXEC_NORMAL);
+    CHECK(result.signature==PORT_SYS_EXEC_RESULT_TAG);
+    CHECK(result.scheduler_pcb_type==PORT_SYS_EXEC_PCB_KIND);
+    CHECK(result.scheduler_ready_mask==0u);
+    CHECK(result.scb_access_violation_pc_vector==13u);
+    CHECK(result.scb_page_fault_pc_vector==14u);
+    CHECK(result.system_time_low==(uint32_t)req.system_time);
+    CHECK(result.system_time_high==(uint32_t)(req.system_time>>32));
+    puts("SYS.EXE resident entry RPB/SCB/time/scheduler readback PASS");
+    return 0;
+}
