diff --git a/src/vms_iopost_swi.h b/src/vms_iopost_swi.h
new file mode 100644
index 0000000..a88365e
--- /dev/null
+++ b/src/vms_iopost_swi.h
@@ -0,0 +1,23 @@
+#ifndef VMS37_IOPOST_SWI_H
+#define VMS37_IOPOST_SWI_H
+#include <stdint.h>
+/* SCBVECTOR.MAR 109-113 maps software IPL$_IOPOST (4) at VAX
+ * vector byte offset 0x90. Pentium native IDT 0x90 is CPL0-only;
+ * it is NOT a 8259 PIC IRQ and must never send a PIC EOI. */
+enum {PORT_IOPOST_SW_VECTOR=0x90u,PORT_IOPOST_SW_OK=1u,
+      PORT_IOPOST_SW_BAD=2u,PORT_IOPOST_SW_UNBOUND=4u,
+      PORT_IOPOST_SW_BUSY=6u,PORT_IOPOST_SW_CORRUPT=8u};
+typedef uint32_t (*port_iopost_swi_action)(void);
+struct port_iopost_swi {
+    port_iopost_swi_action action;
+    uint32_t guest_entry,lower,upper;
+    uint32_t calls,attempts,last_status;
+    uint8_t in_service,armed;
+};
+void port_iopost_swi_init(struct port_iopost_swi *);
+uint32_t port_iopost_swi_bind(struct port_iopost_swi *,
+    port_iopost_swi_action,uint32_t,uint32_t,uint32_t);
+uint32_t port_iopost_swi_dispatch(struct port_iopost_swi *,unsigned);
+uint32_t port_iopost_swi_check(const struct port_iopost_swi *,
+    uint32_t,uint32_t);
+#endif
diff --git a/src/vms_iopost_swi_bind.c b/src/vms_iopost_swi_bind.c
new file mode 100644
index 0000000..2290795
--- /dev/null
+++ b/src/vms_iopost_swi_bind.c
@@ -0,0 +1,16 @@
+#include "vms_iopost_swi.h"
+/* Only a resident supervisor SYS.EXE entry may own the native vector.
+ * Never accept process space, a VAX function pointer, or an alias outside
+ * the image loader's independently verified executable range. */
+uint32_t port_iopost_swi_bind(struct port_iopost_swi *s,
+    port_iopost_swi_action action,uint32_t address,
+    uint32_t lower,uint32_t upper){
+    if(!s||!action||!address||!lower||lower>=upper ||
+       address<lower||address>=upper||s->armed||s->action||
+       s->attempts||s->in_service||s->calls)
+        return PORT_IOPOST_SW_BAD;
+    s->action=action;s->guest_entry=address;
+    s->lower=lower;s->upper=upper;
+    s->armed=1u;
+    return PORT_IOPOST_SW_OK;
+}
