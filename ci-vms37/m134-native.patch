diff --git a/src/vms_ddtreloc.h b/src/vms_ddtreloc.h
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc.h
@@ -0,0 +1,25 @@
+#ifndef VMS37_NATIVE_DDTRELOC_H
+#define VMS37_NATIVE_DDTRELOC_H
+#include <stddef.h>
+#include <stdint.h>
+/* IOC$RELOC_DDT, SYS/SRC/RELOCDRV.MAR 289-349. Strictly offline:
+ * this code rewrites a private DDT/FDT image and never binds a driver. */
+enum {PORT_DDTRELOC_OK=1u,PORT_DDTRELOC_BAD=2u,
+      PORT_DDTRELOC_UNBOUND=4u,PORT_DDTRELOC_DDT_LEN=38u,
+      PORT_DDTRELOC_FDT_OFF=8u,PORT_DDTRELOC_FDT_SIZE_OFF=36u,
+      PORT_DDTRELOC_FDT_START=40u};
+struct port_ddtreloc_image {
+    uint8_t *image;
+    size_t length;
+    uint32_t pc_base;
+};
+uint16_t port_ddtreloc_read16(const uint8_t *p);
+uint32_t port_ddtreloc_read32(const uint8_t *p);
+void port_ddtreloc_write32(uint8_t *p,uint32_t v);
+uint32_t port_ddtreloc_preflight(const struct port_ddtreloc_image *im,
+    uint32_t *fdt_offset,uint16_t *fdt_length);
+uint32_t port_ddtreloc_header(const struct port_ddtreloc_image *im);
+uint32_t port_ddtreloc_functions(const struct port_ddtreloc_image *im,
+    uint32_t fdt_offset,uint16_t fdt_length);
+uint32_t port_ddtreloc_apply(const struct port_ddtreloc_image *im);
+#endif
diff --git a/src/vms_ddtreloc_apply.c b/src/vms_ddtreloc_apply.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_apply.c
@@ -0,0 +1,14 @@
+#include "vms_ddtreloc.h"
+/* Preserve the original relocation order: DDT followed by FDT. Reject
+ * malformed private images before committing any DDT field changes. */
+uint32_t port_ddtreloc_apply(const struct port_ddtreloc_image *im){
+    uint32_t fdt=0;uint16_t size=0;
+    uint32_t result=port_ddtreloc_preflight(im,&fdt,&size);
+    if(result!=PORT_DDTRELOC_OK)return result;
+    if(im->pc_base>UINT32_MAX-(uint32_t)im->length)return PORT_DDTRELOC_BAD;
+    /* The original does not roll back arbitrary writes. Our bounded private
+     * image has already passed every offset/size check. */
+    result=port_ddtreloc_header(im);
+    if(result!=PORT_DDTRELOC_OK)return result;
+    return port_ddtreloc_functions(im,fdt,size);
+}
diff --git a/src/vms_ddtreloc_functions.c b/src/vms_ddtreloc_functions.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_functions.c
@@ -0,0 +1,15 @@
+#include "vms_ddtreloc.h"
+/* Source lines 336-347: skip two bitmap words and step 12-byte rows;
+ * each action is at row+8, relative to the current dispatch block. */
+uint32_t port_ddtreloc_functions(const struct port_ddtreloc_image *im,
+    uint32_t off,uint16_t len){
+    if(!im||!im->image||off>im->length||len>im->length-off||
+       len<16u||(len-16u)%12u)return PORT_DDTRELOC_BAD;
+    for(uint32_t at=off+24u;at+4u<=off+(uint32_t)len;at+=12u){
+        uint8_t *p=im->image+at;
+        const uint32_t old=port_ddtreloc_read32(p);
+        if(!(old&UINT32_C(0x80000000)))
+            port_ddtreloc_write32(p,old+im->pc_base+at-8u);
+    }
+    return PORT_DDTRELOC_OK;
+}
diff --git a/src/vms_ddtreloc_header.c b/src/vms_ddtreloc_header.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_header.c
@@ -0,0 +1,15 @@
+#include "vms_ddtreloc.h"
+/* Source RELOC_DDT_TABLE byte offsets 67-75; the sign bit is DEC's
+ * 'already system address' marker. A high-bit word is left intact. */
+uint32_t port_ddtreloc_header(const struct port_ddtreloc_image *im){
+    static const uint8_t offsets[]={0u,4u,8u,12u,16u,24u,28u,32u};
+    if(!im||!im->image||im->length<PORT_DDTRELOC_DDT_LEN)
+        return PORT_DDTRELOC_BAD;
+    for(unsigned i=0;i<sizeof offsets;i++){
+        uint8_t *p=im->image+offsets[i];
+        const uint32_t prior=port_ddtreloc_read32(p);
+        if(!(prior&UINT32_C(0x80000000)))
+            port_ddtreloc_write32(p,prior+im->pc_base);
+    }
+    return PORT_DDTRELOC_OK;
+}
diff --git a/src/vms_ddtreloc_preflight.c b/src/vms_ddtreloc_preflight.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_preflight.c
@@ -0,0 +1,19 @@
+#include "vms_ddtreloc.h"
+/* Source DDT has a 38-byte dispatch header and an FDT of 16+12*n.
+ * Validate the full source span before touching the supplied image. */
+uint32_t port_ddtreloc_preflight(const struct port_ddtreloc_image *im,
+    uint32_t *fdt_offset,uint16_t *fdt_length){
+    if(!im||!im->image||!fdt_offset||!fdt_length||
+       im->length<PORT_DDTRELOC_DDT_LEN||!im->pc_base||
+       (uint64_t)im->pc_base+im->length>UINT32_MAX)return PORT_DDTRELOC_BAD;
+    const uint16_t len=port_ddtreloc_read16(im->image+PORT_DDTRELOC_FDT_SIZE_OFF);
+    const uint32_t raw=port_ddtreloc_read32(im->image+PORT_DDTRELOC_FDT_OFF);
+    /* Before relocation this word is relative; after relocation high bit
+     * indicates it already points to native system virtual address. */
+    const uint32_t off=(raw&UINT32_C(0x80000000))?
+       (raw>=im->pc_base?raw-im->pc_base:UINT32_MAX):raw;
+    if(off<PORT_DDTRELOC_DDT_LEN||off>im->length||
+       len<16u||(len-16u)%12u||len>im->length-off)
+        return PORT_DDTRELOC_UNBOUND;
+    *fdt_offset=off;*fdt_length=len;return PORT_DDTRELOC_OK;
+}
diff --git a/src/vms_ddtreloc_read16.c b/src/vms_ddtreloc_read16.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_read16.c
@@ -0,0 +1,5 @@
+#include "vms_ddtreloc.h"
+/* Source MOVZWL DDT$W_FDTSIZE, little-endian word. */
+uint16_t port_ddtreloc_read16(const uint8_t *p){
+    return (uint16_t)((uint16_t)p[0]|((uint16_t)p[1]<<8u));
+}
diff --git a/src/vms_ddtreloc_read32.c b/src/vms_ddtreloc_read32.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_read32.c
@@ -0,0 +1,6 @@
+#include "vms_ddtreloc.h"
+/* VAX little-endian DDT dispatch pointer word. */
+uint32_t port_ddtreloc_read32(const uint8_t *p){
+    return (uint32_t)p[0]|((uint32_t)p[1]<<8u)|
+        ((uint32_t)p[2]<<16u)|((uint32_t)p[3]<<24u);
+}
diff --git a/src/vms_ddtreloc_write32.c b/src/vms_ddtreloc_write32.c
new file mode 100644
--- /dev/null
+++ b/src/vms_ddtreloc_write32.c
@@ -0,0 +1,5 @@
+#include "vms_ddtreloc.h"
+/* Native IA-32 byte serialization; no unaligned access assumption. */
+void port_ddtreloc_write32(uint8_t *p,uint32_t v){
+    for(unsigned i=0;i<4u;i++)p[i]=(uint8_t)(v>>(8u*i));
+}
