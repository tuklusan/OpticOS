diff --git a/src/vms_f11_ioc.h b/src/vms_f11_ioc.h
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc.h
@@ -0,0 +1,31 @@
+#ifndef VMS37_NATIVE_F11_IOC_H
+#define VMS37_NATIVE_F11_IOC_H
+#include "vms_dq_ioc.h"
+#include "vms_f11_chain.h"
+/* SYS/SRC/FILEREAD.MAR FIL$READVBN -> FIL$RDWRTLBN ->
+ * EXE$INSIOQ / DQ_STARTIO / IOCIOPOST. Private privileged read-only
+ * bridge, NOT a published DQA0, process $QIO, interrupt, AST or ACP. */
+#define PORT_F11_IOC_MAX_READ 2048u
+enum { PORT_F11_IOC_OK=1u, PORT_F11_IOC_BAD=2u,
+       PORT_F11_IOC_EOF=4u, PORT_F11_IOC_IO=6u,
+       PORT_F11_IOC_BUSY=8u,PORT_F11_IOC_MAP=10u,
+       PORT_F11_IOC_DIFFERENT=12u };
+struct port_f11_ioc_file {
+ const struct port_f11_chain *chain;
+ struct port_dq_ioc_queue *queue;
+ uint32_t position, length, next_tag, reads;
+ uint32_t pending_tag, pending_within;
+ uint8_t pending, sector[512];
+};
+uint32_t port_f11_ioc_init(struct port_f11_ioc_file *,
+ const struct port_f11_chain *,struct port_dq_ioc_queue *,uint32_t);
+uint32_t port_f11_ioc_validate(const struct port_f11_ioc_file *);
+uint32_t port_f11_ioc_seek(struct port_f11_ioc_file *,uint32_t);
+uint32_t port_f11_ioc_locate(const struct port_f11_ioc_file *,uint32_t *,uint32_t *);
+uint32_t port_f11_ioc_stage(struct port_f11_ioc_file *);
+uint32_t port_f11_ioc_post(struct port_f11_ioc_file *);
+uint32_t port_f11_ioc_read(struct port_f11_ioc_file *,uint8_t *,uint32_t,
+ size_t,uint32_t *);
+uint32_t port_f11_ioc_compare(struct port_f11_ioc_file *,const uint8_t *,
+ uint32_t,uint32_t *);
+#endif
diff --git a/src/vms_f11_ioc_compare.c b/src/vms_f11_ioc_compare.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_compare.c
@@ -0,0 +1,14 @@
+#include "vms_f11_ioc.h"
+/* M184: validate actual physical Files-11 media against resident IA-32 text. */
+uint32_t port_f11_ioc_compare(struct port_f11_ioc_file *f,
+ const uint8_t *expected,uint32_t count,uint32_t *equal){
+ if(!f||!expected||!equal||!count||count>PORT_F11_IOC_MAX_READ)
+  return PORT_F11_IOC_BAD;
+ uint8_t bytes[PORT_F11_IOC_MAX_READ];uint32_t done=0;
+ uint32_t st=port_f11_ioc_read(f,bytes,count,sizeof(bytes),&done);
+ if(st!=PORT_F11_IOC_OK)return st;
+ uint32_t n=0;
+ while(n<count&&bytes[n]==expected[n])n++;
+ *equal=n;
+ return n==count?PORT_F11_IOC_OK:PORT_F11_IOC_DIFFERENT;
+}
diff --git a/src/vms_f11_ioc_init.c b/src/vms_f11_ioc_init.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_init.c
@@ -0,0 +1,20 @@
+#include "vms_f11_ioc.h"
+/* M177: validate source FH2 extent chain before installing private file. */
+uint32_t port_f11_ioc_init(struct port_f11_ioc_file *f,
+ const struct port_f11_chain *c,struct port_dq_ioc_queue *q,uint32_t length){
+ if(!f||!c||!q||!q->read_sector||!c->count||
+    c->count>PORT_F11_CHAIN_MAX_EXTENTS||!c->blocks||
+    (uint64_t)length>(uint64_t)c->blocks*512u||
+    port_dq_ioc_validate(q)!=PORT_DQ_IOC_OK) return PORT_F11_IOC_BAD;
+ uint64_t blocks=0;
+ for(uint32_t i=0;i<c->count;i++){
+  const struct port_f11_extent *e=&c->extents[i];
+  if(!e->blocks||!e->lbn||(uint64_t)e->lbn+e->blocks>0x10000000u)
+   return PORT_F11_IOC_MAP;
+  blocks+=e->blocks;
+ }
+ if(blocks!=c->blocks)return PORT_F11_IOC_MAP;
+ struct port_f11_ioc_file t={0};
+ t.chain=c;t.queue=q;t.length=length;t.next_tag=0xf1100000u;
+ *f=t;return PORT_F11_IOC_OK;
+}
diff --git a/src/vms_f11_ioc_locate.c b/src/vms_f11_ioc_locate.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_locate.c
@@ -0,0 +1,12 @@
+#include "vms_f11_ioc.h"
+/* M180: one-origin VBN -> source GETRTRVPTR -> mapped physical LBN. */
+uint32_t port_f11_ioc_locate(const struct port_f11_ioc_file *f,
+ uint32_t *lbn,uint32_t *within){
+ if(!f||!f->chain||!lbn||!within)return PORT_F11_IOC_BAD;
+ if(f->position>=f->length)return PORT_F11_IOC_EOF;
+ uint32_t l=0;
+ if(port_f11_chain_lbn(f->chain,f->position/512u+1u,&l)
+   !=PORT_F11_CHAIN_OK)return PORT_F11_IOC_MAP;
+ *lbn=l;*within=f->position%512u;
+ return PORT_F11_IOC_OK;
+}
diff --git a/src/vms_f11_ioc_post.c b/src/vms_f11_ioc_post.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_post.c
@@ -0,0 +1,14 @@
+#include "vms_f11_ioc.h"
+/* M182: DQ FUNCXT -> IOCIOPOST, deliver just one private IOSB. */
+uint32_t port_f11_ioc_post(struct port_f11_ioc_file *f){
+ if(!f||!f->queue)return PORT_F11_IOC_BAD;
+ if(!f->pending)return PORT_F11_IOC_BUSY;
+ struct port_dq_ioc_iosb iosb={0};
+ uint32_t st=port_dq_ioc_service(f->queue,&iosb);
+ if(st!=PORT_DQ_IOC_OK&&st!=PORT_DQ_IOC_IO)return PORT_F11_IOC_BUSY;
+ if(iosb.tag!=f->pending_tag)return PORT_F11_IOC_BAD;
+ f->pending=0;f->pending_tag=0;
+ f->reads++;
+ return st==PORT_DQ_IOC_OK&&iosb.bytes==512u?
+  PORT_F11_IOC_OK:PORT_F11_IOC_IO;
+}
diff --git a/src/vms_f11_ioc_read.c b/src/vms_f11_ioc_read.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_read.c
@@ -0,0 +1,25 @@
+#include "vms_f11_ioc.h"
+/* M183: FIL$READVBN partial-sector/extent read. Destination and position
+ * commit only after entire bounded read succeeds; hardware failures report
+ * bytes physically completed without exposing stale sector buffers. */
+uint32_t port_f11_ioc_read(struct port_f11_ioc_file *f,uint8_t *out,
+ uint32_t count,size_t capacity,uint32_t *done){
+ if(!f||!out||!done||!f->chain||!f->queue||f->pending||
+    !count||count>PORT_F11_IOC_MAX_READ||count>capacity)return PORT_F11_IOC_BAD;
+ if(f->position>f->length||count>f->length-f->position)
+  return PORT_F11_IOC_EOF;
+ uint8_t temp[PORT_F11_IOC_MAX_READ];
+ uint32_t at=f->position,got=0;
+ while(got<count){
+  uint32_t st=port_f11_ioc_stage(f);
+  if(st!=PORT_F11_IOC_OK){f->position=at;return st;}
+  st=port_f11_ioc_post(f);
+  if(st!=PORT_F11_IOC_OK){f->position=at;*done=got;return st;}
+  uint32_t n=512u-f->pending_within;
+  if(n>count-got)n=count-got;
+  for(uint32_t i=0;i<n;i++)temp[got+i]=f->sector[f->pending_within+i];
+  f->position+=n;got+=n;
+ }
+ for(uint32_t i=0;i<count;i++)out[i]=temp[i];
+ *done=count;return PORT_F11_IOC_OK;
+}
diff --git a/src/vms_f11_ioc_seek.c b/src/vms_f11_ioc_seek.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_seek.c
@@ -0,0 +1,8 @@
+#include "vms_f11_ioc.h"
+/* M179: original FIL$READVBN VBN cursor positioning, EOF inclusive. */
+uint32_t port_f11_ioc_seek(struct port_f11_ioc_file *f,uint32_t at){
+ if(!f||!f->chain||!f->queue)return PORT_F11_IOC_BAD;
+ if(f->pending)return PORT_F11_IOC_BUSY;
+ if(at>f->length)return PORT_F11_IOC_EOF;
+ f->position=at;return PORT_F11_IOC_OK;
+}
diff --git a/src/vms_f11_ioc_stage.c b/src/vms_f11_ioc_stage.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_stage.c
@@ -0,0 +1,26 @@
+#include "vms_f11_ioc.h"
+/* M181: private EXE$INSIOQ staging, never publishes DQA0 DDT. */
+uint32_t port_f11_ioc_stage(struct port_f11_ioc_file *f){
+ if(!f||!f->queue||!f->chain)return PORT_F11_IOC_BAD;
+ if(f->pending)return PORT_F11_IOC_BUSY;
+ if(f->next_tag==UINT32_MAX)return PORT_F11_IOC_BAD;
+ /* This bridge owns the IOC queue for its whole sector transaction.
+  * Do not steal completions from other requestors. */
+ if(f->queue->active!=PORT_DQ_IOC_DEPTH)return PORT_F11_IOC_BUSY;
+ for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++)
+  if(f->queue->packets[i].state!=PORT_DQ_IOC_EMPTY)
+   return PORT_F11_IOC_BUSY;
+ uint32_t lbn=0,within=0;
+ uint32_t st=port_f11_ioc_locate(f,&lbn,&within);
+ if(st!=PORT_F11_IOC_OK)return st;
+ st=port_dq_ioc_prepare(f->queue,f->next_tag,lbn,f->sector,512u);
+ if(st!=PORT_DQ_IOC_OK)return PORT_F11_IOC_BUSY;
+ st=port_dq_ioc_enqueue(f->queue,f->next_tag);
+ if(st!=PORT_DQ_IOC_OK){
+  (void)port_dq_ioc_cancel(f->queue,f->next_tag);
+  return PORT_F11_IOC_BUSY;
+ }
+ f->pending=1;f->pending_tag=f->next_tag;
+ f->pending_within=within;f->next_tag++;
+ return PORT_F11_IOC_OK;
+}
diff --git a/src/vms_f11_ioc_validate.c b/src/vms_f11_ioc_validate.c
new file mode 100644
--- /dev/null
+++ b/src/vms_f11_ioc_validate.c
@@ -0,0 +1,15 @@
+#include "vms_f11_ioc.h"
+/* M178: cursor and IOC packet remain owned by the same supervisor file. */
+uint32_t port_f11_ioc_validate(const struct port_f11_ioc_file *f){
+ if(!f||!f->chain||!f->queue||f->position>f->length||
+    !f->next_tag||f->pending>1u||
+    port_dq_ioc_validate(f->queue)!=PORT_DQ_IOC_OK)
+  return PORT_F11_IOC_BAD;
+ if(!f->pending)return f->pending_tag?PORT_F11_IOC_BAD:PORT_F11_IOC_OK;
+ if(!f->pending_tag||f->pending_within>=512u)return PORT_F11_IOC_BAD;
+ uint32_t found=0;
+ for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++)
+  if(f->queue->packets[i].state!=PORT_DQ_IOC_EMPTY&&
+     f->queue->packets[i].tag==f->pending_tag)found++;
+ return found==1u?PORT_F11_IOC_OK:PORT_F11_IOC_BAD;
+}
