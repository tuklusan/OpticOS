diff --git a/src/vms_dq_ioc_attempt.c b/src/vms_dq_ioc_attempt.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_attempt.c
@@ -0,0 +1,12 @@
+#include "vms_dq_ioc.h"
+/* One actual hardware read attempt. The destination is untouched until IOC post.
+ * Overflow of the per-packet attempt counter is rejected before hardware I/O. */
+uint32_t port_dq_ioc_attempt(struct port_dq_ioc_queue *q){
+ if(!q||!q->read_sector)return PORT_DQ_IOC_BAD;
+ if(q->active>=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+ struct port_dq_ioc_packet *p=&q->packets[q->active];
+ if(p->state!=PORT_DQ_IOC_ACTIVE)return PORT_DQ_IOC_BUSY;
+ if(p->attempts==UINT8_MAX)return PORT_DQ_IOC_CORRUPT;
+ p->attempts++;
+ return port_dq_ioc_transfer(q);
+}
diff --git a/src/vms_dq_ioc_iosb.c b/src/vms_dq_ioc_iosb.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_iosb.c
@@ -0,0 +1,15 @@
+#include "vms_dq_ioc.h"
+/* DQ FUNCXT: completion status and actual byte count in two IOSB words.
+ * Status 1 = source SS$_NORMAL, failure 10 is local and never VMS-facing. */
+uint32_t port_dq_ioc_iosb(const struct port_dq_ioc_queue *q,
+                           struct port_dq_ioc_iosb *iosb){
+ if(!q||!iosb)return PORT_DQ_IOC_BAD;
+ if(q->active>=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+ const struct port_dq_ioc_packet *p=&q->packets[q->active];
+ if(p->state!=PORT_DQ_IOC_FINISHED&&p->state!=PORT_DQ_IOC_FAILED)
+  return PORT_DQ_IOC_BUSY;
+ *iosb=(struct port_dq_ioc_iosb){p->tag,
+  p->state==PORT_DQ_IOC_FINISHED?PORT_DQ_IOC_OK:PORT_DQ_IOC_IO,
+  p->state==PORT_DQ_IOC_FINISHED?512u:0u};
+ return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_post.c b/src/vms_dq_ioc_post.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_post.c
@@ -0,0 +1,15 @@
+#include "vms_dq_ioc.h"
+/* IOCIOPOST: copy final status before retiring IRP; one post per request.
+ * Successful packets alone publish 512 bytes to caller's destination. */
+uint32_t port_dq_ioc_post(struct port_dq_ioc_queue *q,
+                           struct port_dq_ioc_iosb *iosb){
+ if(!q||!iosb||q->posted==UINT32_MAX)return PORT_DQ_IOC_BAD;
+ struct port_dq_ioc_iosb candidate;
+ uint32_t st=port_dq_ioc_iosb(q,&candidate);
+ if(st!=PORT_DQ_IOC_OK)return st;
+ uint32_t tag=0;
+ st=port_dq_ioc_complete(q,&tag);
+ if(tag!=candidate.tag)return PORT_DQ_IOC_CORRUPT;
+ q->posted++;*iosb=candidate;
+ return st;
+}
diff --git a/src/vms_dq_ioc_recover.c b/src/vms_dq_ioc_recover.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_recover.c
@@ -0,0 +1,13 @@
+#include "vms_dq_ioc.h"
+/* RETRYERR: decrement error count, return to dispatch only if retries remain.
+ * A real RB730 would issue F_RECAL; IA-32 ATA reset/IRQ remains unported. */
+uint32_t port_dq_ioc_recover(struct port_dq_ioc_queue *q){
+ if(!q)return PORT_DQ_IOC_BAD;
+ if(q->active>=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+ struct port_dq_ioc_packet *p=&q->packets[q->active];
+ if(p->state!=PORT_DQ_IOC_FAILED)return PORT_DQ_IOC_BUSY;
+ if(!p->retries_remaining)return PORT_DQ_IOC_IO;
+ if(q->retried==UINT32_MAX)return PORT_DQ_IOC_CORRUPT;
+ p->retries_remaining--;q->retried++;p->state=PORT_DQ_IOC_ACTIVE;
+ return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_retry.c b/src/vms_dq_ioc_retry.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_retry.c
@@ -0,0 +1,20 @@
+#include "vms_dq_ioc.h"
+/* CHECKECC -> RETRYERR: bounded attempts on the currently active physical IRP.
+ * No ECC synthesis or RB730 recalibrate; every retry invokes the real ATA callback. */
+uint32_t port_dq_ioc_retry(struct port_dq_ioc_queue *q){
+ if(!q)return PORT_DQ_IOC_BAD;
+ if(q->active>=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+ struct port_dq_ioc_packet *p=&q->packets[q->active];
+ if(p->state!=PORT_DQ_IOC_ACTIVE&&p->state!=PORT_DQ_IOC_FAILED)
+  return PORT_DQ_IOC_BUSY;
+ for(unsigned n=0;n<=PORT_DQ_IOC_MAX_RETRIES;n++){
+  if(p->state==PORT_DQ_IOC_FAILED){
+   uint32_t st=port_dq_ioc_recover(q);
+   if(st!=PORT_DQ_IOC_OK)return st;
+  }
+  uint32_t st=port_dq_ioc_attempt(q);
+  if(st==PORT_DQ_IOC_OK)return st;
+  if(st!=PORT_DQ_IOC_IO)return st;
+ }
+ return PORT_DQ_IOC_CORRUPT;
+}diff --git a/src/vms_dq_ioc_run.c b/src/vms_dq_ioc_run.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_run.c
@@ -0,0 +1,22 @@
+#include "vms_dq_ioc.h"
+/* Drain bounded IOC queue in FIFO order; error posting does not suppress later
+ * unrelated IRPs. The report is committed only after the complete drain. */
+uint32_t port_dq_ioc_run(struct port_dq_ioc_queue *q,
+                          struct port_dq_ioc_report *report){
+ if(!q||!report)return PORT_DQ_IOC_BAD;
+ if(q->active!=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_BUSY;
+ struct port_dq_ioc_report r={0};uint32_t before=q->reads;
+ for(unsigned n=0;n<PORT_DQ_IOC_DEPTH;n++){
+  struct port_dq_ioc_iosb iosb;
+  uint32_t st=port_dq_ioc_service(q,&iosb);
+  if(st==PORT_DQ_IOC_NOTFOUND)break;
+  if(st!=PORT_DQ_IOC_OK&&st!=PORT_DQ_IOC_IO)return st;
+  r.processed++;
+  if(st==PORT_DQ_IOC_OK)r.succeeded++;else r.failed++;
+ }
+ for(unsigned n=0;n<PORT_DQ_IOC_DEPTH;n++)
+  if(q->packets[n].state==PORT_DQ_IOC_QUEUED)
+   return PORT_DQ_IOC_CORRUPT;
+ r.reads=q->reads-before;*report=r;
+ return r.failed?PORT_DQ_IOC_IO:PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_service.c b/src/vms_dq_ioc_service.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_service.c
@@ -0,0 +1,12 @@
+#include "vms_dq_ioc.h"
+/* EXE$INSIOQ -> DQ_STARTIO -> RETRYERR -> FUNCXT -> IOCIOPOST.
+ * Exactly one oldest queued request, retaining permanent failures as IOSB. */
+uint32_t port_dq_ioc_service(struct port_dq_ioc_queue *q,
+                              struct port_dq_ioc_iosb *iosb){
+ if(!q||!iosb)return PORT_DQ_IOC_BAD;
+ uint32_t tag=0,st=port_dq_ioc_start(q,&tag);
+ if(st!=PORT_DQ_IOC_OK)return st;
+ st=port_dq_ioc_retry(q);
+ if(st!=PORT_DQ_IOC_OK&&st!=PORT_DQ_IOC_IO)return st;
+ return port_dq_ioc_post(q,iosb);
+}
diff --git a/src/vms_dq_ioc_set_retry.c b/src/vms_dq_ioc_set_retry.c
new file mode 100644
--- /dev/null
+++ b/src/vms_dq_ioc_set_retry.c
@@ -0,0 +1,13 @@
+#include "vms_dq_ioc.h"
+/* RETRYERR initializes the UCB error retry budget before dispatch.
+ * Only a prepared IRP can have its retry policy changed. */
+uint32_t port_dq_ioc_set_retry(struct port_dq_ioc_queue *q,uint32_t tag,uint8_t limit){
+ if(!q||!tag||limit>PORT_DQ_IOC_MAX_RETRIES)return PORT_DQ_IOC_BAD;
+ for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+  struct port_dq_ioc_packet *p=&q->packets[i];
+  if(p->state==PORT_DQ_IOC_EMPTY||p->tag!=tag)continue;
+  if(p->state!=PORT_DQ_IOC_PREPARED)return PORT_DQ_IOC_BUSY;
+  p->retry_limit=limit;p->retries_remaining=limit;return PORT_DQ_IOC_OK;
+ }
+ return PORT_DQ_IOC_NOTFOUND;
+}
