diff --git a/src/vms_dq_ioc.h b/src/vms_dq_ioc.h
--- /dev/null
+++ b/src/vms_dq_ioc.h
@@ -0,0 +1,41 @@
+#ifndef VMS37_NATIVE_DQ_IOC_H
+#define VMS37_NATIVE_DQ_IOC_H
+#include <stdint.h>
+#include <stddef.h>
+/* DRIVER/SRC/DQDRIVER.MAR DQ_STARTIO/PREPROCESS/FDISPATCH/FUNCXT
+ * and SYS/SRC/IOCIOPOST.MAR I/O packet queue and completion ordering.
+ * Bounded, private supervisor physical READPBLK bridge. No public $QIO,
+ * DDT publishing, process AST, ACP, cancellation of a running IRP, or IRQ. */
+#define PORT_DQ_IOC_DEPTH 8u
+enum { PORT_DQ_IOC_OK=1u,PORT_DQ_IOC_BAD=2u,
+       PORT_DQ_IOC_FULL=4u,PORT_DQ_IOC_BUSY=6u,
+       PORT_DQ_IOC_NOTFOUND=8u,PORT_DQ_IOC_IO=10u,
+       PORT_DQ_IOC_CORRUPT=12u };
+enum { PORT_DQ_IOC_EMPTY=0u,PORT_DQ_IOC_PREPARED=1u,
+       PORT_DQ_IOC_QUEUED=2u,PORT_DQ_IOC_ACTIVE=3u,
+       PORT_DQ_IOC_FINISHED=4u,PORT_DQ_IOC_FAILED=5u };
+typedef uint32_t (*port_dq_ioc_sector_fn)(void *,uint32_t,uint8_t [512]);
+struct port_dq_ioc_packet {
+    uint32_t tag,lbn,order;
+    uint8_t *destination;
+    uint8_t state;
+    uint8_t reserved[3];
+    uint8_t sector[512];
+};
+struct port_dq_ioc_queue {
+    struct port_dq_ioc_packet packets[PORT_DQ_IOC_DEPTH];
+    port_dq_ioc_sector_fn read_sector;
+    void *context;
+    uint32_t order,submitted,completed,failed,reads,active;
+};
+uint32_t port_dq_ioc_init(struct port_dq_ioc_queue *,
+                           port_dq_ioc_sector_fn,void *);
+uint32_t port_dq_ioc_validate(const struct port_dq_ioc_queue *);
+uint32_t port_dq_ioc_prepare(struct port_dq_ioc_queue *,
+                           uint32_t,uint32_t,uint8_t *,size_t);
+uint32_t port_dq_ioc_enqueue(struct port_dq_ioc_queue *,uint32_t);
+uint32_t port_dq_ioc_start(struct port_dq_ioc_queue *,uint32_t *);
+uint32_t port_dq_ioc_transfer(struct port_dq_ioc_queue *);
+uint32_t port_dq_ioc_complete(struct port_dq_ioc_queue *,uint32_t *);
+uint32_t port_dq_ioc_cancel(struct port_dq_ioc_queue *,uint32_t);
+#endif
diff --git a/src/vms_dq_ioc_init.c b/src/vms_dq_ioc_init.c
--- /dev/null
+++ b/src/vms_dq_ioc_init.c
@@ -0,0 +1,11 @@
+#include "vms_dq_ioc.h"
+/* M161: construct an empty IOC physical-device queue in supervisor RAM.
+ * Never publishes the private device or binds the source DDT. */
+uint32_t port_dq_ioc_init(struct port_dq_ioc_queue *q,
+                         port_dq_ioc_sector_fn fn,void *context){
+    if(!q||!fn)return PORT_DQ_IOC_BAD;
+    *q=(struct port_dq_ioc_queue){0};
+    q->read_sector=fn;q->context=context;
+    q->active=PORT_DQ_IOC_DEPTH;
+    return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_validate.c b/src/vms_dq_ioc_validate.c
--- /dev/null
+++ b/src/vms_dq_ioc_validate.c
@@ -0,0 +1,25 @@
+#include "vms_dq_ioc.h"
+/* M162: validate in-memory IOC ownership and single active IRP invariant. */
+uint32_t port_dq_ioc_validate(const struct port_dq_ioc_queue *q){
+    if(!q||!q->read_sector||q->active>PORT_DQ_IOC_DEPTH||
+       q->completed+q->failed>q->submitted)return PORT_DQ_IOC_BAD;
+    unsigned active=0u;
+    for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+        const struct port_dq_ioc_packet *p=&q->packets[i];
+        if(p->state>PORT_DQ_IOC_FAILED)return PORT_DQ_IOC_CORRUPT;
+        if(p->state==PORT_DQ_IOC_EMPTY)continue;
+        if(!p->tag||!p->destination||p->lbn>=0x10000000u||
+           !p->order)return PORT_DQ_IOC_CORRUPT;
+        active+=p->state==PORT_DQ_IOC_ACTIVE;
+        for(unsigned j=i+1;j<PORT_DQ_IOC_DEPTH;j++){
+            const struct port_dq_ioc_packet *other=&q->packets[j];
+            if(other->state!=PORT_DQ_IOC_EMPTY&&
+               (other->tag==p->tag||other->order==p->order))
+                return PORT_DQ_IOC_CORRUPT;
+        }
+    }
+    if(active>1u|| (q->active==PORT_DQ_IOC_DEPTH)!=(active==0u)||
+       (active&&q->packets[q->active].state!=PORT_DQ_IOC_ACTIVE))
+        return PORT_DQ_IOC_CORRUPT;
+    return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_prepare.c b/src/vms_dq_ioc_prepare.c
--- /dev/null
+++ b/src/vms_dq_ioc_prepare.c
@@ -0,0 +1,19 @@
+#include "vms_dq_ioc.h"
+/* M163: DQ PREPROCESS, physical media field and request ID preflight. */
+uint32_t port_dq_ioc_prepare(struct port_dq_ioc_queue *q,uint32_t tag,
+                            uint32_t lbn,uint8_t *dst,size_t capacity){
+    if(!q||!q->read_sector||!tag||!dst||capacity<512u||
+       lbn>=0x10000000u||q->order==UINT32_MAX)return PORT_DQ_IOC_BAD;
+    unsigned free_at=PORT_DQ_IOC_DEPTH;
+    for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+        if(q->packets[i].state==PORT_DQ_IOC_EMPTY){
+            if(free_at==PORT_DQ_IOC_DEPTH)free_at=i;
+        }else if(q->packets[i].tag==tag)return PORT_DQ_IOC_BUSY;
+    }
+    if(free_at==PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_FULL;
+    struct port_dq_ioc_packet *p=&q->packets[free_at];
+    *p=(struct port_dq_ioc_packet){0};
+    p->tag=tag;p->lbn=lbn;p->destination=dst;
+    p->order=++q->order;p->state=PORT_DQ_IOC_PREPARED;
+    return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_enqueue.c b/src/vms_dq_ioc_enqueue.c
--- /dev/null
+++ b/src/vms_dq_ioc_enqueue.c
@@ -0,0 +1,14 @@
+#include "vms_dq_ioc.h"
+/* M164: source EXE$INSIOQ/IOC post queue order, no AST or user IRP. */
+uint32_t port_dq_ioc_enqueue(struct port_dq_ioc_queue *q,uint32_t tag){
+    if(!q||!tag)return PORT_DQ_IOC_BAD;
+    for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+        struct port_dq_ioc_packet *p=&q->packets[i];
+        if(p->state!=PORT_DQ_IOC_EMPTY&&p->tag==tag){
+            if(p->state!=PORT_DQ_IOC_PREPARED)return PORT_DQ_IOC_BUSY;
+            p->state=PORT_DQ_IOC_QUEUED;q->submitted++;
+            return PORT_DQ_IOC_OK;
+        }
+    }
+    return PORT_DQ_IOC_NOTFOUND;
+}
diff --git a/src/vms_dq_ioc_start.c b/src/vms_dq_ioc_start.c
--- /dev/null
+++ b/src/vms_dq_ioc_start.c
@@ -0,0 +1,17 @@
+#include "vms_dq_ioc.h"
+/* M165: dispatch oldest queued IRP to original DQ_STARTIO state. */
+uint32_t port_dq_ioc_start(struct port_dq_ioc_queue *q,uint32_t *tag){
+    if(!q||!tag||!q->read_sector)return PORT_DQ_IOC_BAD;
+    if(q->active!=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_BUSY;
+    unsigned chosen=PORT_DQ_IOC_DEPTH;uint32_t order=UINT32_MAX;
+    for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+        const struct port_dq_ioc_packet *p=&q->packets[i];
+        if(p->state==PORT_DQ_IOC_QUEUED&&p->order<order){
+            chosen=i;order=p->order;
+        }
+    }
+    if(chosen==PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+    q->packets[chosen].state=PORT_DQ_IOC_ACTIVE;
+    q->active=chosen;*tag=q->packets[chosen].tag;
+    return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_transfer.c b/src/vms_dq_ioc_transfer.c
--- /dev/null
+++ b/src/vms_dq_ioc_transfer.c
@@ -0,0 +1,16 @@
+#include "vms_dq_ioc.h"
+/* M166: physical DQ read dispatch via real registered ATA callback.
+ * Scratch sector is never published on failed hardware transfer. */
+uint32_t port_dq_ioc_transfer(struct port_dq_ioc_queue *q){
+    if(!q||!q->read_sector)return PORT_DQ_IOC_BAD;
+    if(q->active>=PORT_DQ_IOC_DEPTH)return PORT_DQ_IOC_NOTFOUND;
+    struct port_dq_ioc_packet *p=&q->packets[q->active];
+    if(p->state!=PORT_DQ_IOC_ACTIVE)return PORT_DQ_IOC_CORRUPT;
+    uint8_t scratch[512];
+    const uint32_t st=q->read_sector(q->context,p->lbn,scratch);
+    q->reads++;
+    if(st!=1u){p->state=PORT_DQ_IOC_FAILED;return PORT_DQ_IOC_IO;}
+    for(unsigned i=0;i<512u;i++)p->sector[i]=scratch[i];
+    p->state=PORT_DQ_IOC_FINISHED;
+    return PORT_DQ_IOC_OK;
+}
diff --git a/src/vms_dq_ioc_complete.c b/src/vms_dq_ioc_complete.c
--- /dev/null
+++ b/src/vms_dq_ioc_complete.c
@@ -0,0 +1,19 @@
+#include "vms_dq_ioc.h"
+/* M167: source DQ FUNCXT/REQCOM: deliver exactly one final status.
+ * The caller's destination is mutated only after successful physical IO. */
+uint32_t port_dq_ioc_complete(struct port_dq_ioc_queue *q,uint32_t *tag){
+    if(!q||!tag||q->active>=PORT_DQ_IOC_DEPTH)
+        return PORT_DQ_IOC_BAD;
+    struct port_dq_ioc_packet *p=&q->packets[q->active];
+    if(p->state!=PORT_DQ_IOC_FINISHED&&p->state!=PORT_DQ_IOC_FAILED)
+        return PORT_DQ_IOC_BUSY;
+    const uint32_t st=p->state==PORT_DQ_IOC_FINISHED?
+        PORT_DQ_IOC_OK:PORT_DQ_IOC_IO;
+    *tag=p->tag;
+    if(st==PORT_DQ_IOC_OK){
+        for(unsigned i=0;i<512u;i++)p->destination[i]=p->sector[i];
+        q->completed++;
+    }else q->failed++;
+    *p=(struct port_dq_ioc_packet){0};q->active=PORT_DQ_IOC_DEPTH;
+    return st;
+}
diff --git a/src/vms_dq_ioc_cancel.c b/src/vms_dq_ioc_cancel.c
--- /dev/null
+++ b/src/vms_dq_ioc_cancel.c
@@ -0,0 +1,18 @@
+#include "vms_dq_ioc.h"
+/* M168: remove an unissued IRP; reject cancellation after DQ_STARTIO. */
+uint32_t port_dq_ioc_cancel(struct port_dq_ioc_queue *q,uint32_t tag){
+    if(!q||!tag)return PORT_DQ_IOC_BAD;
+    for(unsigned i=0;i<PORT_DQ_IOC_DEPTH;i++){
+        struct port_dq_ioc_packet *p=&q->packets[i];
+        if(p->state!=PORT_DQ_IOC_EMPTY&&p->tag==tag){
+            if(p->state!=PORT_DQ_IOC_PREPARED&&
+               p->state!=PORT_DQ_IOC_QUEUED)return PORT_DQ_IOC_BUSY;
+            if(p->state==PORT_DQ_IOC_QUEUED){
+                if(!q->submitted)return PORT_DQ_IOC_CORRUPT;
+                q->submitted--; /* cancelled before device ownership */
+            }
+            *p=(struct port_dq_ioc_packet){0};return PORT_DQ_IOC_OK;
+        }
+    }
+    return PORT_DQ_IOC_NOTFOUND;
+}
