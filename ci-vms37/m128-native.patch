diff --git a/src/vms_log_copy_result.c b/src/vms_log_copy_result.c
new file mode 100644
index 0000000..3799929
--- /dev/null
+++ b/src/vms_log_copy_result.c
@@ -0,0 +1,18 @@
+#include "vms_log_system.h"
+/* LOG$TRANSLATE lines 404-411: length is returned even if buffer too
+ * small. Do NOT partially write, do not silently truncate a logical name. */
+uint32_t port_log_copy_result(const uint8_t *from,size_t needed,
+    uint8_t *to,size_t capacity,uint32_t status,uint32_t source_address,
+    uint8_t access_mode,struct port_log_result *out){
+    if(!from||!to||!out||needed>PORT_LOG_MAX_NAME||
+       (status!=PORT_LOG_OK&&status!=PORT_LOG_NOTRAN))return PORT_LOG_BAD;
+    struct port_log_result result={.status=status,
+        .record_address=source_address,.bytes=(uint16_t)needed,
+        .table=(uint8_t)(status==PORT_LOG_OK?PORT_LOG_SYSTEM:0u),
+        .access_mode=access_mode};
+    if(needed>capacity){result.status=PORT_LOG_OVERFLOW;*out=result;
+        return PORT_LOG_OVERFLOW;}
+    for(size_t i=0u;i<needed;i++)to[i]=from[i];
+    *out=result;
+    return status;
+}
diff --git a/src/vms_log_hash.c b/src/vms_log_hash.c
new file mode 100644
index 0000000..974df09
--- /dev/null
+++ b/src/vms_log_hash.c
@@ -0,0 +1,20 @@
+#include "vms_log_system.h"
+/* LOGNAMSUB.MAR LOG$HASH, lines 275-303: VAX little-endian XOR longword,
+ * ROTL 9 for full words, ROTL 13 for remaining bytes, MULL 0x71279461,
+ * ASHQ obtains high hash_bits of low-32-bit multiplication product. */
+static uint32_t rotate(uint32_t x,unsigned n){return (x<<n)|(x>>(32u-n));}
+uint32_t port_log_hash(const uint8_t *name,size_t length,unsigned bits){
+    if(!name||!length||length>PORT_LOG_MAX_NAME||bits>PORT_LOG_BITS)
+        return UINT32_MAX;
+    uint32_t value=(uint32_t)length;
+    size_t i=0u;
+    for(;i+4u<=length;i+=4u){
+        const uint32_t word=(uint32_t)name[i]|
+           ((uint32_t)name[i+1u]<<8)|((uint32_t)name[i+2u]<<16)|
+           ((uint32_t)name[i+3u]<<24);
+        value=rotate(value^word,9u);
+    }
+    for(;i<length;i++)value=rotate(value^name[i],13u);
+    value*=UINT32_C(0x71279461);
+    return bits?value>>(32u-bits):0u;
+}
diff --git a/src/vms_log_name_compare.c b/src/vms_log_name_compare.c
new file mode 100644
index 0000000..ed8d60b
--- /dev/null
+++ b/src/vms_log_name_compare.c
@@ -0,0 +1,13 @@
+#include "vms_log_system.h"
+/* Original LOG$SEARCHLOG bucket walks sorted by string length then name.
+ * Return 0=less, 1=equal, 2=greater (unsigned VAX CMPC order). */
+uint32_t port_log_name_compare(const uint8_t *a,size_t na,
+                               const uint8_t *b,size_t nb){
+    if(na<nb)return 0u;
+    if(na>nb)return 2u;
+    for(size_t i=0u;i<na;i++){
+        if(a[i]<b[i])return 0u;
+        if(a[i]>b[i])return 2u;
+    }
+    return 1u;
+}
diff --git a/src/vms_log_record_valid.c b/src/vms_log_record_valid.c
new file mode 100644
index 0000000..49f273f
--- /dev/null
+++ b/src/vms_log_record_valid.c
@@ -0,0 +1,15 @@
+#include "vms_log_system.h"
+/* LOGNAMSUB.MAR LOG$SEARCHLOG source record layout from SYSDEF.MDL.
+ * Validate the original ASCIC name and actual staged equivalence bounds.
+ * Do not infer that any translated device is mounted or has a driver. */
+uint32_t port_log_record_valid(const uint8_t *r,size_t n,
+                              const char *name,size_t length){
+    if(!r||!name||!length||length>PORT_LOG_MAX_NAME||
+       n<PORT_LOG_REC_LEN||port_v37_read16(r+8u)!=PORT_LOG_REC_LEN||
+       r[10u]!=PORT_V37_DYN_LOG||r[11u]!=PORT_LOG_SYSTEM||
+       r[20u]!=length||21u+length+1u>PORT_LOG_REC_LEN||
+       r[21u+length]>PORT_LOG_REC_LEN-22u-length||
+       r[20u+length+1u]==0u)return PORT_LOG_BAD;
+    for(size_t i=0;i<length;i++)if(r[21u+i]!=(uint8_t)name[i])return PORT_LOG_BAD;
+    return PORT_LOG_OK;
+}
diff --git a/src/vms_log_source_addr.c b/src/vms_log_source_addr.c
new file mode 100644
index 0000000..a5e276b
--- /dev/null
+++ b/src/vms_log_source_addr.c
@@ -0,0 +1,11 @@
+#include "vms_log_system.h"
+/* SYSDEF.MDL stores physical native 32-bit addresses, never host indexes. */
+uint32_t port_log_source_address(const struct port_log_system_table *t,
+    const uint8_t *r,uint32_t *out){
+    if(!t||!r||!out)return PORT_LOG_BAD;
+    for(unsigned i=0u;i<2u;i++)
+        if(t->records[i]==r&&t->record_addr[i]){
+            *out=t->record_addr[i];return PORT_LOG_OK;
+        }
+    return PORT_LOG_BAD;
+}
diff --git a/src/vms_log_source_record.c b/src/vms_log_source_record.c
new file mode 100644
index 0000000..39bdb25
--- /dev/null
+++ b/src/vms_log_source_record.c
@@ -0,0 +1,10 @@
+#include "vms_log_system.h"
+/* Never dereference untrusted list pointers; map only the two source
+ * records published after actual SYS.EXE FIN_DATABASE validation. */
+uint8_t *port_log_source_record(const struct port_log_system_table *t,
+                                uint32_t address){
+    if(!t||!address)return 0;
+    for(unsigned i=0u;i<2u;i++)
+        if(t->record_addr[i]==address)return t->records[i];
+    return 0;
+}
diff --git a/src/vms_log_system.h b/src/vms_log_system.h
new file mode 100644
index 0000000..128f2fa
--- /dev/null
+++ b/src/vms_log_system.h
@@ -0,0 +1,44 @@
+#ifndef VMS_LOG_SYSTEM_H
+#define VMS_LOG_SYSTEM_H
+#include <stdint.h>
+#include <stddef.h>
+#include "vms_ini_fin_database.h"
+/* Source LOGNAMSUB.MAR LOG$HASH/SEARCHLOG/INSLOGN/TRANSLATE subset.
+ * Resident bootstrap SYSTEM names only; process/group tables, mutexes,
+ * general service entry and system SYSLOGNAM are NOT implemented. */
+enum { PORT_LOG_OK=1u,PORT_LOG_BAD=2u,PORT_LOG_NOTRAN=3u,
+       PORT_LOG_OVERFLOW=4u,PORT_LOG_CYCLE=6u,
+       PORT_LOG_SLOTS=16u,PORT_LOG_BITS=4u,
+       PORT_LOG_SYSTEM=0u,PORT_LOG_MAX_NAME=63u,
+       PORT_LOG_REC_LEN=PORT_INI_LOG_TEMPLATE_BYTES };
+struct port_log_system_table {
+    uint32_t head[PORT_LOG_SLOTS]; /* resident native bucket heads */
+    uint32_t record_addr[2]; /* original 32-bit LOG$L_LTFL addresses */
+    uint8_t *records[2]; /* host/guest native addresses for bounded walking */
+    uint8_t hash_bits,ready;
+    uint16_t count;
+};
+struct port_log_result {
+    uint32_t status,record_address;
+    uint16_t bytes;
+    uint8_t table,access_mode;
+};
+uint32_t port_log_hash(const uint8_t *,size_t,unsigned);
+uint32_t port_log_record_valid(const uint8_t *,size_t,const char *,size_t);
+uint32_t port_log_system_validate(const struct port_log_system_table *,
+    uint8_t *,uint8_t *,size_t);
+uint32_t port_log_name_compare(const uint8_t *,size_t,const uint8_t *,size_t);
+uint32_t port_log_source_address(const struct port_log_system_table *,
+    const uint8_t *,uint32_t *);
+uint8_t *port_log_source_record(const struct port_log_system_table *,uint32_t);
+uint32_t port_log_system_insert(struct port_log_system_table *,unsigned);
+uint32_t port_log_system_init(struct port_log_system_table *,
+    uint8_t *,uint8_t *,size_t,unsigned);
+uint32_t port_log_system_lookup(const struct port_log_system_table *,
+    const uint8_t *,size_t,uint32_t *);
+uint32_t port_log_system_check(const struct port_log_system_table *);
+uint32_t port_log_copy_result(const uint8_t *,size_t,uint8_t *,size_t,
+    uint32_t,uint32_t,uint8_t,struct port_log_result *);
+uint32_t port_log_translate(const struct port_log_system_table *,
+    const char *,size_t,uint32_t,uint8_t *,size_t,struct port_log_result *);
+#endif
diff --git a/src/vms_log_system_check.c b/src/vms_log_system_check.c
new file mode 100644
index 0000000..729e295
--- /dev/null
+++ b/src/vms_log_system_check.c
@@ -0,0 +1,31 @@
+#include "vms_log_system.h"
+/* Independently validate every native bucket and both source record links.
+ * No silent cycle, alias, false DDT or system-wide publication permitted. */
+uint32_t port_log_system_check(const struct port_log_system_table *t){
+    if(!t||!t->ready||t->count!=2u||t->hash_bits>PORT_LOG_BITS||
+       !t->records[0]||!t->records[1]||
+       t->record_addr[0]==0u||t->record_addr[1]==0u||
+       t->record_addr[0]==t->record_addr[1])return PORT_LOG_BAD;
+    unsigned seen=0u;
+    for(unsigned slot=0u;slot<PORT_LOG_SLOTS;slot++){
+        uint32_t last=(uint32_t)(uintptr_t)&t->head[slot];
+        uint32_t cur=t->head[slot];
+        unsigned steps=0u;
+        if(slot>=(1u<<t->hash_bits)&&cur)return PORT_LOG_CYCLE;
+        while(cur){
+            if(++steps>2u)return PORT_LOG_CYCLE;
+            uint8_t *r=port_log_source_record(t,cur);
+            if(!r||r[11u]!=PORT_LOG_SYSTEM||r[10u]!=PORT_V37_DYN_LOG||
+               port_v37_read16(r+8u)!=PORT_LOG_REC_LEN||
+               22u+(size_t)r[20u]>PORT_LOG_REC_LEN||
+               port_v37_read32(r+4u)!=last||
+               port_log_hash(r+21u,r[20u],t->hash_bits)!=slot)
+                return PORT_LOG_CYCLE;
+            const unsigned index=(cur==t->record_addr[0])?0u:1u;
+            if((seen&(1u<<index))!=0u)return PORT_LOG_CYCLE;
+            seen|=(1u<<index);
+            last=cur;cur=port_v37_read32(r);
+        }
+    }
+    return seen==3u?PORT_LOG_OK:PORT_LOG_CYCLE;
+}
diff --git a/src/vms_log_system_init.c b/src/vms_log_system_init.c
new file mode 100644
index 0000000..fe95d52
--- /dev/null
+++ b/src/vms_log_system_init.c
@@ -0,0 +1,30 @@
+#include "vms_log_system.h"
+/* Publish two FIN_DATABASE records in a private read-only SYSTEM table.
+ * This is only original initial-name lookup, NOT $CRELNM or global LOG$HASH
+ * linkage; real scheduler/mutex/group/process table services remain absent. */
+uint32_t port_log_system_init(struct port_log_system_table *t,
+    uint8_t *disk,uint8_t *sysdev,size_t bytes,unsigned hash_bits){
+    if(hash_bits>PORT_LOG_BITS||
+       port_log_system_validate(t,disk,sysdev,bytes)!=PORT_LOG_OK)
+        return PORT_LOG_BAD;
+    const uint32_t a=(uint32_t)(uintptr_t)disk,b=(uint32_t)(uintptr_t)sysdev;
+    if(!a||!b||a==b)return PORT_LOG_BAD;
+    const unsigned ah=port_log_hash(disk+21u,8u,hash_bits);
+    const unsigned bh=port_log_hash(sysdev+21u,13u,hash_bits);
+    if(ah>=PORT_LOG_SLOTS||bh>=PORT_LOG_SLOTS)return PORT_LOG_BAD;
+    /* No address truncation ambiguity with the two source LOG records. */
+    for(unsigned i=0u;i<(1u<<hash_bits);i++){
+        const uint32_t head=(uint32_t)(uintptr_t)&t->head[i];
+        if(!head||head==a||head==b)return PORT_LOG_BAD;
+    }
+    t->record_addr[0]=a;t->record_addr[1]=b;
+    t->records[0]=disk;t->records[1]=sysdev;
+    t->hash_bits=(uint8_t)hash_bits;
+    if(port_log_system_insert(t,0u)!=PORT_LOG_OK||
+       port_log_system_insert(t,1u)!=PORT_LOG_OK)return PORT_LOG_CYCLE;
+    t->count=2u;t->ready=1u;
+    if(port_log_system_check(t)!=PORT_LOG_OK){
+        t->ready=0u;return PORT_LOG_CYCLE;
+    }
+    return PORT_LOG_OK;
+}
diff --git a/src/vms_log_system_insert.c b/src/vms_log_system_insert.c
new file mode 100644
index 0000000..aa683f1
--- /dev/null
+++ b/src/vms_log_system_insert.c
@@ -0,0 +1,33 @@
+#include "vms_log_system.h"
+/* LOG$INSLOGN_LCK: insert in the hash bucket sorted by name length and
+ * unsigned lexical order. LOG$L_LTFL and LOG$L_LTBL are original 32-bit
+ * physical native links; no process or group lock is fabricated. */
+uint32_t port_log_system_insert(struct port_log_system_table *t,unsigned idx){
+    if(!t||idx>=2u||!t->records[idx]||!t->record_addr[idx]||
+       t->hash_bits>PORT_LOG_BITS)return PORT_LOG_BAD;
+    uint8_t *const rec=t->records[idx];const size_t len=rec[20u];
+    const uint32_t bucket=port_log_hash(rec+21u,len,t->hash_bits);
+    if(bucket>=PORT_LOG_SLOTS)return PORT_LOG_BAD;
+    uint32_t *prev=&t->head[bucket];
+    uint32_t prev_addr=(uint32_t)(uintptr_t)prev;
+    uint32_t next=*prev;
+    for(unsigned count=0u;next;count++){
+        if(count>=2u)return PORT_LOG_CYCLE;
+        uint8_t *other=port_log_source_record(t,next);
+        if(!other || other==rec)return PORT_LOG_CYCLE;
+        if(port_log_name_compare(other+21u,other[20u],rec+21u,len)!=0u)
+            break;
+        prev_addr=next;
+        prev=(uint32_t *)(void *)other;
+        next=*prev;
+    }
+    port_v37_write32(rec,next);
+    port_v37_write32(rec+4u,prev_addr);
+    if(next){
+        uint8_t *other=port_log_source_record(t,next);
+        if(!other)return PORT_LOG_CYCLE;
+        port_v37_write32(other+4u,t->record_addr[idx]);
+    }
+    *prev=t->record_addr[idx];
+    return PORT_LOG_OK;
+}
diff --git a/src/vms_log_system_lookup.c b/src/vms_log_system_lookup.c
new file mode 100644
index 0000000..72134fd
--- /dev/null
+++ b/src/vms_log_system_lookup.c
@@ -0,0 +1,23 @@
+#include "vms_log_system.h"
+/* LOG$SEARCHLOG: bounded SYSTEM-table source hash-chain search. The VMS
+ * process/group priority and original LOG$LOCKR mutex remain unimplemented. */
+uint32_t port_log_system_lookup(const struct port_log_system_table *t,
+    const uint8_t *name,size_t n,uint32_t *found){
+    if(!t||!t->ready||t->count!=2u||!found||!name||
+       n==0u||n>PORT_LOG_MAX_NAME)return PORT_LOG_BAD;
+    const uint32_t bucket=port_log_hash(name,n,t->hash_bits);
+    if(bucket>=PORT_LOG_SLOTS)return PORT_LOG_BAD;
+    uint32_t record=t->head[bucket];
+    for(unsigned count=0u;record;count++){
+        if(count>=2u)return PORT_LOG_CYCLE;
+        uint8_t *r=port_log_source_record(t,record);
+        if(!r||r[10u]!=PORT_V37_DYN_LOG||r[11u]!=PORT_LOG_SYSTEM||
+           r[20u]>PORT_LOG_MAX_NAME||
+           22u+(size_t)r[20u]>PORT_LOG_REC_LEN)return PORT_LOG_CYCLE;
+        const uint32_t c=port_log_name_compare(r+21u,r[20u],name,n);
+        if(c==1u){*found=record;return PORT_LOG_OK;}
+        if(c==2u)break;
+        record=port_v37_read32(r);
+    }
+    return PORT_LOG_NOTRAN;
+}
diff --git a/src/vms_log_system_validate.c b/src/vms_log_system_validate.c
new file mode 100644
index 0000000..c2afe3b
--- /dev/null
+++ b/src/vms_log_system_validate.c
@@ -0,0 +1,31 @@
+#include "vms_log_system.h"
+/* Do not publish a logical name unless both exact source-size records
+ * were filled by FIN_DATABASE, without an active QIO or disk DDT. */
+static int disjoint(const void *a,size_t x,const void *b,size_t y){
+    const uintptr_t p=(uintptr_t)a,q=(uintptr_t)b;
+    return x<=UINTPTR_MAX-p&&y<=UINTPTR_MAX-q&&
+           (p+x<=q||q+y<=p);
+}
+static int exact(const uint8_t *r,size_t at,const char *s,unsigned n){
+    if(r[at-1u]!=n)return 0;
+    for(unsigned i=0u;i<n;i++)if(r[at+i]!=(uint8_t)s[i])return 0;
+    return 1;
+}
+uint32_t port_log_system_validate(const struct port_log_system_table *t,
+     uint8_t *disk,uint8_t *sysdev,size_t bytes){
+    if(!t||!disk||!sysdev||bytes<PORT_LOG_REC_LEN||t->ready||t->count||
+       !disjoint(t,sizeof *t,disk,PORT_LOG_REC_LEN)||
+       !disjoint(t,sizeof *t,sysdev,PORT_LOG_REC_LEN)||
+       !disjoint(disk,PORT_LOG_REC_LEN,sysdev,PORT_LOG_REC_LEN))return PORT_LOG_BAD;
+    for(unsigned i=0u;i<PORT_LOG_SLOTS;i++)if(t->head[i])return PORT_LOG_BAD;
+    if(port_log_record_valid(disk,bytes,"SYS$DISK",8u)!=PORT_LOG_OK||
+       port_log_record_valid(sysdev,bytes,"SYS$SYSDEVICE",13u)!=PORT_LOG_OK||
+       port_v37_read32(disk)!=0u||port_v37_read32(disk+4u)!=0u||
+       port_v37_read32(sysdev)!=0u||port_v37_read32(sysdev+4u)!=0u||
+       !exact(disk,30u,"_DQA0:",6u)||
+       !exact(sysdev,35u,"__DQA0:",7u)||
+       port_v37_read16(disk+12u)!=1u||port_v37_read16(sysdev+12u)!=1u||
+       port_v37_read16(disk+14u)!=1u||port_v37_read16(sysdev+14u)!=1u||
+       port_v37_read32(disk+16u)||port_v37_read32(sysdev+16u))return PORT_LOG_BAD;
+    return PORT_LOG_OK;
+}
diff --git a/src/vms_log_translate.c b/src/vms_log_translate.c
new file mode 100644
index 0000000..60a8b57
--- /dev/null
+++ b/src/vms_log_translate.c
@@ -0,0 +1,32 @@
+#include "vms_log_system.h"
+/* LOGNAMSUB.MAR LOG$TRANSLATE 373-420: a leading underscore bypasses
+ * lookup and removes exactly one escape character. Otherwise search
+ * source SYSTEM logicals only; process/group tables are absent. */
+uint32_t port_log_translate(const struct port_log_system_table *t,
+    const char *text,size_t length,uint32_t disable_mask,
+    uint8_t *outbuf,size_t capacity,struct port_log_result *out){
+    if(!t||!text||!outbuf||!out||length==0u||
+       length>PORT_LOG_MAX_NAME||!t->ready||t->count!=2u||
+       port_log_system_check(t)!=PORT_LOG_OK)return PORT_LOG_BAD;
+    const uint8_t *name=(const uint8_t *)text;
+    if(name[0]=='_')
+        return port_log_copy_result(name+1u,length-1u,outbuf,capacity,
+                  PORT_LOG_NOTRAN,0u,0u,out);
+    if(disable_mask&1u)
+        return port_log_copy_result(name,length,outbuf,capacity,
+                  PORT_LOG_NOTRAN,0u,0u,out);
+    uint32_t address=0u;
+    const uint32_t status=port_log_system_lookup(t,name,length,&address);
+    if(status==PORT_LOG_NOTRAN)
+        return port_log_copy_result(name,length,outbuf,capacity,
+                  PORT_LOG_NOTRAN,0u,0u,out);
+    if(status!=PORT_LOG_OK)return status;
+    const uint8_t *const r=port_log_source_record(t,address);
+    if(!r||port_v37_read16(r+8u)!=PORT_LOG_REC_LEN||
+       22u+(size_t)r[20u]>PORT_LOG_REC_LEN)return PORT_LOG_CYCLE;
+    const unsigned offset=21u+r[20u];
+    const unsigned n=r[offset];
+    if(offset+1u+n>PORT_LOG_REC_LEN)return PORT_LOG_CYCLE;
+    return port_log_copy_result(r+offset+1u,n,outbuf,capacity,
+                 PORT_LOG_OK,address,r[14u],out);
+}
