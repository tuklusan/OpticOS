+       PORT_BOO_PACKET_NOMEM=4u, PORT_BOO_PACKET_PAGE=512u };
+struct port_boo_packet_settings {
+    uint32_t top_address;
+    uint32_t irp_length, irp_count, irp_virtual_count;
